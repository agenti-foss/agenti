# ---------------------------------------------------------------------------
# interrupt — a FASTER stop (CLAUDE.md §4 step 6, GUI phase 2).
#
# `stop` sends SIGTERM; the agent turns it into KeyboardInterrupt, but only
# once the tool call in flight returns — an nmap with four minutes left runs
# for four more minutes first. `interrupt` sends SIGUSR1 to the agent's MAIN
# process only (--kill-whom=main: the signal must never reach the SDK's CLI
# child, for which SIGUSR1 means "start the debugger", nor a tool subprocess).
# The agent's own handler (agent_runtime.install_interrupt_handler) then
# terminates its tool subprocesses, asks the SDK to end the turn, and the run
# ends through the same partial-report path stop already uses.
#
# It is NOT a pause-and-redirect: the run ends. To redirect afterwards with
# the same context, resume it and then say.
cmd_interrupt() {
    local agent="$1"
    local u; u=$(unit "$agent")
    if ! run_active "$agent"; then
        if [[ $JSON -eq 1 ]]; then
            printf '{"agent":%s,"interrupted":false,"note":"no active run"}\n' \
                "$(json_str "$agent")"
        else
            warn "no active run for '$agent' — nothing to interrupt"
        fi
        return 0
    fi
    if [[ "$(systemctl show "$u" -p FreezerState --value 2>/dev/null)" == "frozen" ]]; then
        die "'$agent' is PAUSED (frozen) — a frozen process cannot act on a signal.
Resume it first, then interrupt:   sudo agenti $agent resume
...or stop it outright:            sudo agenti $agent stop"
    fi
    run systemctl kill --kill-whom=main --signal=SIGUSR1 "$u" \
        || die "could not signal '$agent' — check: sudo agenti $agent status"
    if [[ $JSON -eq 1 ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then
            printf '{"agent":%s,"interrupted":false,"dry_run":true}\n' \
                "$(json_str "$agent")"
        else
            printf '{"agent":%s,"interrupted":true,"note":"the step in flight is being aborted; the run ends and writes a partial report"}\n' \
                "$(json_str "$agent")"
        fi
        return 0
    fi
    ok "interrupt sent to '$agent' — the step in flight is being aborted"
    warn "the run ends now and writes a partial report. To continue with the same"
    warn "context afterwards:  sudo agenti $agent resume"
}

# ---------------------------------------------------------------------------
# history / acknowledge — the record of FINISHED runs (state.py's
# history.jsonl, both profiles) plus who has reviewed each one (acks.jsonl).
#
# acks.jsonl lives in the agent directory and is root-owned 0640, the same
# shape as inbox.jsonl: the agent can read it and cannot forge a review for
# its own run. history.jsonl is the agent's own record, written by
# StateStore.finished() in the agent's state dir; the reviewer's identity is
# deliberately kept out of a file the agent can write.
#
# Both read the shared copy of state.py (shared/lib/state.py — CLAUDE.md
# "Current plan" phase 2: the harness lives ONCE now, not per instance)
# rather than re-implementing the fold/merge here — one implementation, and
# the tests in shared/test_state.py cover it.
cmd_history() {
    local agent="$1"; shift
    # agenti <t> <a> history hide <run_id>... — a parallel-grammar sub-verb,
    # the same optional-first-token style cmd_org_engagement already uses
    # for show|set|approve|history|digest. Soft-delete (CLAUDE.md "Current
    # plan" decision 5): history.jsonl, the ledger, reports and the audit
    # log are never touched — see cmd_history_hide and state.apply_hidden.
    if [[ $# -gt 0 && "$1" == "hide" ]]; then
        shift
        cmd_history_hide "$agent" "$@"
        return
    fi
    local n=50 show_all=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n)    [[ $# -ge 2 ]] || die "-n needs a value, e.g. -n 20"
                   n="$2"; require_int "$n" "-n"; shift 2 ;;
            --all) show_all=1; shift ;;
            *)     die "unknown option for history: $1" ;;
        esac
    done
    # Every start is its own run in its own slot, so with no --copy this is
    # every one of the owner's runs of the agent, newest first; --copy narrows
    # it to that one run.
    local dirs=""
    if [[ -n "$COPY" ]]; then
        dirs=$(agent_dir "$agent")
    else
        local _d _n
        for _d in "$(agent_base_dir "$agent")/instances"/*/; do
            [[ -d "$_d" ]] || continue
            _n=$(basename "$_d")
            [[ "$_n" == "$OWNER" || ( "$_n" == "$OWNER".* && "$_n" != *.team-* ) ]] || continue
            dirs+="${_d%/}"$'\n'
        done
    fi
    python3 - "$dirs" "$n" "$JSON" "$(lib_dir)" "$show_all" <<'PY'
import json, sys, time
from pathlib import Path
dirs = [Path(x) for x in sys.argv[1].splitlines() if x]
n, as_json = int(sys.argv[2]), sys.argv[3] == "1"
sys.path.insert(0, sys.argv[4])
show_all = sys.argv[5] == "1"
try:
    import state
except Exception as e:
    msg = f"could not load state.py from {sys.argv[4]} ({e}) — reinstall: sudo apt install --reinstall agenti"
    print(json.dumps({"error": msg}) if as_json else f"  ({msg})")
    sys.exit(1)
rows = []
for agent_dir in dirs:
    r = state.fold_history(state.read_history(agent_dir / "state"))
    r = state.apply_hidden(r, state.read_hidden(agent_dir), include_hidden=show_all)
    for row in state.merge_acks(r, state.read_acks(agent_dir)):
        row["copy"] = agent_dir.name.split(".", 1)[1] if "." in agent_dir.name else None
        rows.append(row)
rows.sort(key=lambda e: float(e.get("ended") or 0), reverse=True)
rows = rows[:n]
if as_json:
    print(json.dumps(rows))
    sys.exit(0)
if not rows:
    msg = "no finished runs recorded for this agent yet" if not show_all else \
          "no finished runs recorded for this agent yet (including hidden ones)"
    print(f"  ({msg})")
    sys.exit(0)
cols = "  %-12s %-16s %-11s %-12s %5s  %-18s %-9s"
head = cols % ("run_id", "ended", "status", "reason", "found", "target", "reviewed")
if show_all:
    head += "  hidden"
print(head)
for e in rows:
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(float(e.get("ended") or 0)))
    ack = ("by %s" % e.get("acknowledged_by")) if e.get("acknowledged") else "NO"
    line = cols % (
        e.get("run_id") or "?", when, e.get("status") or "?", e.get("reason") or "-",
        e.get("findings_count") or 0,
        (e.get("target") or "-")[:18], ack)
    if show_all:
        line += "  " + (("by %s" % e.get("hidden_by")) if e.get("hidden") else "-")
    print(line)
PY
}

# agenti <t> <a> history hide <run_id>... [--by <who>] — CLAUDE.md "Current
# plan" decision 5: a soft delete for Task History. Takes a LIST so the
# GUI's multi-select is one call, not N (the same shape outputs-delete's
# own nargs="+" already established). Each run_id is resolved and hidden
# INDEPENDENTLY — an unknown id in the batch is reported and skipped rather
# than aborting the rest, the same resilience delete_outputs already uses.
# hidden.jsonl is root-owned like acks.jsonl: the agent can read it and
# cannot forge an entry for itself.
cmd_history_hide() {
    local agent="$1"; shift
    local by="" run_ids=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --by)  [[ $# -ge 2 ]] || die "--by needs a value"; by="$2"; shift 2 ;;
            -*)    die "unknown option for history hide: $1" ;;
            *)     run_ids+=("$1"); shift ;;
        esac
    done
    [[ ${#run_ids[@]} -gt 0 ]] || die "history hide needs one or more run ids:
  sudo agenti $agent history                    # lists each finished run's id
  sudo agenti $agent history hide <run_id>...   # hide one or more from the default view
  sudo agenti $agent history --all              # shows hidden rows too, with who hid them"

    local dir svc_user; dir=$(agent_dir "$agent"); svc_user=$SVC_USER
    local who; who="${by:-$(invoking_user)}"
    local result rc=0
    result=$(python3 - "$dir" "$who" "$(lib_dir)" "${run_ids[@]}" <<'PY'
import json, sys, time
from pathlib import Path
agent_dir, by = Path(sys.argv[1]), sys.argv[2]
sys.path.insert(0, sys.argv[3])
run_ids = sys.argv[4:]
def fail(msg):
    print(json.dumps({"error": msg})); sys.exit(2)
try:
    import state
except Exception as e:
    fail(f"could not load state.py from {sys.argv[3]} ({e}) — reinstall: sudo apt install --reinstall agenti")
rows = state.read_history(agent_dir / "state")
known = {r.get("run_id") for r in state.fold_history(rows) if r.get("run_id")}
lines, results = [], []
ts = time.time()
for rid in run_ids:
    if rid not in known:
