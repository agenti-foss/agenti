            if [[ $rc -ne 0 ]]; then
                local err; err=$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error",""))
except Exception: print("")' 2>/dev/null)
                die "${err:-$out}"
            fi
            if [[ $JSON -eq 1 ]]; then printf '%s\n' "$out"; return 0; fi
            CTX_JSON="$out" python3 - <<'PY'
import json, os
d = json.loads(os.environ["CTX_JSON"])
if "history" in d:
    for r in d["history"] or [{"action": "(no edits yet)"}]:
        print("  %s  %-6s by %s%s" % (r.get("ts", ""), r.get("action"), r.get("by", ""),
              ("  (previous saved as " + r["replaced"] + ")") if r.get("replaced") else ""))
elif "text" in d and "source" in d:
    print("# %s — %s, %s bytes%s" % (d["kind"], d["source"], d["bytes"],
          "" if d["source"] != "none" else "  (nothing set)"))
    print(d["text"])
elif "text" in d:
    print(d["text"])
else:
    print(json.dumps(d, indent=2))
PY
            ;;
        tool-approvals)
            # `admin tool-approvals <pending|decide> --agent= --user= [--slot= --id= --decision= --by=]`
            # What an agent asked for during THIS user's runs, and their answer.
            # API-callable like context-memory: only the owner decides (the API route passes the
            # caller as --user). An answer is delivered to the run as an
            # ordinary operator message, which is what wakes it.
            ensure_vault
            local trp; trp=$(tool_approvals_py) || die "tool_approvals.py is missing.
