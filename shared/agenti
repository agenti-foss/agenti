) || rc=$?
    if [[ $rc -ne 0 ]]; then
        local err; err=$(printf '%s' "$result" | python3 -c \
            'import json,sys
try: print(json.load(sys.stdin).get("error", "unknown error"))
except Exception: print("could not read the run history")' 2>/dev/null)
