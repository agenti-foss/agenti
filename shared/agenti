# `agenti <agent> --help`, `agenti <agent> <verb> --help`, `agenti engagement
# [<verb>] --help`, `agenti dashboard --help`: only that part of usage(), with
# the agent's own name in it. usage() stays the one place the text lives.
help_for() {
    local first="${1:-}" verb="${2:-}" pattern name=""
    case "$first" in
        ""|help) usage; return ;;
        engagement|dashboard) pattern="agenti $first${verb:+ $verb}" ;;
        *)  valid_name "$first" || { usage; return; }
            pattern="agenti <agent>${verb:+ $verb}"; name="$first"
            list_agents 2>/dev/null | grep -qx -- "$first" \
                || printf "note: '%s' is not an installed agent here (see: agenti agents)\n\n" "$first" ;;
    esac
    local out
    # An entry is a "  agenti ..." line and the deeper-indented lines under it;
    # "start options" is the one titled block an agent's help also needs.
    out=$(usage | awk -v p="$pattern" -v agent="$name" -v verb="$verb" '
        function starts(line,   t) {
            t = line; sub(/^  (sudo )?/, "", t)
            return index(t, p) == 1 && (length(t) == length(p) || substr(t, length(p) + 1, 1) ~ /[ |\[]/)
        }
        /^  (sudo )?agenti / { keep = starts($0); if (keep) print; opts = 0; next }
        /^[^ ]/ { keep = 0; opts = (agent != "" && $0 == "start options" && (verb == "" || verb == "start")); if (opts) print ""; if (opts) print; next }
        /^$/ { if (opts) { opts = 0 } ; keep = 0; next }
        { if (keep || opts) print }')
    if [[ -z "$out" ]]; then
        printf 'no help for "%s". Everything:  agenti --help\n' "$*"
        return
    fi
    [[ -z "$name" ]] || out=${out//<agent>/$name}
    printf '%s\n\nEverything:  agenti --help\n' "$out"
}

# ---------------------------------------------------------------------------
# A run that never got past its own setup: put its attempt's files back and
# say WHY, from that run's journal (preflight's [FAIL] lines with the fix
# under each, and any REFUSING line). Every start has a fresh slot, so its
# unit's journal holds this attempt only. Through the GUI this message is all
# the operator sees, so the reason must be in it, not behind a command.
_start_failed() {
    local agent="$1" dir="$2" target="$3" reasons
    _files_back "$dir"
    reasons=$(journalctl -u "$(unit "$agent")" -o cat --no-pager -n 120 2>/dev/null \
        | awk '/^[[:space:]]*\[FAIL\]/ { keep = 1; print; next }
               keep && /^[[:space:]][[:space:]][[:space:]][[:space:]][[:space:]]/ { print; next }
               { keep = 0 }
               /REFUSING/ { print }' \
        | sed -e 's/^[[:space:]]*\[FAIL\][[:space:]]*/  - /' -e 's/^[[:space:]][[:space:]][[:space:]][[:space:]]*/      /' \
        | sed -n '1,20p') || reasons=""
    die "'$agent' did not start, so nothing ran against '${target:-its files}'.
${reasons:-  It stopped during its own setup checks (no reason was recorded).}
Full log: sudo agenti $agent logs ${COPY:+--copy $COPY }-n 40"
}

# Who may start or revive a run (start, and both resume paths: a resume is a
# new launch against today's engagement, so it gets the same checks; audit
# run 2). <who> <agent> <starting|resuming>
_assert_start_authority() {
    local who="$1" agent="$2" doing="$3" past=started
    [[ "$doing" == resuming ]] && past=resumed
    # The API already checked agent:start (rbac.py) before shelling out here —
    # but "the API said so" is not enough for an action this consequential
    # (§1: launching an agent touches a real network), so this is the CLI's
    # own INDEPENDENT re-check, run only when the invoker really is the API
    # service account (checked via invoking_user(), i.e. $SUDO_USER as sudo
    # itself set it — NOT --launched-via, which is caller-supplied and a
    # compromised API could simply lie about or omit). Same posture as
    # refuse_iam_writes_from_api. A human operator at a real terminal is
    # unaffected: invoking_user() is never the API account then.
    if [[ "$(invoking_user)" == "${AGENTI_API_USER:-agenti-api}" ]]; then
        _iam_can "$who" agent:start || die "REFUSING: '$who' lacks agent:start.
This is the CLI's own independent re-check of an API-driven launch (the API
already checked this — a compromised API process cannot be trusted to have
checked correctly). Nothing was $past."
    fi

    # Segregation of duties (CLAUDE.md §3g/§4 item 15): `require-separate-
    # approver`, settable via `agenti admin set-policy`, was read back by
    # `policy`/displayed as on/off but never actually CONSULTED anywhere —
    # dead configuration that looked live. An operator who turned it "on"
    # believing it enforced two-person integrity on an engagement got no
    # such protection, silently. Found in the 2026-09-20 security audit.
    # Enforced HERE, not in preflight.py: preflight runs as the unprivileged
    # service account and cannot read iam.db (0640 root:agenti-api);
    # cmd_start already runs as root via sudo, which can read it regardless
    # of group. Applies whenever an approval is actually on record — a
    # organisation whose policy has require_approval off (and therefore never
    # gets one) has nothing here to be gated on either.
    local approval; approval="$(org_dir)/approval.json"
    if [[ -r "$approval" && -f "$IAM_PY" ]]; then
        local _policy; _policy=$(python3 "$IAM_PY" --json policy 2>/dev/null \
            | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("require-separate-approver","off"))
except Exception:
    print("off")' 2>/dev/null || echo off)
        if [[ "$_policy" == "on" ]]; then
            local _approved_by; _approved_by=$(python3 -c '
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("approved_by") or "")
except Exception:
    print("")' "$approval")
            if [[ -n "$_approved_by" && "$_approved_by" == "$who" ]]; then
                die "REFUSING: require-separate-approver is on, and '$who' both
approved this engagement's scope and is the one $doing the run.
Have a different admin approve it:
  sudo agenti engagement approve      (run by that admin)
or turn the policy off if one operator doing both jobs is expected right now:
  sudo agenti admin set-policy require-separate-approver off"
            fi
        fi
    fi
    return 0
}

cmd_start() {
    local agent="$1"; shift
    local target="" follow=0
    local launched_via="cli" linger=""
    local model="" budget="" turns="" timeout="" window="" run_name=""

    # Every *)-value flag validates $# BEFORE shift 2: under set -e, `shift 2`
    # with fewer than 2 args left (e.g. `start -t` as the very last argument)
    # returns non-zero and kills the script immediately — no die() message,
    # no output at all, just a bare exit. Checking first turns that into the
    # same clear, actionable error every other bad input in this script gets.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--target)
                [[ $# -ge 2 ]] || die "-t/--target needs a value, e.g. -t 192.0.2.50"
                target="$2"; shift 2 ;;
            --model)
                [[ $# -ge 2 ]] || die "--model needs a value, e.g. --model sonnet"
                model="$2"; shift 2 ;;
            --budget)
                [[ $# -ge 2 ]] || die "--budget needs a value, e.g. --budget 5"
                budget="$2"; shift 2 ;;
            --turns)
                [[ $# -ge 2 ]] || die "--turns needs a value, e.g. --turns 20"
                turns="$2"; shift 2 ;;
            --timeout)
                [[ $# -ge 2 ]] || die "--timeout needs a value, e.g. --timeout 1800"
                timeout="$2"; shift 2 ;;
            --window)
                [[ $# -ge 2 ]] || die "--window needs a value, e.g. --window 300"
                window="$2"; shift 2 ;;
            --name)
                [[ $# -ge 2 ]] || die "--name needs a value, e.g. --name \"web tier sweep\""
                run_name=$(valid_run_name "$2"); shift 2 ;;
            # How long to hold the session open after the task finishes, waiting
            # for `agenti say` (§3h). Defaults to 0 everywhere: an unattended
            # engagement must never sit holding a live session for someone who
            # is not there. Written into run-config.json like every other
            # per-run cap, so it resets on the next start (§1 invariant 7).
            --linger)
                [[ $# -ge 2 ]] || die "--linger needs a value in seconds, e.g. --linger 300"
                linger="$2"; shift 2 ;;
            --follow|-f) follow=1; shift ;;
            --dry-run)   DRY_RUN=1; shift ;;
            # How it was launched, for the audit record; WHO launched it is
            # the slot's owner (--owner), never a separate claim.
            --launched-via)
                [[ $# -ge 2 ]] || die "--launched-via needs a value: cli or api"
                case "$2" in
                    cli|api) launched_via="$2" ;;
                    *) die "--launched-via must be 'cli' or 'api', not '$2'" ;;
                esac
                shift 2 ;;
            *) die "unknown option for start: $1" ;;
        esac
    done

    # A file-analysis agent works on attached files and has no network target;
    # every other agent must be given one.
    local scope_kind; scope_kind=$(_agent_scope_kind "$agent")
    if [[ "$scope_kind" == files ]]; then
        [[ -z "$target" ]] || die "'$agent' analyses attached files and takes no target (-t).
Attach the file(s) and start it without one:
  sudo agenti $agent attach <file>
  sudo agenti $agent start --model sonnet"
    else
        [[ -n "$target" ]] || die "start needs a target:
  sudo agenti $agent start -t 192.0.2.50
A target is always required — the agent never scans a whole engagement scope by
default, and it may only NARROW what the engagement authorizes."
    fi

    # Mandatory since the --dev/commercial split retired (CLAUDE.md "Current
    # plan"): there is no more profile-level default to silently fall back
    # to. The allowed-model list is fetched best-effort, for a
    # helpful message only — load_run_config() (Python, agent-side) is the
    # actual enforcement point, re-checked there regardless of what this
    # message says.
    [[ -n "$model" ]] || die "start needs a model:
  sudo agenti $agent start ... --model sonnet
Allowed models: $(allowed_models)"

    # Would preflight and the harness refuse this target or model? Asked here,
    # before a run slot exists, so a refused start leaves nothing behind and
    # --dry-run means something. They still decide; this only refuses sooner.
    local pre prc=0
    pre=$(python3 "$LIBDIR/run_coverage.py" precheck --org-dir "$(org_dir)" --agent "$agent" \
            --kind "$scope_kind" --target "$target" --model "$model" 2>&1) || prc=$?
    if [[ $prc -eq 3 ]]; then
        die "REFUSING to start '$agent'${target:+ against '$target'}; nothing was created or run:
$(printf '%s\n' "$pre" | sed 's/^/  - /')"
    elif [[ $prc -ne 0 ]]; then
        warn "could not check the target and model before starting ($pre); the run's own checks still apply"
    fi

    # A team's members run in the owner's "team-<team>" copies, started only
    # by `team <name> start` (which sets _TEAM_START_IN_PROGRESS).
    [[ "$SLOT" != *.team-* || "${_TEAM_START_IN_PROGRESS:-0}" == "1" ]] || die "'${COPY}' is a team's run slot — start a team with:
  sudo agenti team ${COPY#team-} start ..."
    # Every start is its own isolated run in a fresh slot — nothing of an
    # earlier run of the same agent is reused or touched, and two can go at
    # once. --copy only pins the label (for a script that wants to name it);
    # left off, one is generated and printed.
    local auto_copy=0 stage_slot=""
    if [[ -z "$COPY" ]]; then
        stage_slot="$SLOT"      # where `attach` with no --copy staged files
        set_copy "$(new_run_label)"
        auto_copy=1
    fi
    ensure_vault
    require_agent "$agent"
    ensure_slot_provisioned "$agent"
    # Files attached with no --copy are waiting in the owner's plain slot
    # (there was no run to attach them to yet): they go with this run.
    if [[ $auto_copy -eq 1 && $DRY_RUN -eq 0 && -d "$(agent_base_dir "$agent")/instances/$stage_slot" ]]; then
        STAGE_DIR="$(agent_base_dir "$agent")/instances/$stage_slot"
        _run_files transfer-pending --from "$STAGE_DIR" --to "$(agent_dir "$agent")" --group "$SVC_USER"
    fi

    # A pinned label that is still running is refused rather than queued.
    run_active "$agent" && die "your run '$COPY' of '$agent' is still active — stop it first:
  sudo agenti $agent stop --copy $COPY      (writes a partial report)
...or just start again without --copy: every start is its own run."

    local dir svc_user; dir=$(agent_dir "$agent"); svc_user=$SVC_USER

    # An analysis run with nothing to analyse would only spend a model's time
    # finding that out. Files waiting for the next run are what it will get.
    if [[ "$scope_kind" == files ]]; then
        _run_files list --slot "$dir"
        local waiting; waiting=$(printf '%s' "$RF_OUT" | python3 -c 'import json,sys
print(len(json.load(sys.stdin).get("pending") or []))' 2>/dev/null || echo 0)
        [[ "$waiting" -gt 0 ]] || die "'$agent' has no file to analyse: none is waiting for this run.
Attach one first (or use the paperclip on Launch):
  sudo agenti $agent attach <file>"
    fi

    # Attribution (CLAUDE.md §3g): a run is launched by — and belongs to — its owner.
    local launched_by="$OWNER"

    _assert_start_authority "$launched_by" "$agent" starting

    # Per-run inputs, written as ROOT. The agent reads them and cannot write
    # them — that is what stops -t and --budget being self-serviceable.
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ write %s/run-target <- %s%s\n' "$c_d" "$dir" "${target:-(none: file analysis)}" "$c_0"
    else
        if [[ "$scope_kind" == files ]]; then
            rm -f "$dir/run-target"      # no target; never leave an old one for the agent to find
        else
            printf '%s\n' "$target" > "$dir/run-target"
            chown root:"$svc_user" "$dir/run-target"; chmod 0640 "$dir/run-target"
        fi
        # A plain start is ALWAYS a fresh conversation. The agent cannot delete
        # this marker itself (its directory is root-owned), so clearing it here
        # is what stops a later start silently becoming a resume of an old run.
        rm -f "$dir/run-resume-session"
        # Programs an operator approved for the LAST run (phase 7) die with
        # it: a grant is for one run only, the same per-run reset every other
        # setting gets (CLAUDE.md §1 invariant 7). A resume keeps them.
        rm -f "$dir/run-tool-grants.json" "$dir/run-tool-decisions.json" "$dir/state/tool-requests.jsonl"
        # Same reasoning for team membership (§3i): a SOLO start is never part
        # of a team, even if this agent was last started via one — clearing
        # here is what stops a later solo start silently keeping a stale
        # shared-channel identity.
        #
        # _TEAM_START_IN_PROGRESS is how cmd_team_start opts OUT of this
        # clear. It CANNOT write run-team itself only AFTER calling this
        # function: `systemctl start` returns as soon as the unit is
        # forked, not once the process has finished starting up, so the
        # freshly-spawned agent can read run-team (and build its CONTRACT,
        # deciding whether team_message exists at all) BEFORE a
        # write-after-start would land — a real race, found by live
        # testing: team_message was silently absent from a team-launched
        # run's tool list even though cmd_team_start had "already" written
        # run-team by the time its own shell function returned. Writing
        # BEFORE systemctl start (in cmd_team_start) and skipping the
        # clear here (via this flag) removes the race entirely rather than
        # narrowing its window.
        [[ "${_TEAM_START_IN_PROGRESS:-0}" == "1" ]] || rm -f "$dir/run-team"
    fi

    [[ -n "$run_name" ]] || run_name=$(new_run_name)
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ write %s/run-name <- %s%s\n' "$c_d" "$dir" "$run_name" "$c_0"
    else
        write_run_name "$dir" "$run_name"
    fi

    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ write %s/run-launched-by <- %s%s\n' "$c_d" "$dir" "$launched_by" "$c_0"
        note '  %s$ write %s/run-launched-via <- %s%s\n' "$c_d" "$dir" "$launched_via" "$c_0"
    else
        printf '%s\n' "$launched_by" > "$dir/run-launched-by"
        chown root:"$svc_user" "$dir/run-launched-by"; chmod 0640 "$dir/run-launched-by"
        printf '%s\n' "$launched_via" > "$dir/run-launched-via"
        chown root:"$svc_user" "$dir/run-launched-via"; chmod 0640 "$dir/run-launched-via"
    fi

    # Written FRESH every start, so anything not given falls back to the
    # organisation's engagement ceiling (agent_runtime.load_run_config) — per-run
    # settings never leak into the next run. "model" is always present
    # (mandatory, checked above); turns/budget/timeout are only written when
    # the operator actually gave one — left out, the ceiling itself applies.
    local json="{\"model\":\"$model\""
    [[ -n "$turns"   ]] && json+=",\"max_turns\":$turns"
    [[ -n "$budget"  ]] && json+=",\"max_budget_usd\":$budget"
    [[ -n "$timeout" ]] && json+=",\"timeout_s\":$timeout"
    # Passive agents capture for a window before reasoning; active ones ignore this.
    [[ -n "$window"  ]] && json+=",\"window_s\":$window"
    [[ -n "$linger"  ]] && json+=",\"linger_s\":$linger"
    json+="}"
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ write %s/run-config.json <- %s%s\n' "$c_d" "$dir" "$json" "$c_0"
    else
        printf '%s\n' "$json" > "$dir/run-config.json"
        chown root:"$svc_user" "$dir/run-config.json"; chmod 0640 "$dir/run-config.json"
    fi

    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ snapshot instruction files -> %s/run-context/%s\n' "$c_d" "$dir" "$c_0"
    else
        snapshot_run_context "$agent" "$dir"
    fi
    ensure_slot_team_dropin "$agent"
    ensure_slot_scope_dropin "$agent"
    record_run_exclusions "$agent"
    ensure_slot_userkey_dropin "$agent"
    # Files attached since the last run go with this one (with none, the new
    # run is never shown an older run's files). If the start fails they go
    # back to waiting, so the next attempt still has them.
    [[ $DRY_RUN -eq 1 ]] || _run_files begin-run --slot "$dir" --group "$svc_user"
    if ! run systemctl start "$(unit "$agent")"; then
        _start_failed "$agent" "$dir" "$target"
    fi

    # `systemctl start` returns as soon as the unit is FORKED, not once the
    # harness has actually gotten past its own preflight/scope check — a
    # scope refusal (a target outside the engagement's or the dev-mode lab
    # fence's ceiling) or a preflight failure kills the process within
    # milliseconds, before the Python side ever calls StateStore.start().
    # Without this check, cmd_start would report "started":true with
    # nothing behind it, and `status`/the dashboard would keep silently
    # showing whatever the PREVIOUS run's state.json still says — reading
    # as "nothing happened" rather than "this specific launch failed".
    # Same reasoning, same 2s window, as `agenti gui start`'s own re-check
    # (Type=exec returns before a bad cert/taken port kills it a moment
    # later) — real runs take much longer than 2s to legitimately finish,
    # so this only ever catches a launch that never really started.
    if [[ $DRY_RUN -eq 0 ]]; then
        sleep 2
        local _unit; _unit=$(unit "$agent")
        if [[ "$(systemctl show "$_unit" -p ActiveState --value 2>/dev/null)" == "failed" ]]; then
            _start_failed "$agent" "$dir" "$target"
        fi
    fi

    if [[ $DRY_RUN -eq 1 ]]; then
        if [[ $JSON -eq 1 ]]; then
            printf '{"agent":%s,"target":%s,"started":false,"dry_run":true,"run_config":%s}\n' \
                "$(json_str "$agent")" "$(json_str "$target")" "$json"
        fi
        return 0
    fi

    if [[ $JSON -eq 1 ]]; then
        # --follow would exec into journalctl and start streaming raw log lines
        # to stdout, which would break the "one JSON object" contract a caller
        # is relying on — so it's noted, not honored, under --json.
        local follow_field=""
        [[ $follow -eq 1 ]] && follow_field=',"follow_ignored":true'
        local copy_json=null; [[ -n "$COPY" ]] && copy_json=$(json_str "$COPY")
        printf '{"agent":%s,"owner":%s,"copy":%s,"name":%s,"target":%s,"started":true,"launched_by":%s,"launched_via":"%s","run_config":%s%s}\n' \
            "$(json_str "$agent")" "$(json_str "$OWNER")" "$copy_json" "$(json_str "$run_name")" \
            "$(json_str "$target")" "$(json_str "$launched_by")" "$launched_via" "$json" "$follow_field"
        return 0
    fi

    local who="$OWNER's${COPY:+ copy '$COPY' of}"
    local sel="--owner $OWNER${COPY:+ --copy $COPY}"
    ok "started $who '$agent' [$model] against ${target:-its attached files} — named \"$run_name\""
    printf '  follow : sudo agenti %s logs -f %s\n' "$agent" "$sel"
    printf '  stop   : sudo agenti %s stop %s\n' "$agent" "$sel"
    [[ $follow -eq 1 ]] && exec journalctl -u "$(unit "$agent")" -f
    return 0
}

cmd_stop() {
    local agent="$1"
    if ! run_active "$agent"; then
        if [[ $JSON -eq 1 ]]; then
            printf '{"agent":%s,"stopped":false,"note":"no active run"}\n' \
                "$(json_str "$agent")"
        else
            warn "no active run for '$agent'"
        fi
        return 0
    fi
    run systemctl stop "$(unit "$agent")"
    if [[ $JSON -eq 1 ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then
            printf '{"agent":%s,"stopped":false,"dry_run":true}\n' \
                "$(json_str "$agent")"
        else
            printf '{"agent":%s,"stopped":true,"note":"partial report written to reports/"}\n' \
                "$(json_str "$agent")"
        fi
        return 0
    fi
    ok "stopped '$agent' — a partial report was written to reports/"
}

cmd_pause() {
    local agent="$1"
    # --json support added here alongside the team feature (needed for clean
    # per-member fan-out output — see cmd_team_fanout). The plain-text "no
    # active run" case is left fatal (die), unlike cmd_stop's non-fatal warn,
    # to avoid changing an existing non-JSON behavior beyond what's needed.
    if ! run_active "$agent"; then
        if [[ $JSON -eq 1 ]]; then
            printf '{"agent":%s,"paused":false,"note":"no active run"}\n' \
                "$(json_str "$agent")"
            return 0
        fi
        die "no active run for '$agent' — nothing to pause"
    fi
    run systemctl freeze "$(unit "$agent")"
    if [[ $JSON -eq 1 ]]; then
        printf '{"agent":%s,"paused":true,"note":"frozen — a long pause can time out the in-flight API request; for a long hold, stop instead"}\n' \
            "$(json_str "$agent")"
        return 0
    fi
    ok "paused '$agent' (every process frozen, including any running scan)"
    warn "a long pause can time out the in-flight API request; for a long hold, stop instead"
}

# Which model did the LAST start use? run-config.json is root-owned and is
# rewritten on every start, so it is the authoritative answer. Empty when
# nothing has ever run (or an old run predates --model being mandatory).
run_model() {
    local f; f="$(agent_dir "$1")/run-config.json"
    [[ -r "$f" ]] || { printf ''; return; }
    python3 -c '
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("model") or "")
except Exception:
    print("")' "$f"
}

cmd_resume() {
    local agent="$1"
    local u; u=$(unit "$agent")

    # PATH 1 — the run is still alive, merely frozen. Thawing is instant and
    # keeps the live SDK session, so it stays the right answer for a short hold.
    _assert_start_authority "$OWNER" "$agent" resuming
    if [[ "$(systemctl show "$u" -p FreezerState --value 2>/dev/null)" == "frozen" ]]; then
        run systemctl thaw "$u" || die "could not thaw '$agent'"
        ok "resumed '$agent' (thawed — the live session was never lost)"
        return 0
    fi

    if run_active "$agent"; then
        die "'$agent' is already running and is not paused — nothing to resume.
  sudo agenti $agent status"
    fi

    # A team member's slot is bound to its team's channel by NAME. If that team
    # was deleted and the name reused — by anyone — resuming the old slot would
    # join the new team's channel (audit run 1, N04). So the team must still
    # exist, belong to this slot's owner and still list this agent.
    if [[ "$SLOT" == *.team-* ]]; then
        local team="${SLOT#*.team-}"
        [[ -f "$(team_file "$team")" ]] || die "'$agent' ran on team '$team', which no longer exists, so this run
cannot be resumed. Start a new run instead:
  sudo agenti $agent start -t <target>"
        [[ "$(_team_owner "$team")" == "$OWNER" ]] || die "REFUSING: the team '$team' this run belonged to is not $OWNER's any more
(it was deleted and the name reused). Start a new run instead:
  sudo agenti $agent start -t <target>"
        _team_members "$team" | cut -f1 | grep -qx "$agent" || die "'$agent' is no longer a member of team '$team', so this run cannot be
resumed. Start a new run, or add it back:  sudo agenti team $team add-agent $agent"
    fi

    # PATH 2 — the process is gone (stopped, crashed, or the box rebooted), but
    # state.py persisted the SDK session id. A NEW process can attach to that
    # conversation via ClaudeAgentOptions(resume=...), which is what makes a
    # pause survive a power cycle rather than dying with the RAM it lived in.
    local rstate; rstate=$(_slot_state_json "$(agent_dir "$agent")")
    [[ "$rstate" != "{}" ]] || die "no run state for '$agent' — there is nothing to resume.
A resume continues a run that was stopped; to begin a new one:
  sudo agenti $agent start -t <target>"

    local sid status
    sid=$(python3 -c 'import json, sys; print(str(json.loads(sys.argv[1]).get("session_id") or ""))' "$rstate")
    status=$(python3 -c 'import json, sys; print(str(json.loads(sys.argv[1]).get("status") or ""))' "$rstate")

    [[ -n "$sid" ]] || die "the last run for '$agent' has no recorded session id, so it
cannot be resumed — the SDK session never got far enough to be identified.
Start a fresh run instead:
  sudo agenti $agent start -t <target>"

    if [[ "$status" == "completed" ]]; then
        die "the last run for '$agent' COMPLETED — resuming a finished run would
re-open a conversation that already reached its conclusion and wrote its report.
Start a new run instead:
  sudo agenti $agent start -t <target>
(read the report first:  sudo agenti $agent report --last)"
    fi

    local dir svc_user; dir=$(agent_dir "$agent"); svc_user=$SVC_USER
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ write %s/run-resume-session <- %s%s\n' "$c_d" "$dir" "$sid" "$c_0"
    else
        # A run started before instruction snapshots existed has none; take one
        # now. Otherwise keep the original, so a resumed conversation is not
        # handed different instructions half-way through.
        [[ -f "$dir/run-context/versions.json" ]] || snapshot_run_context "$agent" "$dir"
        printf '%s\n' "$sid" > "$dir/run-resume-session"
        chown root:"$svc_user" "$dir/run-resume-session"
        chmod 0640 "$dir/run-resume-session"
        # Files attached while the run was stopped join it, and it is told.
        _run_files adopt --slot "$dir" --group "$svc_user"
        local _msg; _msg=$(_rf_field agent_message)
        [[ -z "$_msg" ]] || ( JSON=1 _inbox_append "$agent" message "$_msg" "$OWNER" "$(_via)" ) >/dev/null 2>&1 || true
    fi
    ensure_slot_team_dropin "$agent"
    ensure_slot_scope_dropin "$agent"
    record_run_exclusions "$agent"
    ensure_slot_userkey_dropin "$agent"
    run systemctl start "$u" || die "failed to resume — check: sudo agenti $agent status"

    if [[ $JSON -eq 1 ]]; then
        printf '{"agent":%s,"resumed":true,"mode":"session","session_id":%s}\n' \
            "$(json_str "$agent")" "$(json_str "$sid")"
        return 0
    fi
    ok "resumed '$agent' from persisted session ${sid:0:8}…"
    warn "the SDK drops a tool call that was in flight when the run stopped, so one"
    warn "scan's output may be missing from the resumed conversation"
}

cmd_status() {
    local agent="$1"
    local dir; dir=$(agent_dir "$agent")
    local shown_model; shown_model=$(run_model "$agent")
    local mounted state frozen target last live_state
    mounted=$(vault_state)
    # ONE systemctl call for both properties (it was two, ~half of this
    # verb's own cost on the Pi — §4 item 78).
    local _sc _line
    _sc=$(systemctl show "$(unit "$agent")" -p ActiveState -p FreezerState 2>/dev/null || true)
    state=""; frozen=""
    while IFS= read -r _line; do
        case "$_line" in
            ActiveState=*)  state="${_line#ActiveState=}" ;;
            FreezerState=*) frozen="${_line#FreezerState=}" ;;
        esac
    done <<< "$_sc"
    [[ -n "$state" ]]  || state=unknown
    [[ -n "$frozen" ]] || frozen=unknown
    [[ "$state" != "active" ]] && frozen="n/a"
    target=""; [[ -r "$dir/run-target" ]] && target=$(tr -d '\n' < "$dir/run-target")
    local run_name=""; [[ -r "$dir/run-name" ]] && run_name=$(tr -d '\n' < "$dir/run-name")
    # Which team the CURRENT run belongs to, if any: the root-owned run-team
    # marker cmd_team_start writes before a member starts and a plain start
    # removes (§3i). The dashboard folds a team-launched member into its
    # team's card on this; a solo run of the same agent keeps its own card.
    local team=""
    [[ -r "$dir/run-team" ]] && team=$(python3 -c '
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("team") or "")
except Exception:
    print("")' "$dir/run-team" 2>/dev/null || true)
    local last_name; last_name=$(_slot_newest_report "$dir" 2>/dev/null) || last_name=""
    last=""; [[ -n "$last_name" ]] && last="$dir/reports/$last_name"
    # Live position + findings-so-far (CLAUDE.md §3d, shared/state.py) — read
    # directly from state.json, no running process required. This is what
    # makes `status` useful WHILE a run is active, not just after.
    live_state=$(_slot_state_json "$dir")

    if [[ $JSON -eq 1 ]]; then
        local team_json=null; [[ -n "$team" ]] && team_json=$(json_str "$team")
        local copy_json=null; [[ -n "$COPY" ]] && copy_json=$(json_str "$COPY")
        printf '{"agent":%s,"owner":%s,"copy":%s,"name":%s,"vault":%s,"state":%s,"freezer":%s,"target":%s,"team":%s,"model":%s,"last_report":%s,"live":%s}\n' \
            "$(json_str "$agent")" "$(json_str "$OWNER")" "$copy_json" "$(json_str "$run_name")" \
            "$(json_str "$mounted")" "$(json_str "$state")" \
            "$(json_str "$frozen")" "$(json_str "$target")" "$team_json" "$(json_str "$shown_model")" \
            "$(json_str "${last:-}")" "$live_state"
        return 0
    fi

    printf '%s — %s%s:\n' "$agent" "$OWNER" "${COPY:+ (copy $COPY)}"
    case "$mounted" in
        unlocked) ok "vault    unlocked" ;;
        locked)   warn "vault    LOCKED — agents cannot run" ;;
    esac
    # Why the last run ended, from state.json (state.py's `reason`): a run the
    # operator stopped or interrupted exits non-zero ON PURPOSE (it did not
    # finish), so systemd records it as 'failed' — but nothing broke, and
    # sending the operator to the logs over their own stop is noise that
    # trains them to ignore the real FAILED.
    local ended_reason=""
    if [[ "$live_state" != "{}" ]]; then
        ended_reason=$(python3 -c '
import json, sys
try:
    st = json.loads(sys.argv[1])
    print((st.get("reason") or "") if st.get("phase") == "finished" else "")
except Exception:
    print("")' "$live_state" 2>/dev/null || true)
    fi
    case "$state" in
        active)   ok   "run      ACTIVE (freezer: $frozen)" ;;
        inactive) printf '  · run      idle\n' ;;
        failed)
            case "$ended_reason" in
                stopped)     printf '  · run      ended — stopped by the operator\n' ;;
                interrupted) printf '  · run      ended — interrupted by the operator\n' ;;
                timeout)     warn "run      ended — time limit reached (the report says which: working time, or no answer to the agent's question within 24 hours)" ;;
                # A resource cap (turns/budget) ending the run is the
                # engagement's own configured ceiling doing its job, not a
                # crash — same gentle treatment as timeout, not the scary
                # "FAILED" catch-all below (CLAUDE.md §4 item 47).
                max_turns)   warn "run      ended — turn cap reached" ;;
                max_budget)  warn "run      ended — budget cap reached" ;;
                *)           warn "run      FAILED — sudo agenti $agent logs -n 50" ;;
            esac ;;
        *)        printf '  · run      %s\n' "$state" ;;
    esac
    printf '  · target   %s\n' "${target:-(none set)}"
    [[ -n "$shown_model" ]] && printf '  · model    %s\n' "$shown_model"
    [[ -n "$team" ]] && printf '  · team     %s (this run was started by: agenti team %s start)\n' "$team" "$team"
    if [[ "$live_state" != "{}" ]]; then
        python3 -c '
import json, sys
try:
    st = json.loads(sys.argv[1])
except Exception:
    sys.exit(0)
phase = st.get("phase", "?")
turn = st.get("turn", 0)
findings = st.get("findings_count", 0)
sid = (st.get("session_id") or "")[:8]
by = st.get("launched_by")
extra = (f" session={sid}…" if sid else "") + (f" by={by}" if by else "")
print(f"  · live     phase={phase} turn={turn} findings={findings}" + extra)
awaiting = st.get("awaiting_operator") or {}
question = awaiting.get("question", "")
if question:
    print(f"  · WAITING ON YOU: {question}")
' "$live_state" 2>/dev/null || true
    fi
    if [[ -n "$last" ]]; then
        printf '  · report   %s\n' "$(basename "$last")"
        local rep_text; rep_text=$(_slot_cat "$dir" "reports/$last_name" 2>/dev/null) || rep_text=""
        grep -m1 '^\*\*Status:\*\*' <<<"$rep_text" | sed 's/\*\*//g;s/^/             /' || true
        grep -m1 '^\*\*Cost:\*\*'   <<<"$rep_text" | sed 's/\*\*//g;s/^/             /' || true
    else
