    [[ -n "$run_id" || $use_last -eq 1 ]] || die "acknowledge needs a run id, or --last:
  sudo agenti $agent history                 # lists each finished run's id
  sudo agenti $agent acknowledge <run_id>
  sudo agenti $agent acknowledge --last      # the most recently finished run"

    local dir svc_user; dir=$(agent_dir "$agent"); svc_user=$SVC_USER
    local by; by="${author:-$(invoking_user)}"
    local entry rc=0
    entry=$(python3 - "$dir" "$run_id" "$use_last" "$by" "$via" "$agent" "$(lib_dir)" <<'PY'
