    fi
}

cmd_show() {
    local agent="$1"; local dir; dir=$(agent_dir "$agent")
    local cfg="{}" target=""
    [[ -r "$dir/run-config.json" ]] && cfg=$(tr -d '\n' < "$dir/run-config.json")
    [[ -z "$cfg" ]] && cfg="{}"
    [[ -r "$dir/run-target" ]] && target=$(tr -d '\n' < "$dir/run-target")
    if [[ $JSON -eq 1 ]]; then
        printf '{"agent":%s,"target":%s,"run_config":%s}\n' \
            "$(json_str "$agent")" "$(json_str "$target")" "$cfg"
        return 0
    fi
    printf 'effective settings for the next run of %s:\n' "$agent"
    printf '  · target      %s\n' "${target:-(none — start needs -t)}"
    printf '  · run-config  %s\n' "$cfg"
    printf '  %sanything not listed uses the profile default; per-run values are\n' "$c_d"
    printf '  rewritten on every start, so they never carry over.%s\n' "$c_0"
}

# `agenti <agent> engagement` — a per-AGENT VIEW of the organisation's
# engagement record, through this agent's own scope kind. It is a READ, not a
# second copy: the record lives in org/, this only asks engagement_store.py to
# show it filtered to $AGENT's scope kind.
# ---------------------------------------------------------------------------
# agenti engagement show|set|approve|history|digest — THE engagement:
# client, authorized scope per kind (cidr/domain), validity window and data
# handling — shared by every agent. `show`/`set`/`approve`/`history`/`digest`
# all shell to shared/engagement_store.py (root-owned, atomic writes, an
# append-only history) — this layer only applies --dry-run and translates a
# failure into the standard die()/--json shape every other verb here already
# uses (engagement_store.py's own {"ok": false, "error": ...} is not that
# shape, on purpose — it is a library, not this CLI's own convention).
# ---------------------------------------------------------------------------
cmd_org_engagement() {
    require_org
    local sub="show"
    if [[ $# -gt 0 && "${1:0:1}" != "-" ]]; then sub="$1"; shift; fi
    case "$sub" in
        show)    cmd_org_engagement_show "$@" ;;
        set)     cmd_org_engagement_set "$@" ;;
        approve) cmd_org_engagement_approve "$@" ;;
        history) cmd_org_engagement_history "$@" ;;
        digest)  cmd_org_engagement_digest "$@" ;;
        *) die "unknown engagement subcommand '$sub'. Use: show | set | approve | history | digest
  sudo agenti engagement show" ;;
    esac
}

# Best-effort: the CURRENTLY allowed model list, for a helpful
# `start --model` error message only. NOT the enforcement point —
# agent_runtime.load_run_config() (Python, re-reading the record itself) is
# — so a failure here just falls back to naming the platform default set
# rather than blocking anything.
allowed_models() {
    local store; store=$(engagement_store_py) || { printf 'haiku sonnet opus'; return; }
    python3 "$store" --org-dir "$(org_dir)" --format json show 2>/dev/null \
        | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    models = (d.get("effective_policy") or {}).get("allowed_models") or ["haiku", "sonnet", "opus"]
    print(" ".join(models))
except Exception:
    print("haiku sonnet opus")' 2>/dev/null || printf 'haiku sonnet opus'
}

# Runs shared/engagement_store.py and enforces this CLI's own JSON contract
# on top of it: a failure ALWAYS surfaces through die() (so --json gives
# {"error":"..."} on stdout like every other verb), a success prints the
# store's own JSON verbatim under --json, or its --format text rendering
# otherwise. Never called with a mutating verb under --dry-run — callers
# check that themselves, since only they know what the intended write was.
_run_engagement_store() {
    local store; store=$(engagement_store_py) || die "engagement_store.py is missing.
reinstall it:  $REINSTALL"
    local fmt=text; [[ $JSON -eq 1 ]] && fmt=json
    local out rc=0
    out=$(python3 "$store" \
        --org-dir "$(org_dir)" \
        --shared-dir "$AGENTI_ROOT/shared" \
        --group "$SVC_USER" \
        --format "$fmt" "$@" 2>&1) || rc=$?
    if [[ $rc -ne 0 ]]; then
        # engagement_store.py's own failure path is ALWAYS {"ok": false,
        # "error": ...} on stdout, whatever --format was — its own choice,
        # made precisely so this line never has to guess between JSON and
        # its text rendering (a real bug this line used to paper over: a
        # text-mode failure once left stdout empty and doubled the message
        # into "error: ERROR: ..."). "$out" itself is the fallback only if
        # the store crashed before reaching its own error handling at all.
        local err
        err=$(printf '%s' "$out" | python3 -c 'import json,sys
print(json.load(sys.stdin).get("error", sys.stdin))' 2>/dev/null)
        die "${err:-$out}"
    fi
    printf '%s\n' "$out"
}

cmd_org_engagement_show() {
    _run_engagement_store show "$@"
}

cmd_org_engagement_history() {
    _run_engagement_store history "$@"
}

cmd_org_engagement_digest() {
    _run_engagement_store digest "$@"
}

# set/approve are the only two engagement verbs that write; both honour
# --dry-run (nothing is written, the intended call is echoed) and accept
# --by/--via overrides for the same reason `start`'s --launched-by and
# `admin-approve`'s --approved-by do: an API-driven call has no controlling
# terminal user to fall back on, and $SUDO_USER for a sudo'd API call is the
# service account, not the human behind the request.
# From the web, writing or approving the engagement needs a re-authenticated
# grant (audit run 1, F13): set is bound to the SHA-256 of the exact change
# received here, approve to the digest the admin reviewed. The author comes
# from the grant, the origin from who sudo says is asking — never from
# --by/--via, which a caller could forge.
# Called directly, never inside $(...): a die() in a command substitution
# would only end the subshell, and its message would be swallowed into the
# variable (the run would fail with no explanation). Sets ENG_APPROVER.
_engagement_web_grant() {     # <set|approve> <bound> <grant>
    local change="$1" bound="$2" grant="$3" out rc=0
    [[ -n "$grant" ]] || die "REFUSING: from the web, changing or approving the engagement needs a
fresh re-authentication (an approval grant). Nothing was changed."
    out=$(python3 "$IAM_PY" --json --actor "$(invoking_user)" approve-engagement "$change" "$bound" \
          "--grant=$grant" 2>&1) || rc=$?
    if [[ $rc -ne 0 ]]; then
        local err; err=$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error", ""))
except Exception: pass' 2>/dev/null || true)
        die "${err:-$out}"
    fi
    ENG_APPROVER=$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["approved_by"])')
}

_engagement_change_sha() {    # the SHA-256 of the change's arguments, as the API computes it
    python3 -c 'import hashlib,json,sys; print(hashlib.sha256(json.dumps(sys.argv[1:]).encode()).hexdigest())' "$@"
}

# After an engagement or agent-scope change: stop every live run the record no
# longer covers (audit run 1, F04; operator decision 2026-10-23 — only what
# lost cover: target out of scope or excluded, window over, exploit switched
# off). Runs the record still covers keep going. Prints one JSON array of
# {agent, slot, reason}; each stop writes the run's partial report and is
# logged to the journal. [agent] limits it to one agent's runs.
_stop_uncovered_runs() {
    local only="${1:-}" u agent slot kind tf reason rc
    local -a rows=()
    while read -r u _; do
        [[ "$u" =~ ^agenti-(.+)-instance@(.+)\.service$ ]] || continue
        agent="${BASH_REMATCH[1]}"; slot="${BASH_REMATCH[2]}"
        [[ -z "$only" || "$agent" == "$only" ]] || continue
        kind=$(_agent_scope_kind "$agent")
        [[ "$kind" == cidr || "$kind" == domain ]] || continue
        tf="$(org_dir)/$agent/instances/$slot/run-target"
        rc=0
        reason=$(python3 "$LIBDIR/run_coverage.py" check --org-dir "$(org_dir)" --agent "$agent" \
                    --kind "$kind" --target-file "$tf" --excluded-file "${tf%/run-target}/run-excluded" 2>&1) || rc=$?
        [[ $rc -eq 3 ]] || continue          # covered (0), or the check itself broke: leave it
        systemctl stop --no-block "$u" 2>/dev/null || true
        logger -t agenti "RUN_STOPPED | $agent | $slot | the engagement no longer covers it: $reason" 2>/dev/null || true
        rows+=("$(python3 -c 'import json,sys; print(json.dumps({"agent":sys.argv[1],"slot":sys.argv[2],"reason":sys.argv[3]}))' "$agent" "$slot" "$reason")")
    done < <(systemctl list-units --plain --no-legend --state=active 'agenti-*-instance@*.service' 2>/dev/null)
    local IFS=,; printf '[%s]\n' "${rows[*]}"
}

# Runs an engagement-changing store verb, then _stop_uncovered_runs, and
# reports both: --json merges "runs_stopped" into the store's JSON; text
# prints one line per stopped run.
_engagement_change_then_enforce() {      # <only-agent or ""> <store args...>
    local only="$1"; shift
    local out rc=0
    out=$(_run_engagement_store "$@") || rc=$?
    if [[ $rc -ne 0 ]]; then printf '%s\n' "$out"; exit "$rc"; fi
    local stopped; stopped=$(_stop_uncovered_runs "$only")
    if [[ $JSON -eq 1 ]]; then
        printf '%s' "$out" | python3 -c 'import json,sys
d = json.load(sys.stdin); d["runs_stopped"] = json.loads(sys.argv[1]); print(json.dumps(d))' "$stopped"
        return 0
    fi
    printf '%s\n' "$out"
    printf '%s' "$stopped" | python3 -c 'import json,sys
for r in json.load(sys.stdin):
    print("  ■ stopped %s run %s: %s (a partial report was written)" % (r["agent"], r["slot"], r["reason"]))'
}

# From the web, who acted is the approval grant's approver and how is sudo's
# answer; a caller's --by/--via in ANY spelling is refused there, and the
# CLI's own values go LAST, so they win even in a parser that takes the last
# copy (audit run 2: '--by=x', '--via=cli' and abbreviations got through).
_refuse_identity_from_api() {        # <verb> <arg>
    [[ "$(_via)" == api ]] || return 0
    case "$2" in
        --by|--by=*|--via|--via=*)
            die "REFUSING: from the web, who approved an engagement $1 comes from the approval itself and
how it came in from sudo, never from '$2'. Nothing was changed." ;;
    esac
}

cmd_org_engagement_set() {
    local -a args=(); local by_override="" grant=""
    while [[ $# -gt 0 ]]; do
        _refuse_identity_from_api set "$1"
        case "$1" in
            --by)       [[ $# -ge 2 ]] || die "--by needs a value"; by_override="$2"; shift 2 ;;
            --by=*)     by_override="${1#*=}"; shift ;;
            --via)      [[ $# -ge 2 ]] || die "--via needs a value: cli or api"; shift 2 ;;   # ignored: derived below
            --via=*)    shift ;;
            --grant=*)  grant="${1#*=}"; shift ;;
            --grant)    [[ $# -ge 2 ]] || die "--grant needs a value"; grant="$2"; shift 2 ;;
            --dry-run)  DRY_RUN=1; shift ;;
            *)          args+=("$1"); shift ;;
        esac
    done
    local via; via=$(_via)
    local by; by="${by_override:-$(invoking_user)}"
    if [[ "$via" == api && $DRY_RUN -ne 1 ]]; then
        local sha; sha=$(_engagement_change_sha "${args[@]}")
        _engagement_web_grant set "$sha" "$grant"
        by="$ENG_APPROVER"
    fi
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ engagement_store.py --org-dir %s set --by %s %s%s\n' \
            "$c_d" "$(org_dir)" "$by" "${args[*]}" "$c_0"
        [[ $JSON -eq 1 ]] && printf '{"dry_run":true,"verb":"set"}\n' 
        return 0
    fi
    _engagement_change_then_enforce "" set "${args[@]}" --by "$by" --via "$via"
}

cmd_org_engagement_approve() {
    local -a args=(); local by_override="" grant="" expect=""
    while [[ $# -gt 0 ]]; do
        _refuse_identity_from_api approve "$1"
        case "$1" in
            --by)       [[ $# -ge 2 ]] || die "--by needs a value"; by_override="$2"; shift 2 ;;
            --by=*)     by_override="${1#*=}"; shift ;;
            --via)      [[ $# -ge 2 ]] || die "--via needs a value: cli or api"; shift 2 ;;   # ignored: derived below
            --via=*)    shift ;;
            --grant=*)  grant="${1#*=}"; shift ;;
            --grant)    [[ $# -ge 2 ]] || die "--grant needs a value"; grant="$2"; shift 2 ;;
            --expect-digest=*) [[ -z "$expect" ]] || die "--expect-digest is given more than once"
                               expect="${1#*=}"; shift ;;
            --expect-digest)   [[ $# -ge 2 ]] || die "--expect-digest needs a value"
                               [[ -z "$expect" ]] || die "--expect-digest is given more than once"
                               expect="$2"; shift 2 ;;
            --dry-run)  DRY_RUN=1; shift ;;
            --engagement-id|--engagement-id=*) args+=("$1"); [[ "$1" == *=* ]] || { [[ $# -ge 2 ]] || die "--engagement-id needs a value"; args+=("$2"); shift; }; shift ;;
            *)          [[ "$(_via)" == api ]] && die "REFUSING: from the web, an approval takes only --expect-digest and
--engagement-id, not '$1'. Nothing was approved."
                        args+=("$1"); shift ;;
        esac
    done
    local via; via=$(_via)
    local by; by="${by_override:-$(invoking_user)}"
    if [[ "$via" == api && $DRY_RUN -ne 1 ]]; then
        [[ "$expect" =~ ^[0-9a-f]{64}$ ]] || die "REFUSING: from the web, an approval must name the
digest of the version the admin reviewed (--expect-digest). Nothing was approved."
        _engagement_web_grant approve "$expect" "$grant"
        by="$ENG_APPROVER"
    fi
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ engagement_store.py --org-dir %s approve --by %s %s%s\n' \
            "$c_d" "$(org_dir)" "$by" "${args[*]}" "$c_0"
        [[ $JSON -eq 1 ]] && printf '{"dry_run":true,"verb":"approve"}\n' 
        return 0
    fi
    [[ -z "$expect" ]] || args+=(--expect-digest "$expect")
    _run_engagement_store approve "${args[@]}" --by "$by" --via "$via"
}

cmd_engagement() {
    local agent="$1"
    local store; store=$(engagement_store_py) || die "engagement_store.py is missing.
reinstall it:  $REINSTALL"
    # capabilities.json is a MASTER-copy artifact now (CLAUDE.md "Current
    # plan" phase 2: it describes the agent's CODE) — read from master_dir,
    # not a run slot.
    local capf; capf=$(master_dir "$agent")/capabilities.json
    local kind=""
    if [[ -r "$capf" ]]; then
        kind=$(python3 -c '
import json, sys
labels = {"CIDRScope": "cidr", "DomainScope": "domain", "FilesScope": "files"}
try: print(labels.get((json.load(open(sys.argv[1])).get("scope_kind") or "").strip(), ""))
except Exception: print("")' "$capf" 2>/dev/null)
    fi
    # A file-analysis agent has no scope list in the engagement; it sees the
    # whole record like an admin would, and the GUI does not show the panel.
    local -a extra=(); [[ -n "$kind" && "$kind" != files ]] && extra=(--scope-kind "$kind" --agent "$agent")
    local fmt=text; [[ $JSON -eq 1 ]] && fmt=json
    python3 "$store" --org-dir "$(org_dir)" --format "$fmt" show "${extra[@]}"
}

# The scope kind (cidr/domain) an agent's CODE declares, from its master
# capabilities.json.
_agent_scope_kind() {
    local capf; capf=$(master_dir "$1")/capabilities.json
    [[ -r "$capf" ]] || return 0
    python3 -c '
import json, sys
labels = {"CIDRScope": "cidr", "DomainScope": "domain", "FilesScope": "files"}
try: print(labels.get((json.load(open(sys.argv[1])).get("scope_kind") or "").strip(), ""))
except Exception: print("")' "$capf" 2>/dev/null
}

# agenti <agent> agent-scope [show | set --in X ... --out Y ...]
# An agent's OWN scope: it can only NARROW what the
# engagement authorizes (checked at save, and again at every run start).
cmd_agent_scope() {
    local agent="$1"; shift
    local verb="show"
    if [[ $# -gt 0 && "$1" != -* ]]; then verb="$1"; shift; fi
    case "$verb" in show|set) ;; *) die "agent-scope verbs: show | set
  agenti $agent agent-scope show
  sudo agenti $agent agent-scope set --in <entry> [--in <entry>...] [--out <entry>...]" ;; esac
    local kind; kind=$(_agent_scope_kind "$agent")
    [[ -n "$kind" && "$kind" != files ]] || die "agent '$agent' declares no network or domain scope, so there is nothing to narrow."
    if [[ "$verb" == show ]]; then
        _run_engagement_store agent-scope-show --agent "$agent" --scope-kind "$kind"
        return 0
    fi
    local -a args=(); local by_override="" via; via=$(_via)
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --by)      [[ $# -ge 2 ]] || die "--by needs a value"; by_override="$2"; shift 2 ;;
            --via)     [[ $# -ge 2 ]] || die "--via needs a value: cli or api"; shift 2 ;;   # ignored: from sudo
            --in|--out) [[ $# -ge 2 ]] || die "$1 needs a value, e.g. $1 192.0.2.31"; args+=("$1" "$2"); shift 2 ;;
            --dry-run) DRY_RUN=1; shift ;;
            *) die "unknown option '$1' for agent-scope set (use --in, --out)" ;;
        esac
    done
    local by; by="${by_override:-$(invoking_user)}"
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ engagement_store.py agent-scope-set --agent %s --by %s %s%s\n' "$c_d" "$agent" "$by" "${args[*]}" "$c_0"
        [[ $JSON -eq 1 ]] && printf '{"agent":%s,"dry_run":true}\n' "$(json_str "$agent")"
        return 0
    fi
    _engagement_change_then_enforce "$agent" agent-scope-set --agent "$agent" --scope-kind "$kind" \
        --by "$by" --via "$via" "${args[@]}"
}

# agenti <agent> tool-settings [show | set --enable X --disable Y]
# An admin's narrowing/extension of a shell-running agent's allow-list
# (CLAUDE.md "Current plan" phase 6, shared/tool_settings_store.py). `set`
# replaces BOTH lists wholesale in one call — the same "hand in the whole
# desired state" shape agent-scope's own `set` already uses, which is what
# lets a GUI checklist diff and save in one request. Root only; `show` is
# read-only but still needs root since the settings file lives in the
# own 0750 directory.
cmd_tool_settings() {
    local agent="$1"; shift
    local verb="show"
    if [[ $# -gt 0 && "$1" != -* ]]; then verb="$1"; shift; fi
    case "$verb" in show|set) ;; *) die "tool-settings verbs: show | set
  agenti $agent tool-settings show
  sudo agenti $agent tool-settings set --enable curl --enable sslscan --disable ping" ;; esac
    local tss; tss=$(tool_settings_store_py) || die "tool_settings_store.py is missing.
reinstall it:  $REINSTALL"
    local -a tss_args=(); local by_override="" via; via=$(_via)
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --by)      [[ $# -ge 2 ]] || die "--by needs a value"; by_override="$2"; shift 2 ;;
            --via)     [[ $# -ge 2 ]] || die "--via needs a value: cli or api"; shift 2 ;;   # ignored: from sudo
            --enable|--disable|--approvable)
                       [[ $# -ge 2 ]] || die "$1 needs a program name"; tss_args+=("$1" "$2"); shift 2 ;;
            --dry-run) [[ "$verb" == set ]] || die "--dry-run only applies to set"; DRY_RUN=1; shift ;;
            *) die "unknown option '$1' for tool-settings $verb (use --enable, --disable, --approvable)" ;;
        esac
    done
    if [[ "$verb" == show ]]; then
        [[ ${#tss_args[@]} -eq 0 ]] || die "tool-settings show takes no options"
    elif [[ $DRY_RUN -eq 1 ]]; then
        local by; by="${by_override:-$(invoking_user)}"
        note '  %s$ tool_settings_store.py set --agent %s --by %s %s%s\n' "$c_d" "$agent" "$by" "${tss_args[*]}" "$c_0"
        [[ $JSON -eq 1 ]] && printf '{"agent":%s,"dry_run":true}\n' "$(json_str "$agent")"
        return 0
    fi
    local out rc=0
    if [[ "$verb" == show ]]; then
        out=$(python3 "$tss" --org-dir "$(org_dir)" --shared-dir "$AGENTI_ROOT/shared" \
            --agent "$agent" show 2>&1) || rc=$?
    else
        local by; by="${by_override:-$(invoking_user)}"
        out=$(python3 "$tss" --org-dir "$(org_dir)" --shared-dir "$AGENTI_ROOT/shared" \
            --group "$SVC_USER" --agent "$agent" set --by "$by" --via "$via" \
            "${tss_args[@]}" 2>&1) || rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
        local err; err=$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error",""))
except Exception: print("")' 2>/dev/null)
        die "${err:-$out}"
    fi
    if [[ $JSON -eq 1 ]]; then printf '%s\n' "$out"; return 0; fi
    TOOL_SETTINGS_JSON="$out" python3 - <<'PY'
import json, os
d = json.loads(os.environ["TOOL_SETTINGS_JSON"])
print("tool allow-list for %s:" % d["agent"])
print("  baseline (from the agent's own code) : %s" % (", ".join(d["baseline"]) or "(none)"))
print("  effective (what a run enforces)      : %s" % (", ".join(d["effective"]) or "(none)"))
if d["added"]:
    print("  added by an admin   : %s" % ", ".join(d["added"]))
if d["removed"]:
    print("  removed by an admin : %s" % ", ".join(d["removed"]))
if d.get("approvable"):
    print("  operators may approve, per run : %s" % ", ".join(d["approvable"]))
if d.get("unchanged"):
    print("  (no change)")
for row in d.get("history", [])[:10]:
    print("  %s  by %-20s enable=%s disable=%s" % (row.get("ts"), row.get("by"), row.get("enable"), row.get("disable")))
PY
}

# agenti <agent> controls --json — every control on one agent,
# plus a live-vs-declared drift check (shared/agent_controls.py). Root.
cmd_controls() {
    local agent="$1"
    local py=""
    if [[ -f "$LIBDIR/agent_controls.py" ]]; then py="$LIBDIR/agent_controls.py"
    elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/agent_controls.py" ]]; then
        py="$(dirname "${BASH_SOURCE[0]}")/agent_controls.py"; fi
    [[ -n "$py" ]] || die "agent_controls.py is missing.
reinstall it:  $REINSTALL"
    local libdir; libdir=$(dirname "$py")
    local out; out=$(python3 "$py" --agent "$agent" \
        --org-dir "$(org_dir)" --master-dir "$(master_dir "$agent")" \
        --libdir "$libdir" 2>&1) || true
    local err; err=$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error",""))
except Exception: print("unreadable output")' 2>/dev/null)
    [[ -z "$err" ]] || die "${err}"
    if [[ $JSON -eq 1 ]]; then printf '%s\n' "$out"; return 0; fi
    CONTROLS_JSON="$out" python3 - <<'PY'
import json, os
d = json.loads(os.environ["CONTROLS_JSON"])
agent = d["agent"]
print("controls for %s:" % agent)
for s in d["sections"]:
    print("\n  " + s["title"] + ("" if s.get("editable") else "   (view only)"))
    for k, v in s["rows"]:
        print("    - " + k + (": " + v if v else ""))
dr = d["drift"]
print("\n  drift check: " + dr["summary"])
for c in dr["checks"]:
    if c["status"] == "fail":
        print("    ! %s: deployed %r, live %r" % (c["name"], c["declared"], c["live"]))
PY
}

cmd_tools() {
    # The operator-facing "what can this agent actually do" answer (§4 item
    # 26): the MCP tools it exposes, the command-line programs it may run
    # (enum's enforced allow-list; the fixed external tools for the others),
    # its scope kind, and the controls that hold it. Read from the root-owned
    # capabilities.json the package ships — a static descriptor of the SAME
    # declarations that enforce the boundary, so it cannot claim more than the
    # agent is actually allowed. No vault/venv needed; it is plain JSON.
    # capabilities.json is a MASTER-copy artifact (CLAUDE.md "Current plan"
    # phase 2) — it describes the agent's CODE, so it lives once at
    # master_dir(agent).
    local agent="$1"; local mdir; mdir=$(master_dir "$agent")
    local f="$mdir/capabilities.json"
    if [[ ! -r "$f" ]]; then
        # Self-heal for an agent deployed before capabilities.json existed:
        # rebuild it from the master source with the installed generator, so
        # `tools` works without forcing a redeploy.
        local gen=""
        if [[ -x "$LIBDIR/gen_capabilities.py" ]]; then gen="$LIBDIR/gen_capabilities.py"
        elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/gen_capabilities.py" ]]; then
            gen="$(dirname "${BASH_SOURCE[0]}")/gen_capabilities.py"; fi
        local asrc="$mdir/$agent-agent.py"
        if [[ -n "$gen" && -r "$asrc" ]] && python3 "$gen" "$asrc" > "$f.tmp" 2>/dev/null; then
            # World-readable (0644 root:root), matching the package's own
            # install mode for this file — display data, not a boundary,
            # and `agenti agents` (phase 3) needs to read it with no root.
            chown root:root "$f.tmp" 2>/dev/null || true
            chmod 0644 "$f.tmp"; mv "$f.tmp" "$f"
        else
            rm -f "$f.tmp" 2>/dev/null || true
            die "no tools descriptor for agent '$agent' and it could not be built.
reinstall it:  $REINSTALL"
        fi
    fi
    if [[ $JSON -eq 1 ]]; then cat "$f"; return 0; fi
    python3 - "$f" "$agent" <<'PY'
import json, sys
f, agent = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(f))
except Exception as e:
    print(f"could not read the tools descriptor: {e}"); raise SystemExit(1)
print(f"tools & permissions for {agent}:")
print(f"  scope boundary : {d.get('scope_kind') or 'unknown'}")
mcp = d.get("mcp_tools") or []
print(f"\n  tools the agent calls ({len(mcp)}):")
for t in mcp:
    print(f"    · {t.get('name')}")
    if t.get("purpose"):
        print(f"        {t['purpose']}")
cli = d.get("command_line_tools") or {}
items = cli.get("items") or []
if items:
    label = "command-line programs it may run" if cli.get("enforced") else "external programs / services it uses"
    print(f"\n  {label} ({len(items)}):")
    for i in items:
        line = f"    · {i.get('name')}"
        if i.get("purpose"):
            line += f" — {i['purpose']}"
        print(line)
    if cli.get("note"):
        print(f"    {cli['note']}")
dp = d.get("denied_patterns") or []
if dp:
    print(f"\n  refused even on an allowed program: {', '.join(dp)}")
print("\n  the model never gets raw shell; scope is enforced in root-owned files, "
      "not the prompt.")
PY
}

# The agent-TYPE catalogue, read straight from every master copy's own
# capabilities.json. Always emits {"vault":"off"|"locked"|"unlocked",
# "agents":[{agent,scope_kind,category,title,description,built,tools,programs},...]}
# regardless of $JSON; formatting for a human is each caller's own job.
# Deliberately NO ROOT and no run data at all: this lists WHICH agent
# types exist on the box, not where they've actually run (that's
# `dashboard`). capabilities.json is world-readable and both agent folders
# are world-traversable by design — exactly so this can work without sudo,
# the same as `agenti new`. Shipped agents are listed even while the vault is
# locked (their code is outside it); built ones only once it is unlocked.
_agents_catalog_json() {
    local vstate; vstate=$(vault_state)
    local -a rows=()
    local d a base dirs=("$AGENTI_SHIPPED_AGENTS")
    [[ "$vstate" == locked ]] || dirs+=("$AGENTI_BUILT_AGENTS")
    for base in "${dirs[@]}"; do
        for d in "$base"/*/; do
            [[ -d "$d" ]] || continue
            a=$(basename "$d")
            [[ -r "$d/capabilities.json" ]] || continue
            rows+=("$a"$'\t'"$d/capabilities.json")
        done
    done
    local input=""
    local row
    for row in "${rows[@]}"; do input+="$row"$'\n'; done
    printf '%s' "$input" | VSTATE="$vstate" python3 -c '
import json, os, sys
LABELS = {"DomainScope": "domain", "CIDRScope": "cidr", "FilesScope": "files"}
out = []
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line:
        continue
    name, path = line.split("\t", 1)
    try:
        d = json.load(open(path))
    except Exception:
        d = {}
    out.append({
        "agent": name,
        "scope_kind": LABELS.get(d.get("scope_kind") or "", d.get("scope_kind")),
        "category": d.get("category"),
        "title": d.get("title") or name,
        "description": d.get("description") or "",
        "built": d.get("built"),
        "tools": [t.get("name") for t in (d.get("mcp_tools") or []) if t.get("name")],
        "programs": [i.get("name") for i in ((d.get("command_line_tools") or {}).get("items") or [])
                     if i.get("name")],
    })
seen, uniq = set(), []
for r in out:  # a shipped agent wins over a built one of the same name
    if r["agent"] not in seen:
        seen.add(r["agent"]); uniq.append(r)
uniq.sort(key=lambda r: r["agent"])
print(json.dumps({"vault": os.environ["VSTATE"], "agents": uniq}))
'
}

# `agenti agents [--json]` — CLAUDE.md "Current plan" phase 3.
cmd_agents() {
    local catalog
    catalog=$(_agents_catalog_json)
    if [[ $JSON -eq 1 ]]; then
        printf '%s\n' "$catalog"
        return 0
    fi
    printf '%s' "$catalog" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if d.get("vault") == "locked":
    print("  vault is locked — no agent types are visible. Unlock it: sudo agenti vault unlock")
    sys.exit(0)
out = d.get("agents") or []
if not out:
    print("  (no agent types installed — sudo apt install --reinstall agenti)")
else:
    print("deployed agent types:")
    for r in out:
        name = r["agent"]; scope = r.get("scope_kind") or "?"
        cat = r.get("category") or "-"
        ntools = len(r.get("tools") or [])
        print(f"  {name:<16} scope={scope:<10} category={cat:<18} tools={ntools}")
'
}

cmd_outputs_cat() {
    # agenti admin outputs-cat --user U <name> [--by W] —
    # phase 7's binary-safe download path. Resolves via iam.py's
    # outputs-path (the EXACT ownership/traversal validation outputs-delete
    # already enforces, read-only), then cats the real bytes. Deliberately
    # NOT forwarded wholesale to iam.py like the other admin verbs: its
    # SUCCESS output is raw file bytes, never JSON, matching how cmd_report
    # already differs from the iam.py-forwarded verbs for the same reason.
    #
    # --by defaults to invoking_user() (a real terminal call), but MUST be
    # overridable: for an API-driven call, invoking_user() resolves to
    # $SUDO_USER, which is the agenti-api SERVICE ACCOUNT, not the real
    # caller — the exact attribution gap --launched-by/--created-by/
    # outputs-delete's own --by already exist to close. Found live: the
    # very first API download of an operator's OWN promoted output was
    # refused with "only they or an admin may access it", because without
    # this override the ownership check compared the real owner against
    # 'agenti-api' instead of the real caller.
    local principal="" name="" by=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user|--principal)
                         [[ $# -ge 2 ]] || die "$1 needs a value"; principal="$2"; shift 2 ;;
            --by)        [[ $# -ge 2 ]] || die "--by needs a value"; by="$2"; shift 2 ;;
            -*)          die "unknown option for outputs-cat: $1" ;;
            *)           [[ -z "$name" ]] || die "outputs-cat takes ONE output name"
                        name="$1"; shift ;;
        esac
    done
    [[ -n "$principal" && -n "$name" ]] || \
        die "usage: sudo agenti admin outputs-cat --user U <name> [--by W]"
    [[ -f "$IAM_PY" ]] || die "$IAM_PY is missing.
reinstall it:  $REINSTALL"
    [[ -n "$by" ]] || by="$(invoking_user)"
    local result rc=0
    result=$(python3 "$IAM_PY" --actor "$by" --json outputs-path \
        --user "$principal" --by "$by" "$name" 2>&1) || rc=$?
    if [[ $rc -ne 0 ]]; then
        local err; err=$(printf '%s' "$result" | python3 -c \
            'import json,sys
try: print(json.load(sys.stdin).get("error", "not found"))
except Exception: print("not found")' 2>/dev/null)
        die "${err:-not found}"
    fi
    local realpath
    realpath=$(printf '%s' "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])')
    cat "$realpath"
}

cmd_logs() {
    local agent="$1"; shift
    local n=100; local -a follow=()
    # Anything else would reach a root journalctl, which has options that
    # delete journal files or read the whole system journal (audit run 1,
    # F12) — the same rule gui_logs follows.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow) follow=(-f); shift ;;
            -n) [[ $# -ge 2 ]] || die "-n needs a number, e.g. -n 50"; require_int "$2" "-n"; n="$2"; shift 2 ;;
            *)  die "unknown option for logs: $1
usage: sudo agenti $agent logs [-f] [-n N]" ;;
        esac
    done
    # Only this slot's own lifetime: the journal is keyed by the unit's NAME,
    # and a renamed user's old name can be issued to someone else (audit run 2).
    local since=() created
    created=$(tr -dc '0-9' < "$(agent_dir "$agent")/run-created" 2>/dev/null || true)
    [[ -n "$created" ]] && since=(--since "@$created")
    exec journalctl -u "$(unit "$agent")" "${since[@]}" -n "$n" --no-pager "${follow[@]}"
}

cmd_report() {
    local agent="$1"; shift
    local dir; dir=$(agent_dir "$agent"); local f=""
    if [[ $# -eq 0 || "${1:-}" == "--last" ]]; then
        f=$(_slot_newest_report "$dir")
        [[ -n "$f" ]] || die "no reports yet for '$agent' — start a run first:
  sudo agenti $agent start -t <target> --model sonnet"
    else
        # Same class of gap as the agent-name traversal fixed above: this
        # runs as root, and "$dir/reports/$1" is naive concatenation, so a
        # filename of e.g. "../../../../etc/shadow" would cat an arbitrary
        # root-readable file. Only shared/api/cli_bridge.py's FILENAME_RE
        # protected this before — reachable by any direct caller, which
        # every sudoers grant in this project is. Found 2026-09-20 (CLAUDE.md
        # §4 item 15).
        # The pattern requires an alnum FIRST character, so a leading '.'
        # (and therefore "..") is already impossible, and '/' is simply not
        # in the allowed character class — no separate traversal check needed.
        [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] \
            || die "invalid report filename '$1' — no '/' or leading '.'.
see available reports:  sudo agenti $agent reports"
        f="$1"
    fi
    _slot_cat "$dir" "reports/$f" >/dev/null 2>&1 \
        || die "no such report: $f  (see: sudo agenti $agent reports)"
    _slot_cat "$dir" "reports/$f"
}

cmd_reports() {
    # --json: one object, {"reports":[{name,bytes,status}]} newest first, so a
    # caller never has to scrape the human table (§4 item 78).
    local dir; dir=$(agent_dir "$1")
    local listing; listing=$(_slot_list "$dir" reports .md status) || listing='{"files":[]}'
    if [[ $JSON -eq 1 ]]; then
        printf '%s' "$listing" | python3 -c 'import json,sys
rows = [{"name": r["name"], "bytes": r["bytes"], "status": r.get("status", "")}
        for r in json.load(sys.stdin)["files"]]
print(json.dumps({"reports": rows}))'
        return 0
    fi
    printf '%s' "$listing" | python3 -c 'import json,sys
rows = json.load(sys.stdin)["files"]
def size(n):
    for u in ("B", "K", "M", "G"):
        if n < 1024: return f"{n:.0f}{u}"
        n /= 1024
    return f"{n:.0f}T"
for r in rows:
    print("  %-40s %6s  %s" % (r["name"], size(r["bytes"]), r.get("status", "")))
if not rows:
    print("  (none)")'
    return 0
}

cmd_scans() {
    # RECURSIVE, and not just *.txt. The enum agent writes flat scans/foo.txt,
    # but a passive agent writes scans/window-<ts>/{tshark,suricata}/*.log —
    # a top-level *.txt glob reports "(none)" for a directory full of evidence,
    # which reads like the run collected nothing. Paths are shown relative to
    # scans/ so the window and analyser are visible without being verbose.
    # The run chose every name here: listed by run_files (descriptor walk,
    # sizes from it), printed escaped, never handed to another program.
    local dir; dir=$(agent_dir "$1")
    _slot_list_recursive "$dir" scans .txt,.log,.json,.pcap | python3 -c 'import json,sys
rows = json.load(sys.stdin)["files"]
def size(n):
    for u in ("B", "K", "M", "G"):
        if n < 1024 or u == "G":
            return f"{n:.0f}{u}" if u == "B" else f"{n:.1f}{u}"
        n /= 1024
for r in rows:
    print("  %-58s %6s" % (ascii(r["name"])[1:-1], size(r["bytes"])))
if not rows:
    print("  (none)")'
}

cmd_findings() {
    # Durable per-turn findings ledger (CLAUDE.md §3d, shared/state.py) — an
    # index into scans/reports, not a copy of them: each line names the tool,
    # verdict and a short summary, not the full raw output. Default 20 most
    # recent entries; -n changes that. Works whether or not the run is still
    # active, since it's reading a plain file, not asking the process.
    local agent="$1"; shift
    local n=20
    [[ "${1:-}" == "-n" ]] && { n="${2:-20}"; shift 2 2>/dev/null || true; }
    require_int "$n" "-n"
    local dir; dir=$(agent_dir "$agent")
    if [[ $JSON -eq 1 ]]; then
        if _slot_cat "$dir" state/findings.jsonl 1 >/dev/null 2>&1; then
            _slot_cat "$dir" state/findings.jsonl "$n" | python3 -c '
import json, sys
lines = [l for l in sys.stdin if l.strip()]
print(json.dumps([json.loads(l) for l in lines]))
' 2>/dev/null || printf '[]\n'
        else
            printf '[]\n'
        fi
        return 0
    fi

    if ! _slot_cat "$dir" state/findings.jsonl 1 >/dev/null 2>&1; then
        printf '  (none — no run has recorded findings here yet)\n'
        return 0
    fi
    _slot_cat "$dir" state/findings.jsonl "$n" | python3 -c '
import json, sys
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        e = json.loads(line)
    except json.JSONDecodeError:
        continue
    mark = "OK" if e.get("verdict") == "ok" else "!!"
    turn = e.get("turn", "?")
    tool = e.get("tool", "?")
    summary = e.get("summary", "")
    print("  [%s] turn %2s  %-24s %s" % (mark, turn, tool, summary))
' 2>/dev/null || printf '  (could not parse findings.jsonl)\n'
}

cmd_evidence() {
    # WHY THIS EXISTS: the org directory is 0750 root:<service account>, so a
    # shell glob like
    #   sudo cat /var/lib/agenti/data/org/<a>/instances/<u>/scans/window-*/tshark/cleartext.log
    # never expands — the USER's shell does the expansion, before sudo elevates,
    # and it cannot read the directory. bash passes the literal '*' through and
    # root reports "No such file or directory", which reads as "the file is
    # missing" when it may be sitting right there. Doing the search as root
    # removes the trap entirely.
    local agent="$1"; shift
    local want="${1:-}"
    local dir; dir=$(agent_dir "$agent")

    [[ -n "$want" ]] || die "evidence needs a file name, e.g.:
  sudo agenti $agent evidence cleartext.log
list what exists:  sudo agenti $agent scans"

    local matches=()
    while IFS= read -r f; do [[ -n "$f" ]] && matches+=("$dir/$f"); done \
        < <(python3 "$(lib_dir)/run_files.py" find --slot "$dir" --folder scans --name "$want" 2>/dev/null \
            | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["files"]))' 2>/dev/null)

    if [[ ${#matches[@]} -eq 0 ]]; then
        printf 'no evidence file named %s under %s/scans\n\n' "$want" "$dir"
        printf 'For a detector log, absence has two very different meanings:\n'
        printf '  - the detector RAN and matched nothing  (a real result)\n'
        printf '  - the detector FAILED to run            (a coverage gap)\n'
        printf 'The journal distinguishes them:\n'
        printf '  sudo agenti %s logs -n 200 | grep TSHARK\n\n' "$agent"
        printf 'what does exist:\n'
        cmd_scans "$agent"
        return 1
    fi

    local f
    for f in "${matches[@]}"; do
        printf '%s===== %s =====%s\n' "$c_d" "${f#"$dir/scans/"}" "$c_0"
        _slot_cat "$dir" "${f#"$dir/"}" || printf '(could not read it safely: skipped)\n'
        printf '\n'
    done
}

cmd_verify() {
    local agent="$1" u; u="$(unit "$agent")"
    printf 'running preflight for %s, slot %s (no scan will start):\n' "$agent" "$SLOT"
    # The same preflight.py the slot's own unit runs as ExecStartPre, INSIDE
    # the same isolation: run as the run account outside it, it could follow a
    # link the run planted into another user's slot (audit run 2). The
    # properties are copied from the slot's own unit (template + drop-ins), so
    # they can never drift from what a real run gets.
    local -a props=(); local line
    while IFS= read -r line; do
        [[ "$line" =~ ^(User|Group|WorkingDirectory|Environment|EnvironmentFile|ProtectSystem|TemporaryFileSystem|BindPaths|BindReadOnlyPaths|ReadWritePaths|ProtectHome|PrivateTmp|NoNewPrivileges|ProtectProc|RestrictAddressFamilies|RestrictSUIDSGID|LockPersonality|ProtectKernelModules|ProtectKernelTunables|ProtectControlGroups|IPAddressDeny|IPAddressAllow)= ]] || continue
        line="${line//%i/$SLOT}"
        # A unit file reads 'localhost' in IPAddressAllow=; systemd-run does not.
        [[ "$line" == IPAddressAllow=* ]] && line="${line//localhost/127.0.0.0/8 ::1/128}"
        props+=(-p "$line")
    done < <(systemctl cat "$u" 2>/dev/null)
    [[ ${#props[@]} -gt 0 ]] || die "the unit $u is not installed, so there is nothing to check.
render it:  sudo agenti $agent provision"
    run systemd-run --quiet --wait --pipe --collect --service-type=exec "${props[@]}" \
        -- "$AGENT_PYTHON" "$(lib_dir)/preflight.py"
}

cmd_export() {
    local agent="$1"; shift
    local dest="${1:-}"
    [[ -n "$dest" ]] || die "export needs a destination:  sudo agenti $agent export ~/delivery"
    # Root writes the copy and hands it to you, so it must not land inside
    # Agenti's own code or data, or a system folder (audit run 1, F11).
    local real; real=$(realpath -m -- "$dest")
    local forbidden
    for forbidden in "$LIBDIR" "$AGENTI_STATE" "$AGENTI_ROOT" "$AGENTI_ETC" /usr /etc /bin /sbin /lib /boot /proc /sys /dev /var/lib; do
        [[ "$real" == "$forbidden" || "$real" == "$forbidden"/* ]] && die "REFUSING: '$dest' is inside $forbidden — export to a folder of your own:
  sudo agenti $agent export ~/delivery"
    done
    local dir; dir=$(agent_dir "$agent")
    local out="$dest/$agent-$(date +%Y%m%d-%H%M%S)"
    run mkdir -p "$out"
    run cp -a "$dir/reports" "$dir/scans" "$out/"
    [[ $DRY_RUN -eq 1 ]] && return 0
    # Whoever ran sudo should own the delivery copy, not root.
    [[ -n "${SUDO_USER:-}" ]] && chown -R "$SUDO_USER" "$out" 2>/dev/null || true
    ok "exported to $out"
    warn "this copy is OUTSIDE the encrypted vault — client data in the clear."
    warn "delete it once the engagement is delivered."
}

cmd_purge() {
    local agent="$1"; local dir; dir=$(agent_dir "$agent")
    local ns nr
    ns=$(ls -1 "$dir/scans" 2>/dev/null | wc -l)
    nr=$(ls -1 "$dir/reports" 2>/dev/null | wc -l)
    printf 'This deletes ALL output for %s: %s scan file(s), %s report(s).\n' \
        "$agent" "$ns" "$nr"
    printf 'Export first if you still need it:  sudo agenti %s export <dir>\n\n' "$agent"
    read -r -p "type the agent name to confirm: " reply
    [[ "$reply" == "$agent" ]] || { printf 'aborted.\n'; return 0; }
    run rm -rf "${dir:?}/scans"/* "${dir:?}/reports"/*
    ok "purged scans and reports for '$agent'"
}

cmd_setkey() {
    console_only "$1 set-key"
    [[ -x "$SET_SECRET_SH" ]] || die "$SET_SECRET_SH missing.
reinstall it:  $REINSTALL"
    run "$SET_SECRET_SH" --agent "$1"
}

# agenti admin set-user-key <user>: one user's own API key (its own Console
# spend cap); their runs use it ahead of every other key. Console only: the
# key is typed at the terminal and never crosses the web tier.
cmd_set_user_key() {
    console_only "admin set-user-key"
    local u="${1:-}"
    [[ -n "$u" && "$u" != -* ]] || die "usage: sudo agenti admin set-user-key <user>
  Installs <user>'s own Anthropic API key; their runs use it ahead of the agent,
  organisation and shared keys. Remove it with: sudo rm $AGENTI_ROOT/org/users/<user>/secrets.env"
    python3 "$IAM_PY" --json user-exists "$u" 2>/dev/null \
        | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("exists") else 1)' 2>/dev/null \
        || die "no user named '$u' — list them: sudo agenti admin user list"
    [[ -x "$SET_SECRET_SH" ]] || die "$SET_SECRET_SH missing.
reinstall it:  $REINSTALL"
    run "$SET_SECRET_SH" --user "$u"
}

# ---------------------------------------------------------------------------
# The agent inbox (CLAUDE.md §3h): notes and steering messages.
#
# TWO DIFFERENT THINGS, deliberately not one:
#   note    — recorded against the run and reproduced in the report. NEVER sent
#             to the model. Safe for a viewer-level principal, because it cannot
#             influence what the agent does.
#   message — injected into the live conversation at the next turn boundary.
#             Operator-level, because it steers a process that touches networks.
#
# WHY THIS IS DEFENSIBLE HERE AND WOULD NOT BE ON A GENERIC AGENT PLATFORM: a
# steering message shapes what the agent TRIES; it cannot widen what the agent
# is PERMITTED to do. The tool allow-list and the scope boundary are enforced
# in the tool layer and by root (§1 invariants 1 and 2), never by the prompt. A
# message can say "scan 8.8.8.8" all it likes and the validator still refuses.
#
# inbox.jsonl is root-owned 0640, exactly like run-target: the agent reads it
# and cannot forge an entry for itself. It sits in the agent directory rather
# than a profile data dir because it is a per-run INPUT, not output.
_inbox_append() {
    local agent="$1" kind="$2" body="$3" author="$4" via="$5"
    local dir svc_user f
    dir=$(agent_dir "$agent"); svc_user=$SVC_USER
    f="$dir/inbox.jsonl"

    # The stored `kind` ("note" or "message") is not always the CLI VERB
    # that produced it — "note" happens to match, but the verb for
    # kind=message is `say`, not "message" (there is no `agenti ... message
    # ...` command). The usage hint below used to say `$kind` directly,
    # so an empty `say ""` suggested a command that doesn't exist. Found
    # in the 2026-09-21 error-message audit (CLAUDE.md §4 item 17).
    local verb; verb="$([[ "$kind" == "message" ]] && printf 'say' || printf '%s' "$kind")"
    [[ -n "$body" ]] || die "$verb needs some text:
  sudo agenti $agent $verb \"focus on the SMB shares first\""

    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ append %s <- [%s] %s%s\n' "$c_d" "$f" "$kind" "$body" "$c_0"
        [[ $JSON -eq 1 ]] && printf '{"agent":%s,"kind":"%s","queued":false,"dry_run":true}\n' \
            "$(json_str "$agent")" "$kind"
        return 0
    fi

    # Build the record in python so the body is JSON-escaped properly — a
    # message containing a quote or a newline must not be able to corrupt the
    # ledger it is written into.
    local entry
    entry=$(python3 -c '
import json, sys, time, os
path, kind, body, author, via = sys.argv[1:6]
next_id = 1
if os.path.exists(path):
    with open(path) as fh:
        next_id = sum(1 for line in fh if line.strip()) + 1
print(json.dumps({"id": next_id, "ts": time.time(), "author": author,
                  "via": via, "kind": kind, "body": body}))'         "$f" "$kind" "$body" "$author" "$via") || die "could not build the inbox entry"

    printf '%s\n' "$entry" >> "$f"
    chown root:"$svc_user" "$f"; chmod 0640 "$f"

    local id; id=$(printf '%s' "$entry" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')
    if [[ $JSON -eq 1 ]]; then
        printf '{"agent":%s,"kind":"%s","id":%s,"queued":true,"author":%s}\n' \
            "$(json_str "$agent")" "$kind" "$id" "$(json_str "$author")"
        return 0
    fi
    if [[ "$kind" == "note" ]]; then
        ok "note #$id recorded for '$agent' (it will appear in the report)"
        warn "a note is NOT sent to the agent — use 'say' to steer a live run"
    elif [[ "$kind" == "set_model" ]]; then
        ok "model switch to '$body' #$id queued for '$agent'"
        warn "applied at the next turn boundary if the policy allows it — see \`agenti $agent findings\`"
    else
        ok "message #$id queued for '$agent'"
        if run_active "$agent"; then
            warn "the agent sees it once the step in flight finishes — never mid-step"
        else
            warn "no run is active — it will be delivered when you next resume:"
            warn "  sudo agenti $agent resume"
        fi
    fi
}

# Appends to a team's shared channel.jsonl (CLAUDE.md §3i). Mirrors
# _inbox_append()'s shape (same entry fields, same "build in python so the
# body is JSON-escaped properly" reasoning) but flock'd: unlike the
# per-agent inbox, which only the CLI (root, one process at a time) ever
# writes, this file can be written by the operator's CLI AND any number of
# live agent processes at once — agent_runtime.append_team_channel() (the
# Python side agents call through their team_message tool) uses the exact
# same locking so an id can never be double-assigned by a race between the
# two writers.
_team_channel_append() {
    local name="$1" kind="$2" body="$3" author="$4" via="$5"
    local cf; cf=$(team_channel_file "$name")

    # Same fix as _inbox_append's identical bug: kind=message's real CLI
    # verb is `say`, not "message" (CLAUDE.md §4 item 17).
    local verb; verb="$([[ "$kind" == "message" ]] && printf 'say' || printf '%s' "$kind")"
    [[ -n "$body" ]] || die "$verb needs some text:
  sudo agenti team $name $verb \"focus on the SMB shares first\""
    [[ -f "$cf" ]] || die "no channel for team '$name' — was it created before this feature existed?
recreate it:  sudo agenti team $name delete && sudo agenti team create $name --agents ..."

    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ append %s <- [%s] %s%s\n' "$c_d" "$cf" "$kind" "$body" "$c_0"
        [[ $JSON -eq 1 ]] && printf '{"team":%s,"kind":"%s","queued":false,"dry_run":true}\n' \
            "$(json_str "$name")" "$kind"
        return 0
    fi

    local id
    id=$(python3 -c '
import fcntl, json, sys, time
path, kind, body, author, via = sys.argv[1:6]
with open(path, "a+") as fh:
    fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
    try:
        fh.seek(0)
        next_id = sum(1 for line in fh if line.strip()) + 1
        entry = {"id": next_id, "ts": time.time(), "author": author,
                 "via": via, "kind": kind, "body": body}
        fh.write(json.dumps(entry) + "\n")
        fh.flush()
        print(next_id)
    finally:
        fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
' "$cf" "$kind" "$body" "$author" "$via") || die "could not append to the team channel"

    if [[ $JSON -eq 1 ]]; then
        printf '{"team":%s,"kind":"%s","id":%s,"queued":true,"author":%s}\n' \
            "$(json_str "$name")" "$kind" "$id" "$(json_str "$author")"
        return 0
    fi
    if [[ "$kind" == "note" ]]; then
        ok "note #$id recorded on team '$name' (visible in the channel and every member's report)"
        warn "a note is NOT delivered to any agent — use 'say' to reach the team"
    else
        ok "message #$id posted to team '$name'"
        warn "every OTHER member sees it once its step in flight finishes — never mid-step"
    fi
}

# Posts the "kickoff" entry every time a team starts: who is on the project,
# what each member is (its title and description), what it will work on (its
# target) and the focus the operator gave it. Each member's own instructions
# are built from this entry (agent_runtime.team_briefing) so every agent knows
# its teammates' tasks, and the GUI shows it as the project's opening card.
# Same append discipline as _team_channel_append (flock'd, JSON-safe).
# One argument per member: agent<TAB>role<TAB>target<TAB>capabilities.json path.
_team_channel_append_kickoff() {
    local name="$1" author="$2" via="$3"
    shift 3
    local cf; cf=$(team_channel_file "$name")
    [[ -f "$cf" ]] || die "no channel for team '$name' — was it created before this feature existed?
recreate it:  sudo agenti team $name delete && sudo agenti team create $name --agents ..."

    python3 -c '
import fcntl, json, sys, time
path, author, via, team = sys.argv[1:5]
roster, details, bullets = {}, {}, []
for item in sys.argv[5:]:
    agent, role, target, capf = (item.split("\t") + ["", "", "", ""])[:4]
    title = summary = ""
    try:
        caps = json.load(open(capf))
        title, summary = str(caps.get("title") or ""), str(caps.get("description") or "")
    except (OSError, ValueError):
