# `agenti <agent> provision` — prepare the per-agent parent that users' run
# slots live under. configure.sh calls it for every agent; a user's own slot is
# created on first start.
cmd_provision() {
    local agent="$1"
    local already=0
    [[ -d "$(agent_base_dir "$agent")/instances" ]] && already=1
    ensure_base_provisioned "$agent"
    if [[ $JSON -eq 1 ]]; then
        printf '{"agent":%s,"provisioned":true,"already_existed":%s}\n' \
            "$(json_str "$agent")" "$([[ $already -eq 1 ]] && echo true || echo false)"
        return 0
    fi
    if [[ $already -eq 1 ]]; then
        ok "'$agent' was already provisioned — nothing to do"
    else
        ok "provisioned '$agent' — ready for: sudo agenti $agent start"
    fi
}

# `copies` — the OWNER's run slots of this agent: one per run they started
# (<owner>.<label>), plus any older plain one.
# Read from the filesystem and systemd; there is no registry to drift.
cmd_copies() {
    local agent="$1"
    local inst; inst="$(agent_base_dir "$agent")/instances"
    local -a rows=()
    local d label slot state target
    while IFS= read -r slot; do
        [[ -n "$slot" ]] || continue
        if [[ "$slot" == "$OWNER" ]]; then label=""
        elif [[ "$slot" == "$OWNER".* ]]; then label="${slot#"$OWNER".}"
        else continue; fi
        d="$inst/$slot"
        state=$(systemctl is-active "agenti-${agent}-instance@${slot}.service" 2>/dev/null || true)
        target=$(cat "$d/run-target" 2>/dev/null || true)
        rows+=("$label"$'\x1f'"${state:-unknown}"$'\x1f'"$target")
    done < <(find "$inst" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
    if [[ $JSON -eq 1 ]]; then
        printf '%s\n' "${rows[@]}" | python3 -c '
import json, sys
out = []
for line in sys.stdin.read().splitlines():
    if line:
        copy, state, target = (line.split("\x1f") + ["", ""])[:3]
        out.append({"copy": copy or None, "state": state, "target": target or None})
print(json.dumps({"agent": sys.argv[1], "owner": sys.argv[2], "copies": out}))
' "$agent" "$OWNER"
        return 0
    fi
    printf '  %-16s %-10s %s\n' "COPY" "STATE" "TARGET"
    local line
    for line in "${rows[@]}"; do
        IFS=$'\x1f' read -r label state target <<< "$line"
        printf '  %-16s %-10s %s\n' "${label:-(main)}" "$state" "${target:-—}"
    done
    printf '\n  a verb on one run:  sudo agenti %s <verb> --copy <label>\n' "$agent"
    printf '  remove a run:       sudo agenti %s copies remove <label>\n' "$agent"
}

# Delete one of the owner's SECOND copies and everything it holds. The main
# slot is never removable here: it carries the owner's run history.
cmd_copy_remove() {
    local agent="$1"; shift
    local label=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) DRY_RUN=1; shift ;;
            -*) die "unknown option for 'copies remove': $1" ;;
            *)  [[ -z "$label" ]] || die "'copies remove' takes ONE label"
                label="$1"; shift ;;
        esac
    done
    [[ -n "$label" ]] || die "usage: sudo agenti $agent copies remove <label>
list them:  sudo agenti $agent copies"
    valid_name "$label" || die "invalid copy label '$label'"
    local slot="$OWNER.$label"
    local dir; dir="$(agent_base_dir "$agent")/instances/$slot"
    [[ -d "$dir" ]] || die "no copy '$label' of '$agent' for '$OWNER'.
list them:  sudo agenti $agent copies"
    local u="agenti-${agent}-instance@${slot}.service"
    systemctl is-active --quiet "$u" 2>/dev/null && die "copy '$label' is still running — stop it first:
  sudo agenti $agent stop --copy $label"
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ rm -rf %s%s\n' "$c_d" "$dir" "$c_0"
        [[ $JSON -eq 1 ]] && printf '{"agent":%s,"copy":%s,"removed":false,"dry_run":true}\n' \
            "$(json_str "$agent")" "$(json_str "$label")"
        return 0
    fi
    rm -rf "$dir"
    _unit_lib remove_dropin "$u" team
    systemctl reset-failed "$u" 2>/dev/null || true
    if [[ $JSON -eq 1 ]]; then
        printf '{"agent":%s,"copy":%s,"removed":true}\n' \
            "$(json_str "$agent")" "$(json_str "$label")"
    else
        ok "removed copy '$label' of '$agent' (its runs, reports and state are gone)"
    fi
}

# promote-output (CLAUDE.md "Current plan", phase 3 of the generic-launcher
# arc, decision 8): copy one report out of an agent's own reports/ into the
# organisation's permanent Outputs store, gated by the two-level quota
# (shared/iam.py's outputs_check). Reports already never age out on their
# own — this is the mechanism the plan describes for making that lifecycle
# explicit and visible in the Outputs store rather than something that just
# happens to be true because nothing sweeps reports/ (see retention.py's own
# docstring).
cmd_promote_output() {
    local agent="$1"; shift
    local by="" file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --by)   [[ $# -ge 2 ]] || die "--by needs a value, e.g. --by alice"
                    by="$2"; shift 2 ;;
            -*)     die "unknown option for promote-output: $1" ;;
            *)      [[ -z "$file" ]] || die "promote-output takes ONE report filename:
  sudo agenti $agent promote-output <filename>"
                    file="$1"; shift ;;
        esac
    done
    [[ -n "$file" ]] || die "usage: sudo agenti $agent promote-output <filename>
see available reports:  sudo agenti $agent reports"
    # Same filename shape cmd_report already enforces, for the same reason:
    # this runs as root, and a naive \"\$dir/reports/\$file\" would let a
    # crafted filename escape reports/ entirely (CLAUDE.md §4 item 15).
    [[ "$file" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] \
        || die "invalid report filename '$file' — no '/' or leading '.'.
see available reports:  sudo agenti $agent reports"

    local dir; dir=$(agent_dir "$agent")
    local src="$dir/reports/$file"
    _slot_cat "$dir" "reports/$file" >/dev/null 2>&1 \
        || die "no such report: $file  (see: sudo agenti $agent reports)"
    # A kept file belongs to the run's owner — the report came from their slot.
    [[ -z "$by" || "$by" == "$OWNER" ]] || die "promote-output keeps a file for the run's owner ('$OWNER');
--by '$by' does not match. Drop --by, or pass --owner $by to act on their run."
    local principal="$OWNER"

    # outputs.py and iam.py both live in the code folder ($LIBDIR).
    local result rc=0
    result=$(python3 - "$(lib_dir)" "$src" "$principal" "$AGENTI_ROOT" <<'PY'
import json, sys
from pathlib import Path
libdir, src, principal, root = sys.argv[1:5]
sys.path.insert(0, libdir)


def fail(msg):
    print(json.dumps({"error": msg})); sys.exit(2)


try:
    import outputs
except Exception as e:
    fail(f"could not load outputs.py from {libdir} ({e}) — reinstall: sudo apt install --reinstall agenti")
try:
    import iam
except Exception as e:
    fail(f"could not load iam.py ({e}) — reinstall: sudo apt install --reinstall agenti")

src_path = Path(src)
conn = iam.open_iam(readonly=True)
gate = {}


def approve(size):
    # The quota is judged on the size of the descriptor that is then copied.
    gate.update(iam.outputs_check(conn, principal, incoming_bytes=size))
    if not gate["allowed"]:
        raise outputs.OutputsError(gate["reason"])


dest_dir = Path(root) / "org" / "outputs" / principal
try:
    dest, size = outputs.promote_output(src_path.parent, src_path.name, dest_dir, approve=approve)
except outputs.OutputsError as e:
    fail(str(e))
print(json.dumps({"user": principal, "promoted": True,
                  "name": dest.name, "bytes": size, "warnings": gate["warnings"]}))
PY
) || rc=$?
    if [[ $rc -ne 0 ]]; then
        local err; err=$(printf '%s' "$result" | python3 -c \
            'import json,sys
try: print(json.load(sys.stdin).get("error", "promotion failed"))
except Exception: print("promotion failed")' 2>/dev/null)
        die "${err:-promotion failed}"
    fi
    if [[ $JSON -eq 1 ]]; then
        printf '%s\n' "$result"
        return 0
    fi
    local name bytes
    name=$(printf '%s' "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin)["name"])')
    bytes=$(printf '%s' "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin)["bytes"])')
    ok "promoted '$file' to the permanent Outputs store as '$name' ($bytes bytes, owned by $principal)"
    printf '%s' "$result" | python3 -c '
import json, sys
d = json.load(sys.stdin)
for w in d.get("warnings", []):
    print("  ! " + w["message"])
'
}

# ---------------------------------------------------------------------------
# Files an operator attaches to a run (CLAUDE.md §4 item 82). Every rule —
# names, size limits, where a file goes, what the agent is told — lives in
# run_files.py (the harness copy the agents import too); these verbs only
# say which run slot(s) and whether each is running now.
#
# Through the API the bytes always arrive on stdin (`attach -`), never as a
# path: root never opens a file the web account chose.
# ---------------------------------------------------------------------------

# Runs one run_files.py command. Its JSON lands in RF_OUT; a refusal ends the
# script with run_files.py's own message. Called directly, never inside $(...),
# so the die() actually stops the verb.
_run_files() {
    local py; py="$(lib_dir)/run_files.py"
    [[ -f "$py" ]] || py="$(dirname "${BASH_SOURCE[0]}")/run_files.py"
    [[ -f "$py" ]] || die "run_files.py is missing.
reinstall it:  $REINSTALL"
    local rc=0
    RF_OUT=$(python3 "$py" "$@") || rc=$?
    [[ $rc -eq 0 ]] && return 0
    local err; err=$(printf '%s' "$RF_OUT" | python3 -c 'import json,sys
try: print(json.load(sys.stdin)["error"])
except Exception: print("")' 2>/dev/null) || true
    die "${err:-run_files.py failed: $RF_OUT}"
}

# Root reading what a run wrote (audit run 1, F16): every file under a slot
# was written by the run's account, so it is read through run_files.py, which
# walks by descriptor and never follows a link. <slot dir> <path> [tail N]
_slot_cat() {
    local py; py="$(lib_dir)/run_files.py"
    local -a extra=(); [[ -n "${3:-}" ]] && extra=(--tail "$3")
    python3 "$py" cat --slot "$1" --path "$2" "${extra[@]}"
}
# <slot dir>: the run's state.json as one line of JSON, parsed and re-serialised,
# or {} when it is missing, refused (a link, FIFO ...) or not a JSON object. Root
# never echoes the raw bytes a run wrote (audit run 2: a link to a root-only
# file came back to the web in an error page).
_slot_state_json() {
    local raw; raw=$(_slot_cat "$1" state/state.json 2>/dev/null) || raw=""
    printf '%s' "$raw" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print(json.dumps(d if isinstance(d, dict) else {}))'
}
# <slot dir> <folder> <suffix>: JSON {"files":[{name,bytes,mtime[,status]}]}, newest first.
_slot_list() {
    python3 "$(lib_dir)/run_files.py" list-files --slot "$1" --folder "$2" --suffix "$3" ${4:+--status}
}
# <slot dir> <folder> <suffix,suffix>: the same, for every file under the folder.
_slot_list_recursive() {
    python3 "$(lib_dir)/run_files.py" list-files --slot "$1" --folder "$2" --suffix "$3" --recursive
}
# <slot dir>: the newest plain reports/*.md, or nothing.
_slot_newest_report() {
    _slot_list "$1" reports .md | python3 -c 'import json,sys
f = json.load(sys.stdin)["files"]
print(f[0]["name"] if f else "")'
}

# The result: the whole JSON under --json, else its one-line (or listing) text.
_rf_print() {
    if [[ $JSON -eq 1 ]]; then printf '%s\n' "$RF_OUT"; return 0; fi
    printf '%s' "$RF_OUT" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("text",""))'
}
_rf_field() { printf '%s' "$RF_OUT" | python3 -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1]) or "")' "$1"; }

# Sets ATTACH_SRC/ATTACH_NAME from `<file|-> [--name <name>]`.
_parse_attach_args() {
    local usage="$1"; shift
    ATTACH_SRC=""; ATTACH_NAME=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)   [[ $# -ge 2 ]] || die "--name needs a value"; ATTACH_NAME="$2"; shift 2 ;;
            --name=*) ATTACH_NAME="${1#*=}"; shift ;;
            -?*)      die "unknown option for attach: $1" ;;
            *)        [[ -z "$ATTACH_SRC" ]] || die "attach takes ONE file"; ATTACH_SRC="$1"; shift ;;
        esac
    done
    [[ -n "$ATTACH_SRC" ]] || die "usage: $usage"
    if [[ "$(invoking_user)" == "${AGENTI_API_USER:-agenti-api}" && "$ATTACH_SRC" != "-" ]]; then
        die "REFUSING: through the API a file can only arrive on stdin (attach -)."
    fi
    [[ "$ATTACH_SRC" != "-" || -n "$ATTACH_NAME" ]] || die "reading stdin (-) needs --name <file name>"
    [[ -n "$ATTACH_NAME" ]] || ATTACH_NAME="${ATTACH_SRC##*/}"
}

# A start that failed: its files go back to waiting for the next attempt.
STAGE_DIR=""   # set by an unlabelled start: where its waiting files came from
_files_back() {
    [[ $DRY_RUN -eq 1 ]] && return 0
    ( _run_files unbegin --slot "$1" --group "$SVC_USER" ) >/dev/null 2>&1 || true
    # An unlabelled start made a fresh slot just for this attempt; if it
    # failed, the files go back to where `attach` staged them so the next
    # start (a different fresh slot) still gets them.
    if [[ -n "$STAGE_DIR" && -d "$STAGE_DIR" ]]; then
        ( _run_files transfer-pending --from "$1" --to "$STAGE_DIR" --group "$SVC_USER" ) >/dev/null 2>&1 || true
    fi
}

_via() { [[ "$(invoking_user)" == "${AGENTI_API_USER:-agenti-api}" ]] && printf api || printf cli; }

cmd_attach() {
    local agent="$1"; shift
    _parse_attach_args "sudo agenti $agent attach <file> [--name <name>]   (or - for stdin, with --name)" "$@"
    ensure_vault
    ensure_slot_provisioned "$agent"
    local mode=pending; run_active "$agent" && mode=run
    _run_files attach --src "$ATTACH_SRC" "--name=$ATTACH_NAME" --by "$OWNER" --group "$SVC_USER" \
        --target "$agent:$mode:$(agent_dir "$agent")"
    # A file joining a run going now: tell the agent, in fixed wording.
    if [[ $mode == run ]]; then
        ( JSON=1 _inbox_append "$agent" message "$(_rf_field agent_message)" "$OWNER" "$(_via)" ) \
            >/dev/null 2>&1 || note '  ! the file is attached, but the run could not be told about it\n'
    fi
    _rf_print
}

cmd_files() {
    local agent="$1"; shift
    case "${1:-}" in
        "") _run_files list --slot "$(agent_dir "$agent")" ;;
        remove)
            [[ $# -eq 2 ]] || die "usage: sudo agenti $agent files remove <name>"
            require_slot "$agent"
            _run_files remove --slot "$(agent_dir "$agent")" "--name=$2" ;;
        *) die "usage: sudo agenti $agent files               this run's files, and those waiting for the next
       sudo agenti $agent files remove <name> take back a file waiting for the next run" ;;
    esac
    _rf_print
}

# Hand a run's output to another agent (CLAUDE.md §4 item 85). The chosen items —
# this run's report, the raw outputs its tools saved, the files it was given —
# become FILES ATTACHED to the sender's own main run of the other agent, through
# the same attach everything uses: limits, SHA-256, "who attached it" and the
# 30-day sweep all apply. The receiver gets no authority from them; a file is
# data. run_files.py reads the items link-safely (the sending agent can write
# the folders root reads from).
cmd_send_list() {
    local agent="$1"; shift
    [[ $# -eq 0 ]] || die "usage: sudo agenti $agent send-list [--json]"
    _run_files sources --slot "$(agent_dir "$agent")"
    _rf_print
}

cmd_send() {
    local agent="$1"; shift
    local dest="" to_copy="" usage="sudo agenti $agent send --to <agent> --item report:<name> [--item output:<name>] [--item file:<name>] [--to-copy <label>]"
    local -a items=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --to)     [[ $# -ge 2 ]] || die "--to needs an agent name.  usage: $usage"; dest="$2"; shift 2 ;;
            --to=*)   dest="${1#*=}"; shift ;;
            --to-copy)   [[ $# -ge 2 ]] || die "--to-copy needs a label"; to_copy="$2"; shift 2 ;;
            --to-copy=*) to_copy="${1#*=}"; shift ;;
            --item)   [[ $# -ge 2 ]] || die "--item needs report:<name>, output:<name> or file:<name>"; items+=("--item=$2"); shift 2 ;;
            --item=*) items+=("$1"); shift ;;
            *)        die "unknown option for send: $1
usage: $usage" ;;
        esac
    done
    [[ -n "$dest" ]] || die "say which agent to send it to.  usage: $usage"
    [[ ${#items[@]} -gt 0 ]] || die "choose at least one item to send.  usage: $usage
(sudo agenti $agent send-list shows what this run has)"
    ensure_vault
    require_agent "$dest"
    local src_dir; src_dir=$(agent_dir "$agent")
    [[ -d "$src_dir" ]] || die "'$OWNER' has no runs of '$agent'${COPY:+ (copy '$COPY')} yet, so there is nothing to send."
    # The files wait for the receiver's NEXT run: in the slot named by
    # --to-copy (the GUI reserves one per launch), else the owner's plain
    # staging slot, which the next unlabelled start moves them out of.
    [[ -z "$to_copy" ]] || valid_name "$to_copy" || die "invalid --to-copy label '$to_copy'"
    local saved_slot="$SLOT" mode=pending dest_dir
    SLOT="$OWNER${to_copy:+.$to_copy}"
    ensure_slot_provisioned "$dest"
    run_active "$dest" && mode=run
    dest_dir=$(agent_dir "$dest")
    SLOT="$saved_slot"
    _run_files send --slot "$src_dir" "${items[@]}" --by "$OWNER (sent from $agent)" --group "$SVC_USER" \
        --target "$dest:$mode:$dest_dir"
    if [[ $mode == run ]]; then
        SLOT="$OWNER"
        ( JSON=1 _inbox_append "$dest" message "$(_rf_field agent_message)" "$OWNER" "$(_via)" ) \
            >/dev/null 2>&1 || note '  ! the files are attached, but the run could not be told about them\n'
        SLOT="$saved_slot"
    fi
    _rf_print
}

# A team's file goes to every member: written once, hard-linked into each
# member's slot. Members running now get it at once (and one message on the
# team channel); the others get it when they next start.
cmd_team_attach() {
    local name="$1"; shift
    _parse_attach_args "sudo agenti team $name attach <file> [--name <name>]" "$@"
    local -a targets=(); local line agent mode live=0
    mapfile -t member_lines < <(_team_members "$name")
    for line in "${member_lines[@]}"; do
        agent="${line%%$'\t'*}"
        ensure_slot_provisioned "$agent"
        mode=pending; run_active "$agent" && { mode=run; live=1; }
        targets+=(--target "$agent:$mode:$(agent_dir "$agent")")
    done
    [[ ${#targets[@]} -gt 0 ]] || die "team '$name' has no members."
    _run_files attach --src "$ATTACH_SRC" "--name=$ATTACH_NAME" --by "$OWNER" --group "$SVC_USER" "${targets[@]}"
    if [[ $live -eq 1 ]]; then
        ( JSON=1 _team_channel_append "$name" message "$(_rf_field agent_message)" "$OWNER" "$(_via)" ) \
            >/dev/null 2>&1 || note '  ! the file is attached, but the team could not be told about it\n'
    fi
    _rf_print
}

cmd_team_files() {
    local name="$1"; shift
    local -a slots=(); local line agent
    mapfile -t member_lines < <(_team_members "$name")
    for line in "${member_lines[@]}"; do
        agent="${line%%$'\t'*}"
        slots+=("$agent=$(agent_dir "$agent")")
    done
    case "${1:-}" in
        "") _run_files list "${slots[@]/#/--member=}" ;;
        remove)
            [[ $# -eq 2 ]] || die "usage: sudo agenti team $name files remove <name>"
            local -a args=(); local s
            for s in "${slots[@]}"; do args+=(--slot "${s#*=}"); done
            _run_files remove "${args[@]}" "--name=$2" ;;
        *) die "usage: sudo agenti team $name files [remove <name>]" ;;
    esac
    _rf_print
}

cmd_audit() {
    # The audit log is CLAUDE.md §1 invariant 6 ("per-command validation
    # decisions and run activity are logged"), and it lives inside the vault at
    # 0640 root:<service account> — which meant that until this verb existed, the
    # only way to read it was a root shell. An audit record nobody can read
    # without breaking glass is not much of an audit record, and the GUI needs
    # this view too.
    #
    # Read-only by construction: this cats a file, it never writes one.
    local agent="$1"; shift
    local n=200
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n) [[ $# -ge 2 ]] || die "-n needs a value, e.g. -n 50"
                n="$2"; require_int "$n" "-n"; shift 2 ;;
            *)  die "unknown option for audit: $1" ;;
        esac
    done
    local f; f="$(agent_dir "$agent")/audit.log"
    [[ -f "$f" ]] || die "no audit log yet at $f — it is created on the first run.
start one:  sudo agenti $agent start -t <target> --model sonnet"
    if [[ $JSON -eq 1 ]]; then
        tail -n "$n" "$f" | python3 -c '
import json, sys
print(json.dumps([l.rstrip("\n") for l in sys.stdin]))'
    else
        tail -n "$n" "$f"
    fi
}

# `agenti <agent> approval` — a per-AGENT VIEW of the organisation's
# approval status. The approval is bound to the record's content digest, so
# "approved" here means "current", not merely "a file exists".
#
# Deliberately asks engagement_store.py for --format json REGARDLESS of
# this CLI's own $JSON flag — it parses the result itself either way, and
# _run_engagement_store's own fmt selection follows $JSON, which would hand
# a human-text rendering to json.load() under a plain-text call. Found by
# actually running this in text mode, not by reading the code.
cmd_approval() {
    local agent="$1"
    local store; store=$(engagement_store_py) || die "engagement_store.py is missing.
reinstall it:  $REINSTALL"
    local out rc=0
    out=$(python3 "$store" --org-dir "$(org_dir)" \
        --shared-dir "$AGENTI_ROOT/shared" --format json show 2>&1) || rc=$?
    if [[ $rc -ne 0 ]]; then
        die "$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error","invalid input"))
except Exception: print("invalid input")' 2>/dev/null)"
    fi
    if [[ $JSON -eq 1 ]]; then
        printf '%s\n' "$out" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(json.dumps(d.get("approval_status", {})))'
        return 0
    fi
    printf '%s\n' "$out" | python3 -c '
import json, sys
d = json.load(sys.stdin)
st = d.get("approval_status", {})
print("approval for %s (every agent reads the same record):" % sys.argv[1])
print("  · engagement_id  %s" % (d.get("record") or {}).get("engagement_id", "?"))
print("  · approved       %s" % st.get("approved", False))
print("  · current        %s" % st.get("current", False))
print("  · reason         %s" % st.get("reason", "?"))
if not st.get("current"):
    print()
    print("  approve:  sudo agenti engagement approve")
' "$agent"
}

# 'new' is a THIN dispatch to new_agent.py, same principle as 'vault' and
# 'set-key' dispatching to their own scripts. Deliberately NOT need_root: it
# only writes files into a source checkout (or wherever --dir points), the
# same as any other file you'd create in your own working directory — no
# root-owned path is touched until 'sudo ./shared/deploy.sh' later.
#
# Deliberately NOT run through system python3's -B / the vault's venv: this
# runs BEFORE deployment, possibly before the vault has ever been unlocked,
# so it only uses the standard library — see new_agent.py's own docstring.
cmd_new() {
    command -v python3 &>/dev/null || die "python3 is required to scaffold a new agent, but it's not on PATH."
    local script=""
    if [[ -x "$LIBDIR/new_agent.py" ]]; then
        script="$LIBDIR/new_agent.py"
    elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/new_agent.py" ]]; then
        script="$(dirname "${BASH_SOURCE[0]}")/new_agent.py"
    else
        die "new_agent.py not found in $LIBDIR or next to this script.
if agenti is installed:    $REINSTALL
if running from source:    make sure shared/new_agent.py exists next to shared/agenti"
    fi
    python3 "$script" "$@"
}

# The one vault action the web tier may start (decision 6, audit run 1): turn
# it on, after an admin re-authenticated for exactly this size. The passphrase
# arrives on stdin (the bridge passes the request body through) and goes
# straight to vault.sh's stdin: never an argument, never stored. Unlock, lock,
# disable and passphrase changes stay at the terminal.
cmd_vault_enable_web() {
    local size="" grant=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --size)    [[ $# -ge 2 ]] || die "--size needs a value"; size="$2"; shift 2 ;;
            --size=*)  size="${1#*=}"; shift ;;
            --grant)   [[ $# -ge 2 ]] || die "--grant needs a value"; grant="$2"; shift 2 ;;
            --grant=*) grant="${1#*=}"; shift ;;
            *) die "REFUSING: 'vault enable' from the web takes only --size and --grant." ;;
        esac
    done
    [[ "$size" =~ ^[1-9][0-9]{0,3}G$ ]] || die "--size must be whole gigabytes, like 8G"
    [[ -n "$grant" ]] || die "REFUSING: turning the vault on from the web needs a fresh re-authentication (an approval grant)."
    local aout arc=0
    aout=$(python3 "$IAM_PY" --json approve-vault-enable "--size=$size" "--grant=$grant" 2>&1) || arc=$?
    if [[ $arc -ne 0 ]]; then
        local e; e=$(printf '%s' "$aout" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error",""))
except Exception: print("")' 2>/dev/null)
        die "${e:-$aout}"
    fi
    local by; by=$(printf '%s' "$aout" | python3 -c "import json,sys; print(json.load(sys.stdin)['approved_by'])")
    # Run as its own systemd job, not as a child of this process: reached from
    # the web, this process lives in agenti-api's private mount namespace
    # (PrivateTmp), where a mount is invisible to the rest of the system. Found
    # live: the vault was created and filled, but mounted only inside the
    # API's namespace. --pipe hands the job this stdin (the passphrase).
    local out rc=0
    out=$(systemd-run --quiet --wait --pipe --collect --unit="agenti-vault-enable-$$" \
            --property=Type=exec -- "$VAULT_SH" enable --size "$size" --passphrase-stdin --yes 2>&1) || rc=$?
    logger -t agenti "VAULT_ENABLE | by=$by | via=api | size=$size | rc=$rc" 2>/dev/null || true
    if [[ $rc -ne 0 ]]; then
        die "the vault was not turned on: $(printf '%s' "$out" | grep -i 'error\|refus\|not \|fail' | tail -n 3 | tr '\n' ' ')
Nothing was changed. Details on the server: sudo journalctl -t agenti -n 20"
    fi
    if [[ $JSON -eq 1 ]]; then
        python3 -c 'import json,sys; print(json.dumps({"ok": True, "vault": "unlocked", "size": sys.argv[1], "approved_by": sys.argv[2]}))' "$size" "$by"
    else
        printf '%s\n' "$out"
    fi
}

cmd_vault() {
    [[ -x "$VAULT_SH" ]] || die "$VAULT_SH missing.
reinstall it:  $REINSTALL"
    case "${1:-status}" in
        status|enable|disable|unlock|lock|passphrase|help|-h|--help) run "$VAULT_SH" "${@:-status}" ;;
        *) die "vault verbs: status | enable [--size 8G] | disable | unlock | lock | passphrase
(the vault is optional; details: agenti vault --help)" ;;
    esac
}

# The web GUI is two systemd units that are useless apart: agenti-authd (login,
# sessions, permission checks) and agenti-api (serves the pages). Managed here
# as one thing rather than through a wrapper unit or target, because
# `systemctl status` on a wrapper reports the wrapper — it can read "active"
# while the real service behind it has crashed.
GUI_UNITS=(agenti-authd.service agenti-api.socket agenti-api.service)
GUI_API_UNIT_FILE="/etc/systemd/system/agenti-api.service"
GUI_API_SOCKET_FILE="/etc/systemd/system/agenti-api.socket"

# docs: the user help pages (docs/help, installed to $LIBDIR/help) — list,
# read and search them. No root: the pages are world-readable and hold
# nothing secret. help_docs.py does the work, for this verb and, through it,
# for the API's /docs routes and the GUI's Docs page.
# `agenti --version`: the release (the .deb's, else the VERSION file) and the
# plugin API version an add-on package must match. No root, no vault.
version_file() {
    local f
    for f in "$LIBDIR/$1" "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/$1"; do
        [[ -f "$f" ]] && { tr -d ' \n' < "$f"; return 0; }
    done
    return 1
}
cmd_version() {
    local v="" api st=""
    # The package's version only describes the installed program; a checkout's
    # copy reports its own VERSION file.
    if [[ "$(readlink -f "${BASH_SOURCE[0]}")" == "$(readlink -f "$AGENTI_BIN")" ]]; then
        st=$(dpkg-query -W -f='${Status}|${Version}' agenti 2>/dev/null) || st=""
    fi
    [[ "$st" == "install ok installed|"* ]] && v="${st#*|}"
    [[ -n "$v" ]] || v=$(version_file VERSION) || v="unknown"
    api=$(version_file PLUGIN_API_VERSION) || api="unknown"
    if [[ $JSON -eq 1 ]]; then
        printf '{"version": "%s", "plugin_api": "%s"}\n' "$v" "$api"
    else
        printf 'agenti %s (plugin API %s)\n' "$v" "$api"
    fi
}

docs_usage() {
cat <<'EOF'
agenti docs — the help pages (no root needed)

  agenti docs [list]                every page, with a one-line summary
  agenti docs <page>                read one page, e.g. agenti docs signing-in
  agenti docs show <page>           the same
  agenti docs search <words...>     the pages and sections that mention every word
                                    (part of a word is enough: "pass" finds passkey)

  Add --json to any of them for one JSON document.
  The same pages, with the same search, are in the web GUI: menu → Docs.
EOF
}

cmd_docs() {
    local here py dir
    here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    py="$LIBDIR/help_docs.py"; [[ -f "$py" ]] || py="$here/help_docs.py"
    dir="$LIBDIR/help";        [[ -d "$dir" ]] || dir="$here/../docs/help"
    [[ -f "$py" ]] || die "help_docs.py is missing, so the help pages cannot be read.
reinstall it:  $REINSTALL"
    local sub="${1:-list}"
    [[ $# -gt 0 ]] && shift
    local args=(--dir "$dir")
    [[ $JSON -eq 1 ]] && args+=(--json)
    case "$sub" in
        list)
            [[ $# -eq 0 ]] || die "docs list takes no arguments (got: $*).
usage: agenti docs [list]"
            args+=(list) ;;
        show)
            [[ $# -eq 1 ]] || die "docs show needs exactly one page name, e.g. agenti docs show teams
list the pages:  agenti docs"
            args+=(show "--page=$1") ;;
        search)
            [[ $# -ge 1 ]] || die "docs search needs one or more words to look for, e.g. agenti docs search passkey"
            if [[ $# -eq 1 && "$1" == --query=* ]]; then args+=(search "$1")
            else args+=(search "--query=$*"); fi ;;
        help)
            docs_usage; return 0 ;;
        *)
            [[ $# -eq 0 ]] || die "unknown docs command '$sub'.
usage: agenti docs [list] | agenti docs <page> | agenti docs search <words>"
            args+=(show "--page=$sub") ;;
    esac
    local out rc=0
    out=$(python3 "$py" "${args[@]}" 2>&1) || rc=$?
    [[ $rc -eq 0 ]] || die "$out"
    printf '%s\n' "$out"
}

gui_usage() {
cat <<'EOF'
agenti gui — the web GUI (agenti-authd + agenti-api, managed as one)

  agenti gui status [--json]      running? starts at boot? where to open it?
  sudo agenti gui enable          start it now AND on every boot
  sudo agenti gui disable         stop starting it on boot (leaves it running)
  sudo agenti gui start | stop | restart
  sudo agenti gui logs [-f] [-n N]
  sudo agenti gui configure ...   how it is reached: --bind, --tls, --hostname,
                                  --behind-proxy (sudo agenti gui configure --help)

After a reboot an enabled GUI comes back by itself. If the vault is on, it
stays locked until you unlock it — on purpose, so a powered-off box never
wakes up with its data open. Agents cannot run until you do:
  sudo agenti vault unlock
EOF
}

gui_show() {   # [action] — the status report, after an action or on its own
    local action="${1:-}" u a e line host="" port="" scheme=http name vault=locked
    local running=1 boots=1 crashed=0
    local -a svc=()
    for u in "${GUI_UNITS[@]}"; do
        a=$(systemctl is-active "$u" 2>/dev/null || true);  [[ -n "$a" ]] || a=unknown
        e=$(systemctl is-enabled "$u" 2>/dev/null || true); [[ -n "$e" ]] || e=unknown
        [[ "$a" == active ]]  || running=0
        [[ "$a" != failed ]]  || crashed=1
        [[ "$e" == enabled ]] || boots=0
        svc+=("${u%.service}" "$a" "$e")
    done
    line=$(grep -m1 '^ListenStream=' "$GUI_API_SOCKET_FILE" 2>/dev/null || true)
    [[ "$line" =~ ^ListenStream=(.+):([0-9]+)$ ]] && { host="${BASH_REMATCH[1]}"; port="${BASH_REMATCH[2]}"; }
    line=$(grep -m1 '^ExecStart=' "$GUI_API_UNIT_FILE" 2>/dev/null || true)
    [[ "$line" == *--ssl-certfile* ]] && scheme=https
    name=$(sed -n 's/^HOSTNAME=//p' "$AGENTI_API_CONF" 2>/dev/null | head -n1 || true)
    local url="$scheme://${name:-$host}:$port"
    # Behind a local proxy/tunnel the address people open is the public domain
    # on the scheme's default port; this service's own loopback port is private.
    if grep -qx 'BEHIND_PROXY=1' "$AGENTI_API_CONF" 2>/dev/null && [[ -n "$name" ]]; then
        url="https://$name"
    fi
    vault=$(vault_state)

    if [[ $JSON -eq 1 ]]; then
        python3 -c '
import json, sys
a = sys.argv
svc = {a[i]: {"active": a[i + 1], "enabled": a[i + 2]} for i in range(5, len(a), 3)}
out = {"services": svc,
       "running": all(s["active"] == "active" for s in svc.values()),
       "starts_at_boot": all(s["enabled"] == "enabled" for s in svc.values()),
       "url": a[2], "listen": a[3], "vault": a[4]}
if a[1]:
    out["action"] = a[1]
print(json.dumps(out))
' "$action" "$url" "$host:$port" "$vault" "${svc[@]}"
        return 0
    fi

    case "$action" in
        start)   ok "started the web GUI" ;;
        restart) ok "restarted the web GUI" ;;
        stop)    ok "stopped the web GUI" ;;
        enable)  ok "the web GUI now starts on every boot (and is running now)" ;;
        disable) ok "the web GUI will no longer start on boot" ;;
    esac
    local i state boot
    for (( i = 0; i < ${#svc[@]}; i += 3 )); do
        case "${svc[i+1]}" in
            active) state="running" ;;
            failed) state="FAILED" ;;
            *)      state="${svc[i+1]}" ;;
        esac
        [[ "${svc[i+2]}" == enabled ]] && boot="starts on boot" || boot="does NOT start on boot"
        if [[ "${svc[i+1]}" == active ]]; then
            ok "$(printf '%-13s %-9s %s' "${svc[i]}" "$state" "$boot")"
        else
            printf '  %s✗%s %-13s %-9s %s\n' "$c_r" "$c_0" "${svc[i]}" "$state" "$boot"
        fi
    done
    if [[ $running -eq 1 ]]; then
        printf '  open:  %s   (serving on %s:%s)\n' "$url" "$host" "$port"
    else
        warn "the GUI is not reachable right now."
        printf '      start it:        sudo agenti gui start\n'
        [[ $crashed -eq 0 ]] || printf '      see why it died: sudo agenti gui logs -n 60\n'
    fi
    [[ $boots -eq 1 ]] || warn "it will not come back after a reboot. Fix:  sudo agenti gui enable"
    if [[ "$vault" == off ]]; then
        :
    elif [[ "$vault" == unlocked ]]; then
        ok "vault unlocked"
    else
        warn "vault is locked — you can log in, but agents cannot run until:  sudo agenti vault unlock"
    fi
}

# Verbs for a person at the host's own console, never for the API account:
# the vault, first-run setup, the system checks, how the GUI is reached. The
# API's sudoers grant permits any arguments to this binary, so the refusal
# lives here, where every one of those calls arrives.
console_only() {
    local what="$1" api_user="${AGENTI_API_USER:-agenti-api}"
    [[ "$(invoking_user)" == "$api_user" ]] || return 0
    die "REFUSING: '$api_user' may not run '$what'.
That is for a person at the host's own terminal: reached through the API, a
compromised web tier could lock or unwrap the vault, or expose the GUI.
Run it as yourself:  sudo agenti $what"
}

# `agenti setup-code`: the one-time code the GUI's setup page asks for
# (operator decision 2026-10-26). Shown by the package's first install too.
setup_code_usage() {
    cat <<'EOF'
usage: sudo agenti setup-code [--new] [--if-needed]

Shows the one-time setup code. Until the first admin exists, the GUI's setup
page asks for it, so only someone at this machine can claim the organisation.
The page works only on this machine itself:  http://127.0.0.1:8420
(from another computer, tunnel the port first:  ssh -L 8420:127.0.0.1:8420 <this machine>)

  --new        replace the code with a fresh one (the old one stops working)
  --if-needed  print nothing, and succeed, when setup is already done

Twenty wrong tries burn the code; make another with --new. It is deleted by
itself once an admin can sign in. Prefer the terminal?  sudo agenti setup
EOF
}

_json_field() {   # _json_field <key>: one string field of the JSON on stdin, or nothing
    python3 -c 'import json,sys
try: print(json.load(sys.stdin).get(sys.argv[1],""))
except Exception: print("")' "$1" 2>/dev/null
}

cmd_setup_code() {
    local -a args=()
    local if_needed=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --new) args+=(--new); shift ;;
            --if-needed) if_needed=1; shift ;;
            -h|--help) setup_code_usage; return 0 ;;
            *) die "unknown option for setup-code: $1
$(setup_code_usage)" ;;
        esac
    done
    [[ -f "$IAM_PY" ]] || die "$IAM_PY is missing. reinstall it:  $REINSTALL"
    local out rc=0 code
    out=$(python3 "$IAM_PY" --json --actor "$(invoking_user)" setup-code "${args[@]}" 2>&1) || rc=$?
    code=$(printf '%s' "$out" | _json_field setup_code)
    if [[ $rc -ne 0 || -z "$code" ]]; then
        [[ $if_needed -eq 1 ]] && return 0
        local e; e=$(printf '%s' "$out" | _json_field error)
        die "${e:-$out}"
    fi
    if [[ $JSON -eq 1 ]]; then printf '%s\n' "$out"; return 0; fi
    local port; port=$(sed -n 's/^BIND_PORT=//p' "$AGENTI_API_CONF" 2>/dev/null | head -n1)
    cat <<EOF

  Finish setting up Agenti in a browser on this machine:

      http://127.0.0.1:${port:-8420}

  Setup code:  $c_b$code$c_0

  (Show it again: sudo agenti setup-code.  Set up in this terminal instead: sudo agenti setup)

EOF
}

# `admin set-api-key`, from Settings → Platform only: the key arrives on stdin,
# behind an admin's fresh re-authentication bound to the key's SHA-256. At a
# terminal, use sudo agenti setup (or set-secret.sh), which prompts silently.
cmd_set_api_key_web() {
    local grant=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --grant=*) grant="${1#*=}"; shift ;;
            *) die "REFUSING: 'admin set-api-key' takes only --grant=<id>, with the key on stdin." ;;
        esac
    done
    [[ -n "$grant" ]] || die "REFUSING: saving the API key from the web needs a fresh re-authentication (an approval grant).
At the terminal instead:  sudo agenti setup"
    local key; IFS= read -r key || true
    [[ -n "$key" ]] || die "no key was given"
    local sha; sha=$(printf '%s' "$key" | sha256sum | cut -d' ' -f1)
    local aout arc=0
    aout=$(python3 "$IAM_PY" --json approve-api-key "--sha256=$sha" "--grant=$grant" 2>&1) || arc=$?
    if [[ $arc -ne 0 ]]; then
        local e; e=$(printf '%s' "$aout" | _json_field error)
        unset key
        die "${e:-$aout}"
    fi
    local by; by=$(printf '%s' "$aout" | _json_field approved_by)
    local out rc=0
    out=$(printf '%s\n' "$key" | "$SET_SECRET_SH" --stdin 2>&1) || rc=$?
    unset key
    logger -t agenti "API_KEY_SET | by=$by | via=api | sha256=${sha:0:12} | rc=$rc" 2>/dev/null || true
    [[ $rc -eq 0 ]] || die "the key was not saved: $(printf '%s' "$out" | grep -i 'error' | tail -n 2 | tr '\n' ' ')"
    if [[ $JSON -eq 1 ]]; then
        python3 -c 'import json,sys; print(json.dumps({"ok": True, "api_key": "set", "approved_by": sys.argv[1]}))' "$by"
    else
        ok "API key saved (approved by $by)"
    fi
}

# `agenti setup`: first run, one question at a time. Re-runnable: every step
# says when it is already done and skips. Each step is an existing verb, run
# through this same CLI, so setup holds no logic of its own.
setup_usage() {
    cat <<'EOF'
usage: sudo agenti setup

First-run setup, one question at a time. Run it again any time: each step
says when it is already done and is skipped.
  1. the first admin: a password and a two-factor code (to sign in to the GUI)
  2. optional: the vault, an encrypted data folder (default: no); asked
     before the key, so a key is stored inside it from the start
  3. the Anthropic API key (asked silently; never on the command line)
  4. optional: opening the GUI from other computers
EOF
}

cmd_setup() {
    local self; self=$(readlink -f "${BASH_SOURCE[0]}")
    [[ -t 0 ]] || die "setup asks questions, so it needs a terminal. Run it yourself:  sudo agenti setup"
    local reply name n
    printf '\n%sAgenti setup%s\n' "$c_b" "$c_0"

    printf '\n%s1. The first admin%s\n' "$c_b" "$c_0"
    # Who can sign in already, and is there an admin an earlier setup left
    # half-made (created, then the password was refused)? Found on a fresh
    # Kali install 2026-10-26: 'kali' (4 characters) was refused after the
    # account existed, and the next setup skipped it as "already exists".
    local users ready half pw pw2
    users=$(python3 "$IAM_PY" --json user list 2>/dev/null || echo '[]')
    read -r ready half < <(python3 -c '
import json, sys
u = [x for x in json.load(sys.stdin) if x.get("active") and x.get("role") == "admin"]
ready = sum(1 for x in u if x.get("has_password") or x.get("has_passkey"))
half = next((x["name"] for x in u if not x.get("has_password") and not x.get("has_passkey")), "-")
print(ready, half)' <<<"$users" 2>/dev/null || echo "0 -")
    if [[ "${ready:-0}" -gt 0 ]]; then
        ok "an admin who can sign in already exists — skipped (add people in the GUI: Settings → Users)"
    else
        if [[ -n "$half" && "$half" != "-" ]]; then
            name="$half"
            echo "  '$name' was created by an earlier setup but has no password yet — finishing it."
        else
            local def="${SUDO_USER:-admin}"; [[ "$def" == root ]] && def=admin
            read -r -p "  name to sign in with [$def]: " name; name="${name:-$def}"
        fi
        # The password is checked BEFORE anything is created, and asked again
        # if it is refused, so a refusal never leaves a half-made account.
        while true; do
            read -rs -p "  choose a password (at least 8 characters, not shown): " pw; echo
            if [[ ${#pw} -lt 8 ]]; then warn "that is ${#pw} characters; it needs at least 8 — try again"; continue; fi
            read -rs -p "  type it again: " pw2; echo
            [[ "$pw" == "$pw2" ]] && break
            warn "the two did not match — try again"
        done
        if [[ "$name" != "$half" ]]; then
            "$self" admin user add "$name" || { unset pw pw2; die "'$name' was not created (see above); nothing was changed. Run setup again:  sudo agenti setup"; }
            "$self" admin bind user "$name" --role admin
        fi
        printf '%s\n' "$pw" | "$self" admin user set-password "$name" --password-stdin \
            || { unset pw pw2; die "the password was not set. Finish it:  sudo agenti admin user set-password $name"; }
        unset pw pw2
        echo "  now scan this with an authenticator app (Google Authenticator, 1Password, ...):"
        "$self" admin user enroll-2fa "$name" \
            || warn "2FA was not set up yet. Do it now:  sudo agenti admin user enroll-2fa $name"
        ok "'$name' is an admin. If the code does not work, re-run:  sudo agenti admin user enroll-2fa $name"
    fi
    # An admin can sign in now: the browser's setup code has no more use.
    python3 "$IAM_PY" --actor "$(invoking_user)" setup-code --clear >/dev/null 2>&1 || true

    # Before the key, so a key is written straight into the vault, never to the bare disk.
    printf '\n%s2. The vault (optional)%s\n' "$c_b" "$c_0"
    if agenti_vault_enabled; then
        ok "the vault is on — skipped (status: sudo agenti vault status)"
    else
        cat <<'EOF'
  The vault keeps reports, scan data and API keys in an encrypted container.
  It protects a machine that is stolen while switched off, if this machine
  has no full-disk encryption (Kali's installer offers that instead, and it
  is the better choice where you have it). The cost: after EVERY reboot
  someone must type the passphrase (sudo agenti vault unlock) before anyone
  can run an agent.
EOF
        read -r -p "  turn the vault on? [y/N] " reply
        if [[ "$reply" =~ ^[Yy]$ ]]; then "$VAULT_SH" enable || warn "the vault was not turned on"
        else ok "the vault stays off (turn it on later: sudo agenti vault enable)"; fi
    fi
    if ! agenti_vault_enabled && python3 "$LIBDIR/disk_encryption.py" "$AGENTI_ROOT" 2>/dev/null \
            | grep -q '"encrypted": false'; then
        warn "Data from agents is currently not encrypted (no vault and no full-disk encryption).
  Agents still run, and the dashboard will say so until you turn the vault on:
  Settings → Platform → Vault, or sudo agenti vault enable"
    fi

    printf '\n%s3. The Anthropic API key%s\n' "$c_b" "$c_0"
    if agenti_vault_enabled && ! agenti_data_ready; then
        warn "the vault is locked — unlock it first (sudo agenti vault unlock), then re-run setup"
    elif grep -qs '^ANTHROPIC_API_KEY=.' "$AGENTI_ROOT/shared/secrets.env"; then
        ok "a key is already set — skipped (replace it:  sudo $SET_SECRET_SH)"
    else
        echo "  Every agent run uses it. Get one at https://console.anthropic.com/ (it starts sk-ant-)."
        read -r -p "  set it now? [Y/n] " reply
        if [[ "$reply" =~ ^[Nn] ]]; then
            ok "skipped — agent runs will refuse to start until a key is set. Later:  sudo agenti setup"
        else
            "$SET_SECRET_SH" || warn "no key was saved; set it later:  sudo agenti setup"
        fi
    fi

    printf '\n%s4. Opening the GUI%s\n' "$c_b" "$c_0"
    cat <<'EOF'
  How will people open the GUI?
    1) only on this machine (as it is now)
    2) from other computers on this network (a self-signed certificate)
    3) from anywhere, through a tunnel or proxy on this machine (Cloudflare
       Tunnel, nginx, Caddy) — recommended for remote access
EOF
    read -r -p "  choose 1, 2 or 3 [1]: " reply
    case "${reply:-1}" in
        1) ok "the GUI stays on this machine only" ;;
        2) local ip; ip=$(hostname -I 2>/dev/null | awk '{print $1}')
           read -r -p "  this machine's address on that network [${ip:-?}]: " reply; ip="${reply:-$ip}"
           [[ -n "$ip" ]] || die "no address given; nothing changed"
           "$LIBDIR/configure.sh" gui --bind "$ip" --tls ;;
        3) read -r -p "  the public domain people will use (e.g. agenti.example.com): " reply
           [[ -n "$reply" ]] || die "no domain given; nothing changed"
           "$LIBDIR/configure.sh" gui --behind-proxy --hostname "$reply"
           echo "  Then point the tunnel or proxy at http://127.0.0.1:8420 (agenti docs has the steps)." ;;
        *) warn "not 1, 2 or 3 — the GUI stays as it is (change it later: sudo agenti gui configure --help)" ;;
    esac

    printf '\n%sDone.%s\n' "$c_b" "$c_0"
    echo "  To remove Agenti later:  sudo apt purge agenti agenti-runtime  (it asks before deleting any data)"
    "$self" gui status 2>/dev/null | sed -n '1,4p' || true
    cat <<'EOF'

  Next, in the GUI:
    - Settings → Engagement: the client, the scope (addresses or domains) and
      the dates, then approve it
    - Launch: pick an agent, a target inside the scope and a model
  Check this machine any time:  sudo agenti verify
EOF
}

gui_refuse_api() {
    local verb="$1" api_user="${AGENTI_API_USER:-agenti-api}"
    [[ "$(invoking_user)" == "$api_user" ]] || return 0
    die "REFUSING: '$api_user' may not run 'gui $verb'.
Starting, stopping or reconfiguring the GUI's own services, or reading their
logs, is an operator action. Reached through the API, a stop or restart would
take down the very process serving the request.
Run it as yourself:  sudo agenti gui $verb"
}

# Is anything but systemd (which holds it) or the GUI itself listening on the
# GUI's port? Prints the intruder's ss line, if any. After a stop the port is
# free, and a local process that took it would be handed every browser that
# comes back (audit run 2).
gui_port_intruder() {
    local port; port=$(sed -n 's/^BIND_PORT=//p' "$AGENTI_API_CONF" 2>/dev/null | head -n1)
    [[ -n "$port" ]] || port=8420
    local main; main=$(systemctl show -p MainPID --value agenti-api.service 2>/dev/null || echo 0)
    local line pid bad
    while IFS= read -r line; do
        bad=1
        for pid in $(grep -oE 'pid=[0-9]+' <<<"$line" | cut -d= -f2); do
            [[ "$pid" == 1 || "$pid" == "$main" ]] && bad=0
        done
        [[ $bad -eq 1 ]] && printf '%s\n' "$line"
    done < <(ss -ltnpH "sport = :$port" 2>/dev/null)
    return 0
}

gui_change() {
    local verb="$1" u
    need_root
    gui_refuse_api "$verb"
    case "$verb" in
        start|restart|enable)
            local intruder; intruder=$(gui_port_intruder)
            [[ -z "$intruder" ]] || die "REFUSING to start the GUI: another program holds its port, and it would receive
every browser that connects (and their sign-in):
  $intruder
Find and stop it (the pid is in the line above), then: sudo agenti gui $verb"
            local -a cmd=("$verb") units=("${GUI_UNITS[@]}")
            [[ "$verb" == enable ]] && cmd=(enable --now)
            # restart leaves the port's socket alone: re-binding it is the gap a
            # local process could use to take the port (audit run 1, F09).
            [[ "$verb" == restart ]] && units=(agenti-authd.service agenti-api.service)
            # A unit that crashed earlier stays "failed" and can refuse a plain
            # start until this is cleared.
            systemctl reset-failed "${GUI_UNITS[@]}" 2>/dev/null || true
            systemctl "${cmd[@]}" "${units[@]}" \
                || die "systemctl ${cmd[*]} failed for the GUI's services.
see why:  sudo agenti gui logs -n 60"
            # Type=exec returns once the process is launched, not once it is
            # serving — a bad certificate or a taken port kills it a moment later.
            sleep 2
            for u in "${GUI_UNITS[@]}"; do
                systemctl is-active --quiet "$u" || die "${u%.service} did not stay running after '$verb'.
see why:  sudo agenti gui logs -n 60"
            done ;;
        stop)
            systemctl stop agenti-api.service agenti-api.socket agenti-authd.service \
                || die "systemctl stop failed for the GUI's services.
see why:  sudo agenti gui logs -n 60"
            # The port is free now: no session may outlive the stop.
            local n; n=$(python3 -c 'import iam; rt = iam.open_runtime(); print(iam.revoke_all_sessions(rt)); rt.close()' 2>/dev/null) \
                || warn "could not sign everyone out (runtime.db); sessions end at their own expiry"
            [[ -z "${n:-}" || $JSON -eq 1 ]] || note '  signed out %s session(s): everyone signs in again after the next start\n' "$n" ;;
        disable)
            systemctl disable "${GUI_UNITS[@]}" \
                || die "systemctl disable failed for the GUI's services." ;;
    esac
    gui_show "$verb"
}

gui_logs() {
    need_root
    gui_refuse_api logs
    [[ $JSON -eq 0 ]] || die "gui logs has no --json form; drop --json to read the journal."
    local n=100
    local -a follow=()
    # Only these two options: anything else passed through to journalctl
    # would run as root, and journalctl has options that delete journal files.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow) follow=(-f); shift ;;
            -n)
                [[ $# -ge 2 ]] || die "-n needs a value, e.g. -n 50"
                require_int "$2" "-n"; n="$2"; shift 2 ;;
            *) die "unknown option for gui logs: $1
usage: sudo agenti gui logs [-f] [-n N]" ;;
        esac
    done
    exec journalctl -u agenti-authd.service -u agenti-api.service -n "$n" --no-pager "${follow[@]}"
}

cmd_gui() {
    local verb="${1:-status}"
    [[ $# -gt 0 ]] && shift
    case "$verb" in help|--help|-h) gui_usage; return 0 ;; esac
    [[ -f "$GUI_API_UNIT_FILE" ]] || die "the web GUI is not installed on this box ($GUI_API_UNIT_FILE is missing).
reinstall it:  $REINSTALL"
    case "$verb" in
        status)
            [[ $# -eq 0 ]] || die "usage: agenti gui status [--json]"
            gui_show "" ;;
        start|stop|restart|enable|disable)
            [[ $# -eq 0 ]] || die "usage: sudo agenti gui $verb   ('$1' is not an option for it)"
            gui_change "$verb" ;;
        logs) gui_logs "$@" ;;
        configure)
            need_root; gui_refuse_api configure
            [[ -x "$LIBDIR/configure.sh" ]] || die "configure.sh is missing.
reinstall it:  $REINSTALL"
            exec "$LIBDIR/configure.sh" gui "$@" ;;
        *) die "unknown gui verb '$verb'.
gui verbs: status | enable | disable | start | stop | restart | logs | configure
details:   agenti gui help" ;;
    esac
}

# The API's service account holds a sudoers grant for this binary with a BARE
# PATH, which per sudoers(5) permits ANY arguments. File permissions on iam.db
# (0640 root:agenti-api) therefore stop the API writing identity data DIRECTLY,
# but they do not stop it writing MEDIATED — `sudo agenti admin issue-key ...`
# runs as root and would sail straight through.
#
# That gap is closed here, at the only place that can see who is asking. A
# compromised API process must not be able to mint itself a key, bind itself a
# role, or create a user; those are exactly the operations that would turn
# a web-tier compromise into a permanent one.
#
# $SUDO_USER is trustworthy for this: sudo sets it from the real invoking uid
# after env_reset discards the caller's environment, so it cannot be forged by
# whoever ran the command.
#
# Read-only IAM verbs are deliberately still allowed — the API can already read
# iam.db directly, so refusing them would buy nothing and cost debuggability.
#
# "self" is deliberately NOT in this list — see the comment on that verb in
# iam.py's argparse setup. It is a narrow exception, and it is an exception
# by ABSENCE from this list rather than a hole punched into it: the safety
# comes from every "self" subcommand re-proving the caller's current
# password (and current 2FA code, if enrolled) before touching anything, via
# iam.reauthenticate_self() — the API can invoke the verb, but it cannot
# forge what only the real human holds.
#
# "revoke-key" was REMOVED from this list (2026-09-21, GUI phase 2): unlike
# every other verb here, it only ever REMOVES authority — a revoked key
# stays revoked, and the worst a compromised API achieves by calling it is
# invalidating a credential, which is loud and trivially reissued by root.
# It is a standalone top-level verb (not a subcommand of "user" or
# "group"), so removing it does not touch anything else's refusal.
#
# create-user / disable-user / remove-group-member /
# mint-enrolment-link / enrol-check / enrol-consume are likewise NOT here,
# on purpose, as their own top-level verbs rather than exposed subcommands
# of "user"/"group" (which stay fully refused) — each does exactly one
# thing chosen because it can only remove authority or grant none at all.
# See their own --help text (or CLAUDE.md's "authority rule") for the
# per-verb reasoning. Whoever greps THIS list to audit what the API may
# mutate sees every one of these omissions and can go read why.
# "user" is the current spelling of "principal" (2026-10-19); the old one stays
# in the list for as long as iam.py accepts it -- a refusal list that forgot an
# alias would be a hole, not a typo.
IAM_WRITE_VERBS="user principal bind unbind issue-key bootstrap set-policy setup-code"

refuse_iam_writes_from_api() {
    local verb="$1" api_user="${AGENTI_API_USER:-agenti-api}"
    [[ "$(invoking_user)" == "$api_user" ]] || return 0
    [[ " $IAM_WRITE_VERBS " == *" $verb "* ]] || return 0
    die "REFUSING: '$api_user' may not run 'admin $verb'.

The API service account can invoke this CLI (that is how every API request
reaches the runtime), but identity and access changes are root-operator-only.
Allowing them here would mean a compromised API process could mint itself a
key or grant itself a role, which is precisely what the read-only iam.db
permission exists to prevent.

Run this as yourself instead:
  sudo agenti admin $verb ..."
}

# retention-sweep (CLAUDE.md "Current plan", decision 7 of the generic-
# launcher arc): "task history and run working data auto-delete after 30
# days ... regardless of agent." Not identity-related — nothing here touches
# iam.db — so it is a plain admin verb, not forwarded to iam.py, and there
# is deliberately NO API route for it: this is a maintenance action run by
# root (by hand, or by the retention timer the package installs), the same
# posture as vault unlock/lock never being reachable over HTTP.
# update-check: "is a newer release out?" — report-only, OFF by default (the
# `update-check` platform policy, set by root with `set-policy`; the API can
# read it, never set it). Read-only, so it is not in IAM_WRITE_VERBS, and it
# installs nothing: the answer names the command the admin runs themselves.
# With the policy off, update_check.py makes no network request at all.
cmd_update_check() {
    local uc="$LIBDIR/update_check.py"
    [[ -f "$uc" ]] || uc="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/update_check.py"
    [[ -f "$uc" ]] || die "update_check.py is missing, so update checking is unavailable.
reinstall it:  $REINSTALL"
    local enabled=off
    if [[ -f "$IAM_PY" ]]; then
        enabled=$(python3 "$IAM_PY" --json policy 2>/dev/null | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("update-check","off"))
except Exception:
    print("off")' 2>/dev/null) || enabled=off
    fi
    local args=()
    [[ "$enabled" == "on" ]] && args+=(--enabled)
    [[ $JSON -eq 1 ]] && args+=(--json)
    local rc=0
    python3 "$uc" "${args[@]}" || rc=$?
    return $rc
}

cmd_retention_sweep() {
    local dry_run=0 days=30 only_agent=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=1; shift ;;
            --days)    [[ $# -ge 2 ]] || die "--days needs a value, e.g. --days 30"
                       days="$2"; require_int "$days" "--days"; shift 2 ;;
            --agent)   [[ $# -ge 2 ]] || die "--agent needs a value"
                       only_agent="$2"; shift 2 ;;
            *)         die "unknown option for retention-sweep: $1
usage: sudo agenti admin retention-sweep [--dry-run] [--days N] [--agent A]" ;;
        esac
    done
    require_data

    local dirs=() agent
    for agent in $(list_agents); do
        [[ -n "$only_agent" && "$agent" != "$only_agent" ]] && continue
        # Every user's run slot of this agent.
        local base slot; base=$(agent_base_dir "$agent")
        for slot in "$base/instances"/*/; do
            [[ -d "$slot" ]] && dirs+=("$agent/$(basename "$slot"):${slot%/}")
        done
    done
    if [[ ${#dirs[@]} -eq 0 ]]; then
        [[ $JSON -eq 1 ]] && printf '{"dry_run":%s,"retention_days":%s,"agents":[]}\n' \
            "$([[ $dry_run -eq 1 ]] && echo true || echo false)" "$days"
        [[ $JSON -eq 1 ]] || echo "  (no matching agent to sweep)"
        return 0
    fi
    python3 - "$days" "$dry_run" "$JSON" "$(lib_dir)" "${dirs[@]}" <<'PY'
import json, sys
from pathlib import Path

days, dry_run, as_json = int(sys.argv[1]), sys.argv[2] == "1", sys.argv[3] == "1"
libdir = sys.argv[4]
entries = sys.argv[5:]
results = []
totals = {"files_removed": 0, "bytes_freed": 0, "history_pruned": 0}
sys.path.insert(0, libdir)
try:
    import retention
except Exception as e:
    print(json.dumps({"error": f"could not load retention.py from {libdir} ({e}) — "
                                 f"reinstall: sudo apt install --reinstall agenti"}))
    sys.exit(1)
for entry in entries:
    agent, agent_dir = entry.split(":", 1)
    agent_dir = Path(agent_dir)
    try:
        r = retention.sweep_agent(agent_dir, retention_days=days, dry_run=dry_run)
    except Exception as e:      # one bad slot never stops the others (audit run 1, F37)
        results.append({"agent": agent, "error": f"skipped: {e}"})
        continue
    files_removed = len(r["working_data"]["removed_files"])
    bytes_freed = r["working_data"]["bytes_freed"]
    history_pruned = sum(p.get("pruned", 0) for p in r["history"].values())
    totals["files_removed"] += files_removed
    totals["bytes_freed"] += bytes_freed
    totals["history_pruned"] += history_pruned
    results.append({"agent": agent, "files_removed": files_removed,
                    "bytes_freed": bytes_freed, "history_pruned": history_pruned})
out = {"dry_run": dry_run, "retention_days": days, "totals": totals, "agents": results}
if as_json:
    print(json.dumps(out))
else:
    label = "WOULD remove" if dry_run else "removed"
    print(f"retention sweep ({days} days){' [dry run]' if dry_run else ''}:")
    for r in results:
        if "error" in r:
            print(f"  {r['agent']}: {r['error']}")
        else:
            print(f"  {r['agent']}: {label} {r['files_removed']} file(s) "
                  f"({r['bytes_freed']:,} bytes), pruned {r['history_pruned']} "
                  f"history entry/entries")
    print(f"total: {label} {totals['files_removed']} file(s) "
          f"({totals['bytes_freed']:,} bytes), pruned {totals['history_pruned']} "
          f"history entry/entries")
PY
}

cmd_admin() {
    # Same dispatch-before-the-generic-usage reasoning as `new --help`: iam.py's
    # argparse help documents a dozen subcommands and the resource grammar,
    # which is far more useful here than this script's usage() banner.
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        [[ -f "$IAM_PY" ]] || die "$IAM_PY is missing.
reinstall it:  $REINSTALL"
        exec python3 "$IAM_PY" --help
    fi
    case "${1:-}" in
        set-user-key) shift; cmd_set_user_key "$@"; return ;;
        set-api-key) shift; cmd_set_api_key_web "$@"; return ;;
        context)
            # The instruction files (shared/context_store.py). Root terminal
            # only for now: the GUI path (phase 4) adds its own re-auth.
            [[ "$(invoking_user)" != "${AGENTI_API_USER:-agenti-api}" ]] \
                || die "REFUSING: instruction files are not editable through the API yet."
            ensure_vault
            local cs; cs=$(context_store_py) || die "context_store.py is missing.
reinstall it:  $REINSTALL"
