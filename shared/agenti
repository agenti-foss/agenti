#!/usr/bin/env bash
#
# agenti — control surface for the scoped AI agents (docs/packaging.md § Layout).
#
#   agenti <agent> <verb> [flags]             operate one agent
#   agenti agents [--json]                    deployed agents (no root needed)
#   agenti vault <verb>                       the encrypted volume
#   agenti gui <verb>                         the web GUI's services
#
# DESIGN: this is a THIN WRAPPER. Every command shells out to systemctl,
# vault.sh, journalctl, or reads a file. It contains NO security logic of its
# own — the narrowing rule, the preflight gates and the root-owned per-run
# inputs all live where they already were. The CLI only saves you typing.
#
# WHY IT NEEDS ROOT: run-target and run-config.json are root-owned precisely so
# the agent cannot set its own target or raise its own budget. Writing them, and
# starting a system service, therefore needs root. Run the whole command under
# sudo — the script never invokes sudo behind your back.
#
# ONE ORGANISATION: everything lives under <vault>/org — the engagement, each
# agent's runs (org/<agent>/instances/<user>), teams and kept outputs. Every
# run is some user's own (private to them); users share one Linux service
# account, so the kernel-level separation between them is the slot unit's
# own TemporaryFileSystem (agenti-instance@.service), not file permissions.
#
set -euo pipefail
# Every `python3 -c` helper below would otherwise put the CALLER'S working
# directory first on its import path, so a json.py planted where root runs
# `sudo agenti` would run as root (audit run 1, F14). Python 3.11+ honours this.
# It also stops a script's own folder being added, so PYTHONPATH is set to the
# code folder below, once it is known (root-owned, read-only).
export PYTHONSAFEPATH=1

LIBDIR="${AGENTI_LIBDIR:-/usr/lib/agenti}"
# The path table (data root, runtime, settings): the installed copy, else the
# one beside this script when it runs from a source checkout.
_paths_sh="$LIBDIR/paths.sh"
[[ -f "$_paths_sh" ]] || _paths_sh="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/paths.sh"
[[ -f "$_paths_sh" ]] || { printf 'error: paths.sh is missing from %s.\nreinstall:  sudo apt install --reinstall agenti\n' "$LIBDIR" >&2; exit 1; }
# shellcheck source=paths.sh
source "$_paths_sh"
# The helpers import one another; with PYTHONSAFEPATH their own folder is no
# longer added for them, so name it: the code folder (or the checkout's
# shared/ when running from source) and nothing the caller chose.
PYTHONPATH="$(dirname "$(readlink -f "$_paths_sh")")"
export PYTHONPATH
# The fix for a missing installed file, named once.
REINSTALL="sudo apt install --reinstall agenti   (from a source checkout: sudo ./shared/deploy.sh)"
VAULT_SH="$LIBDIR/vault.sh"
SET_SECRET_SH="$LIBDIR/set-secret.sh"
# From a source checkout (nothing installed yet), the copies beside this script.
_here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
[[ -f "$VAULT_SH" ]] || VAULT_SH="$_here/vault.sh"
[[ -f "$SET_SECRET_SH" ]] || SET_SECRET_SH="$_here/set-secret.sh"
IAM_PY="$LIBDIR/iam.py"

DRY_RUN=0
JSON=0
HELP=0          # --help anywhere: help_for prints that verb's part of usage()
# Runs are private to the user who launched them (CLAUDE.md §4 item 71):
# every run lives in its OWNER's own slot, org/<agent>/instances/<slot>,
# where <slot> is "<owner>.<copy>": EVERY start gets a fresh slot (a generated
# label unless --copy pins one), so two runs of an agent never share anything.
# A bare "<owner>" slot is only where `attach` stages files for the next start.
# --owner defaults to whoever is running this command; the API always passes
# it (and is refused without it), so a caller can only ever NAME their own
# slot. SLOT is resolved once, after the agent is known, and
# agent_dir()/unit() read it — which is what makes every per-run verb
# owner-scoped without each one parsing anything.
OWNER=""
COPY=""
SLOT=""

c_r=$'\e[31m'; c_g=$'\e[32m'; c_y=$'\e[33m'; c_d=$'\e[2m'; c_b=$'\e[1m'; c_0=$'\e[0m'
[[ -t 1 ]] || { c_r=; c_g=; c_y=; c_d=; c_b=; c_0=; }

ok()   { printf '  %s✓%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '  %s!%s %s\n' "$c_y" "$c_0" "$*"; }
# Under --json, an error is still a single JSON object on stdout (not a second
# stream a caller has to also watch) — the exit code is what signals failure.
die()  {
    if [[ $JSON -eq 1 ]]; then
        printf '{"error":%s}\n' "$(json_str "$*")"
    else
        printf '\n%serror:%s %s\n' "$c_r" "$c_0" "$*" >&2
    fi
    exit 1
}

# Human-readable chatter that is NOT the verb's actual result: --dry-run plan
# lines, the "vault is locked — unlocking" notice, and the like.
#
# Under --json, stdout must carry EXACTLY ONE JSON document — CLAUDE.md §3a's
# "a caller only ever watches one stream" — so this goes to stderr instead,
# where a human running the command by hand still sees it perfectly well.
# Without this, `start --dry-run --json` emitted its plan lines AND its result
# object onto the same stream and no caller could parse either.
#
# Found by driving the real CLI from the API rather than by reading it: the
# --json contract had only ever been exercised on non-dry-run paths.
note() {
    if [[ $JSON -eq 1 ]]; then printf "$@" >&2; else printf "$@"; fi
}

# Every side-effecting call goes through here, so --dry-run is trustworthy
# rather than best-effort.
run() {
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ %s%s\n' "$c_d" "$*" "$c_0"
        return 0
    fi
    "$@"
}

need_root() { [[ $EUID -eq 0 ]] || die "this needs root. Try: sudo agenti $ORIG_ARGS"; }

# The ONE service account every agent runs as (created by vault.sh). Kept
# identical in vault.sh, configure.sh, set-secret.sh and here — small enough that
# duplicating the literal beats a shared-bash mechanism this codebase doesn't
# otherwise have.
SVC_USER="agenti-run"

# engagement_store.py — the root-side reader/writer for the organisation's engagement
# record (CLAUDE.md "Current plan", phase 1). Same two-tier resolution
# cmd_tools/cmd_engagement already use for gen_capabilities.py/
# engagement_store.py: $LIBDIR is the real, installed copy in production; the
# source-tree fallback is what makes this runnable from a dev checkout too.
engagement_store_py() {
    if [[ -x "$LIBDIR/engagement_store.py" ]]; then printf '%s' "$LIBDIR/engagement_store.py"
    elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/engagement_store.py" ]]; then
        printf '%s' "$(dirname "${BASH_SOURCE[0]}")/engagement_store.py"
    else return 1; fi
}

# context_store.py — the instruction files (system-prompt/skills/org/
# memory) and the per-run snapshot of them. Same resolution as above.
context_store_py() {
    if [[ -x "$LIBDIR/context_store.py" ]]; then printf '%s' "$LIBDIR/context_store.py"
    elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/context_store.py" ]]; then
        printf '%s' "$(dirname "${BASH_SOURCE[0]}")/context_store.py"
    else return 1; fi
}

# tool_settings_store.py — an admin's per-agent override of a shell
# agent's allow-list (CLAUDE.md "Current plan" phase 6). Same resolution.
tool_settings_store_py() {
    if [[ -x "$LIBDIR/tool_settings_store.py" ]]; then printf '%s' "$LIBDIR/tool_settings_store.py"
    elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/tool_settings_store.py" ]]; then
        printf '%s' "$(dirname "${BASH_SOURCE[0]}")/tool_settings_store.py"
    else return 1; fi
}

# tool_approvals.py — an agent's request to use one catalog program for a run,
# and the operator's decision (phase 7). Same resolution.
tool_approvals_py() {
    if [[ -x "$LIBDIR/tool_approvals.py" ]]; then printf '%s' "$LIBDIR/tool_approvals.py"
    elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/tool_approvals.py" ]]; then
        printf '%s' "$(dirname "${BASH_SOURCE[0]}")/tool_approvals.py"
    else return 1; fi
}

# catalog_admin.py — the command-line programs an admin may offer agents.
catalog_admin_py() {
    if [[ -x "$LIBDIR/catalog_admin.py" ]]; then printf '%s' "$LIBDIR/catalog_admin.py"
    elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/catalog_admin.py" ]]; then
        printf '%s' "$(dirname "${BASH_SOURCE[0]}")/catalog_admin.py"
    else return 1; fi
}

# agent_builder.py — builds/removes a whole agent type from a short spec
# (Settings -> Agents -> Build an agent). Same resolution as above.
agent_builder_py() {
    if [[ -x "$LIBDIR/agent_builder.py" ]]; then printf '%s' "$LIBDIR/agent_builder.py"
    elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/agent_builder.py" ]]; then
        printf '%s' "$(dirname "${BASH_SOURCE[0]}")/agent_builder.py"
    else return 1; fi
}

# Write this run's read-only snapshot of its instruction files into the slot
# (run-context/). Refuses — and so refuses the start — when the agent has no
# system prompt.
snapshot_run_context() {
    local agent="$1" dir="$2"
    local cs; cs=$(context_store_py) || die "context_store.py is missing.
reinstall it:  $REINSTALL"
    local out rc=0
    out=$(python3 "$cs" --root "$AGENTI_ROOT" snapshot --agent "$agent" \
        --owner "$OWNER" --dest "$dir" --group "$SVC_USER" 2>&1) || rc=$?
    if [[ $rc -ne 0 ]]; then
        local err; err=$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error",""))
except Exception: print("")' 2>/dev/null)
        die "${err:-could not snapshot the instruction files: $out}"
    fi
}

# Data can be used: no vault, or the vault is unlocked (paths.sh).
data_ready()    { agenti_data_ready; }
# off | unlocked | locked — the "vault" field every --json status carries.
vault_state() {
    if ! agenti_vault_enabled; then printf off
    elif agenti_data_ready; then printf unlocked
    else printf locked; fi
}
org_dir()       { printf '%s/org' "$AGENTI_ROOT"; }
# agent_dir() is THIS run slot's directory — runtime state only (run-target,
# state/, scans/, reports/, …), never code: org/<agent>/instances/$SLOT.
# agent_base_dir() is the per-agent parent holding instances/. master_dir()
# is the ONE shared copy of the agent's code; lib_dir() the harness.
agent_base_dir() { printf '%s/org/%s' "$AGENTI_ROOT" "$1"; }
agent_dir() {
    [[ -n "$SLOT" ]] || die "internal error: no run slot resolved for '$1'"
    printf '%s/org/%s/instances/%s' "$AGENTI_ROOT" "$1" "$SLOT"
}
master_dir()    { agenti_master_dir "$1"; }
lib_dir()       { printf '%s' "$LIBDIR"; }
# agent_dir()/master_dir() are naive string concatenation, and require_agent
# only checks `[[ -d ... ]]` — bash resolves `..` in that test exactly like any
# other path lookup. Without this, an agent name of `../../../etc/cron.d`
# would make every root-owned file cmd_start writes (run-target,
# run-config.json, run-launched-by, run-launched-via) land outside the vault
# entirely. shared/api/cli_bridge.py has always rejected this shape for HTTP
# callers (NAME_RE + RESERVED_NAMES); this CLI, which every sudoers grant in
# this project points at directly, must too (CLAUDE.md §4 item 15).
valid_name() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]]
}

# A non-numeric -n value used to reach `tail -n` or Python's int() unvalidated
# — the caller got either a raw GNU-tail/traceback error or, at worst
# (cmd_inbox), an uncaught Python exception instead of this project's own
# die()-style message. Found in the 2026-09-20 security audit (CLAUDE.md §4
# item 15) alongside the traversal issues above — same root cause (a value
# reaches something sensitive before this script validates it), lower
# severity (denial-of-service against your own read of your own data, not a
# privilege boundary).
require_int() {
    [[ "$1" =~ ^[0-9]+$ ]] || die "$2 must be a positive whole number, got '$1'."
}
# One unit per run slot, from the per-agent template configure.sh renders
# (agenti-<agent>-instance@.service, %i = the slot).
unit() { printf 'agenti-%s-instance@%s.service' "$1" "$SLOT"; }
run_active()    { systemctl is-active --quiet "$(unit "$1")" 2>/dev/null; }

# Lists every agent INSTALLED: shipped with the package ($LIBDIR/agents/) or
# built in Settings (the data root's shared/agents/). Every installed agent is
# available to every user.
list_agents() {
    local d n
    for d in "$AGENTI_SHIPPED_AGENTS"/*/ "$AGENTI_BUILT_AGENTS"/*/; do
        [[ -d "$d" ]] || continue
        n=$(basename "$d")
        # A real master copy has its own <name>-agent.py — keeps a stray or
        # half-removed directory out of the list.
        [[ -f "$d/$n-agent.py" ]] || continue
        printf '%s\n' "$n"
    done | sort -u
}

# The data root is usable. With the vault on and locked, nothing is visible.
require_data() {
    if agenti_vault_enabled && ! agenti_data_ready; then
        die "the vault is locked, so no data is visible.
unlock it:  sudo agenti vault unlock"
    fi
    [[ -d "$AGENTI_ROOT" ]] || die "the data folder $AGENTI_ROOT does not exist.
recreate it:  sudo dpkg-reconfigure agenti"
}

require_org() {
    require_data
    [[ -d "$(org_dir)" ]] || die "the organisation directory $(org_dir) does not exist.
recreate it:  sudo dpkg-reconfigure agenti"
}

# Provisioning, in two layers. ensure_base_provisioned() is the per-agent
# parent (root:<service account> 0750) and its instances/ directory —
# idempotent, silent (callers may be under --json), and run for every verb
# that names an agent. ensure_slot_provisioned() is ONE user's run slot and
# its systemd unit, created only when that user actually starts something, so
# a read never leaves an empty slot behind.
ensure_base_provisioned() {
    local agent="$1" base
    base=$(agent_base_dir "$agent")
    [[ -d "$base/instances" ]] && return 0
    install -d -o root -g "$SVC_USER" -m 0750 "$base" "$base/instances"
    # Backstop for the capability drop-in: the primary render is configure.sh
    # (install, upgrade, dpkg-reconfigure). In a subshell with output discarded, so a bad .capabilities
    # file can never abort an ordinary verb.
    if [[ -x "$LIBDIR/capability-dropin.sh" ]]; then
        local capf; capf="$(master_dir "$agent")/${agent}.capabilities"
        [[ -f "$capf" ]] || capf=""
        ( source "$LIBDIR/capability-dropin.sh"; render_capability_dropin "$agent" "$capf" ) \
            >/dev/null 2>&1 || true
    fi
}

# The slot's unit template, rendered on demand (configure.sh normally renders
# it already). Content-compared, so a template change propagates.
ensure_slot_unit() {
    local agent="$1"
    local src="$LIBDIR/agenti-instance@.service"
    [[ -f "$src" ]] || die "the run-slot unit template is not installed at $src.
reinstall it:  $REINSTALL"
    _unit_lib render_slot_template "$agent" "$SVC_USER" "$src" >/dev/null \
        || die "could not render the run-slot unit for '$agent' from $src."
}

ensure_slot_provisioned() {
    local agent="$1"
    ensure_base_provisioned "$agent"
    ensure_slot_unit "$agent"
    local dir; dir=$(agent_dir "$agent")
    local already_existed=0
    [[ -d "$dir" ]] && already_existed=1
    install -d -o root -g "$SVC_USER" -m 0750 "$dir"
    local d
    for d in reports state .claude scans analysis loot msf-logs; do
        install -d -o "$SVC_USER" -g "$SVC_USER" -m 0700 "$dir/$d"
    done
    # Exploit's approval queue: agent-written (pending proposals) and
    # root-written (operator decisions, via action-approve/action-reject).
    # Existence-checked rather than always `install`ed from /dev/null — unlike
    # the directories above, re-touching an existing file here would TRUNCATE
    # a live approval history.
    [[ -e "$dir/pending-actions.jsonl" ]] || \
        install -o "$SVC_USER" -g "$SVC_USER" -m 0640 /dev/null "$dir/pending-actions.jsonl"
    [[ -e "$dir/action-approvals.jsonl" ]] || \
        install -o root -g "$SVC_USER" -m 0640 /dev/null "$dir/action-approvals.jsonl"
    # Below this line: one-time only. An already-provisioned slot's audit log
    # and run-* marker files hold live data (or are root-owned, agent-written
    # state carried across runs) and must never be re-touched by a later
    # deploy — only the directory layout above is retroactively migrated.
    [[ "$already_existed" == 1 ]] && return 0
    install -o "$SVC_USER" -g "$SVC_USER" -m 0640 /dev/null "$dir/audit.log"
    local f
    for f in run-target run-config.json run-launched-by; do
        install -o root -g "$SVC_USER" -m 0640 /dev/null "$dir/$f"
    done
    # When this slot came to be: `logs` shows nothing older, so a name reused
    # after a rename never shows the previous holder's journal (audit run 2).
    date +%s > "$dir/run-created"; chown root:"$SVC_USER" "$dir/run-created"; chmod 0640 "$dir/run-created"
}

# Runs one function from the shared unit-helper library in a subshell, so its
# constants never leak into this script.
_unit_lib() {
    local lib="$LIBDIR/capability-dropin.sh"
    [[ -f "$lib" ]] || die "the shared unit helpers are not installed at $lib.
reinstall it:  $REINSTALL"
    ( source "$lib"; "$@" )
}

# A team member's run sees exactly ONE file of teams/: its own team's
# channel. The slot template binds no part of teams/; this writes the slot's
# team.conf drop-in that binds the one file back (capability-dropin.sh's
# team_dropin). Re-checked before every start and resume, so it survives a
# hand-deleted file. A solo slot needs nothing.
ensure_slot_team_dropin() {
    local agent="$1"
    [[ "$SLOT" == *.team-* ]] || return 0
    local team="${SLOT#*.team-}"
    [[ -f "$(team_channel_file "$team")" ]] || die "team '$team' has no chat channel, so its members cannot run.
It was probably deleted. Create it again with:
  sudo agenti team create $team --agents <a,b>"
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ write %s.d/team.conf (binds %s)%s\n' "$c_d" "$(unit "$agent")" \
            "$(team_channel_file "$team")" "$c_0"
        return 0
    fi
    _team_member_file_ensure "$team" "$agent"
    _unit_lib write_dropin "$(unit "$agent")" team \
        "$(_unit_lib team_dropin "$agent" "$SLOT")" \
        || die "could not write the team drop-in for $(unit "$agent") — the run was not started."
}

# An IP-scoped run is fenced by the kernel to its own approved networks
# (capability-dropin.sh scope_dropin; audit run 1, fix 1b). Computed here, as
# root, by the same functions the runner uses (scope_cidr.backstop_networks),
# and rewritten before every start and resume so a scope edit or a new target
# always reaches the fence. Other scope kinds carry no fence (their old one is
# removed).
# The slot owner's own API key tier (capability-dropin.sh userkey_dropin).
ensure_slot_userkey_dropin() {
    local u; u="$(unit "$1")"
    [[ -n "$OWNER" ]] || return 0
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ write %s.d/userkey.conf (%s'"'"'s own key, if set)%s\n' "$c_d" "$u" "$OWNER" "$c_0"
        return 0
    fi
    _unit_lib write_dropin "$u" userkey "$(_unit_lib userkey_dropin "$OWNER")" \
        || die "could not write the API-key drop-in for $u — the run was not started."
}

# A domain run obeys the exclusions it loaded when it started. This root-owned
# record of them lets _stop_uncovered_runs tell a NEW exclusion under the
# run's target (the run must stop) from one it already honours (audit run 2).
record_run_exclusions() {
    local agent="$1"
    local dir; dir=$(agent_dir "$agent")
    if [[ "$(_agent_scope_kind "$agent")" != domain ]]; then
        [[ $DRY_RUN -eq 1 ]] || rm -f "$dir/run-excluded"
        return 0
    fi
    local out rc=0
    out=$(python3 "$LIBDIR/run_coverage.py" exclusions --org-dir "$(org_dir)" --agent "$agent" 2>&1) || rc=$?
    [[ $rc -eq 0 ]] || die "could not read the engagement's exclusions for $agent, so the run was not started:
$out"
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ write %s/run-excluded <- %s%s\n' "$c_d" "$dir" "${out:-(none)}" "$c_0"
        return 0
    fi
    rm -f "$dir/run-excluded"
    printf '%s\n' "$out" > "$dir/run-excluded"
    chown root:"$SVC_USER" "$dir/run-excluded"; chmod 0640 "$dir/run-excluded"
}

ensure_slot_scope_dropin() {
    local agent="$1" u; u="$(unit "$agent")"
    if [[ "$(_agent_scope_kind "$agent")" != cidr ]]; then
        [[ $DRY_RUN -eq 1 ]] || _unit_lib remove_dropin "$u" scope
        return 0
    fi
    local dir; dir=$(agent_dir "$agent")
    local out rc=0
    out=$(python3 "$LIBDIR/scope_cidr.py" backstop --org-dir "$(org_dir)" --agent "$agent" \
            --target-file "$dir/run-target" --optional 2>&1) || rc=$?
    [[ $rc -eq 0 && -n "$out" ]] || die "could not work out the networks this run may reach, so it was not started:
${out:-(no networks)}"
    local -a nets; mapfile -t nets <<<"$out"
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ write %s.d/scope.conf (kernel fence: %s)%s\n' "$c_d" "$u" "${nets[*]}" "$c_0"
        return 0
    fi
    _unit_lib write_dropin "$u" scope "$(_unit_lib scope_dropin "${nets[@]}")" \
        || die "could not write the network fence for $u — the run was not started."
}

# Removes the team.conf drop-ins of <owner>'s slots for <team> — every member
# agent's, or only [agent]'s.
clear_team_dropins() {
    local team="$1" a u
    local -a agents
    if [[ -n "${2:-}" ]]; then agents=("$2"); else mapfile -t agents < <(list_agents); fi
    for a in "${agents[@]}"; do
        u="agenti-$a-instance@$OWNER.team-$team.service"
        [[ -d "/etc/systemd/system/$u.d" ]] || continue
        _unit_lib remove_dropin "$u" team
    done
}

# The agent has a deployed master copy — WITHOUT provisioning anything (so
# `provision` can tell "already there" apart).
require_agent_master() {
    # The data FIRST: with the vault locked everything looks missing.
    require_org
    [[ -f "$(master_dir "$1")/$1-agent.py" ]] || die "no agent '$1' is installed.
installed: $(list_agents | tr '\n' ' ')
build one in the GUI (Settings → Agents), or from a source checkout:
  agenti new $1   then   sudo ./shared/deploy.sh"
}

require_agent() {
    require_agent_master "$1"
    ensure_base_provisioned "$1"
}

# Every start is its own isolated run in a fresh slot of its own (CLAUDE.md §4
# item 71: a slot is one run's private folder and systemd unit). The label is
# generated unless --copy pins one; it is what every later verb addresses the
# run by. Never shown to an operator as a name to remember — the GUI refers to
# a run by its agent, target and start time.
new_run_label() { printf 'run-%s' "$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"; }

# A run's NAME is for people: two random words ("amber-falcon") unless the
# operator gives one at start (--name) or later (rename). Display only — kept
# in the slot's root-owned run-name file, never read by the agent, never an
# address (verbs still take --copy or a run id).
RUN_NAME_ADJ=(amber azure brisk bronze calm cedar cobalt coral crimson dapper
  dusty ember fern frosty gentle golden hazel indigo ivory jade jolly keen lunar
  maple mellow misty noble ochre olive opal plum quiet rapid russet sage scarlet
  silver sly snowy solar spruce steady stormy sunny swift tawny teal tidal topaz
  umber velvet violet vivid wild willow witty young zesty)
RUN_NAME_NOUN=(badger beacon bison canyon cardinal comet condor coyote cricket
  delta falcon ferret finch fjord gecko glacier harbor hawk heron ibis jackal
  kestrel koala lagoon lark lemur lynx magpie marten meadow mesa mink moose
  newt ocelot orca osprey otter owl panda pelican puffin quail raven reef robin
  salmon sparrow summit tapir tern thrush tiger walrus willet wren yak zebra)
new_run_name() {
    printf '%s-%s' "${RUN_NAME_ADJ[RANDOM % ${#RUN_NAME_ADJ[@]}]}" \
        "${RUN_NAME_NOUN[RANDOM % ${#RUN_NAME_NOUN[@]}]}"
}
# Prints the cleaned name, or dies saying what is wrong with it.
valid_run_name() {
    local name; name=$(printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [[ -n "$name" ]] || die "a run name cannot be empty. Leave --name off for a generated one."
    [[ ${#name} -le 60 ]] || die "a run name is at most 60 characters (that one is ${#name})."
    [[ "$name" != *[[:cntrl:]]* ]] || die "a run name cannot contain control characters or line breaks."
    printf '%s' "$name"
}
write_run_name() {     # <slot dir> <name>
    printf '%s\n' "$2" > "$1/run-name"
    chown root:root "$1/run-name"; chmod 0644 "$1/run-name"
}

set_copy() {
    COPY="$1"
    SLOT="$OWNER${COPY:+.$COPY}"
}

# A per-run verb given no --copy: which of OWNER's runs of <agent> is meant?
# The only one running; failing that the most recently started. Two running at
# once is ambiguous and is refused with the exact command for each.
default_copy() {
    local agent="$1" d n t newest="" newest_t=0
    local -a active=()
    for d in "$(agent_base_dir "$agent")/instances"/*/; do
        [[ -d "$d" ]] || continue
        n=$(basename "$d")
        [[ "$n" == "$OWNER" || ( "$n" == "$OWNER".* && "$n" != *.team-* ) ]] || continue
        if systemctl is-active --quiet "agenti-${agent}-instance@${n}.service" 2>/dev/null; then
            active+=("$n")
        fi
        t=$(stat -c %Y "${d}state/state.json" 2>/dev/null || echo 0)
        if [[ "$t" -gt "$newest_t" ]]; then newest_t=$t; newest="$n"; fi
    done
    if [[ ${#active[@]} -gt 1 ]]; then
        local a lines=""
        for a in "${active[@]}"; do lines+="
  sudo agenti $agent <verb> --copy ${a#"$OWNER".}"; done
        die "'$OWNER' has ${#active[@]} runs of '$agent' going — say which one:$lines
list them:  sudo agenti $agent copies"
    fi
    local pick=""
    [[ ${#active[@]} -eq 1 ]] && pick="${active[0]}" || pick="$newest"
    [[ -n "$pick" ]] || return 0
    if [[ "$pick" == "$OWNER" ]]; then set_copy ""; else set_copy "${pick#"$OWNER".}"; fi
}

# For a verb that acts on an EXISTING run: the owner must have run this agent.
require_slot() {
    require_agent "$1"
    [[ -d "$(agent_dir "$1")" ]] || die "'$OWNER' has no runs of '$1'${COPY:+ (copy '$COPY')} yet.
start one:  sudo agenti $1 start ... --owner $OWNER"
}

# A run id (12 hex) names its run: find the one of OWNER's slots whose history
# holds it. Leaves COPY alone when none does, so the verb's own "no such run"
# message names what was asked for.
locate_run_slot() {
    local agent="$1" run_id="$2" d n
    for d in "$(agent_base_dir "$agent")/instances"/*/; do
        [[ -d "$d" ]] || continue
        n=$(basename "$d")
        [[ "$n" == "$OWNER" || ( "$n" == "$OWNER".* && "$n" != *.team-* ) ]] || continue
        local hist; hist=$(_slot_cat "${d%/}" state/history.jsonl 2>/dev/null) || hist=""
        if grep -q "\"run_id\": \"$run_id\"" <<<"$hist"; then
            if [[ "$n" == "$OWNER" ]]; then set_copy ""; else set_copy "${n#"$OWNER".}"; fi
            return 0
        fi
    done
    return 1
}

# exploit-approve / exploit-reject name a REQUEST, not a run: find the one of
# OWNER's runs of <agent> that proposed it, whichever copy that is.
locate_request_slot() {
    local agent="$1" request_id="$2" d n
    [[ "$request_id" =~ ^[0-9a-f]{4,32}$ ]] || return 1
    for d in "$(agent_base_dir "$agent")/instances"/*/; do
        [[ -d "$d" ]] || continue
        n=$(basename "$d")
        [[ "$n" == "$OWNER" || ( "$n" == "$OWNER".* && "$n" != *.team-* ) ]] || continue
        local pend; pend=$(_slot_cat "${d%/}" pending-actions.jsonl 2>/dev/null) || pend=""
        if grep -q "\"request_id\": \"$request_id\"" <<<"$pend"; then
            if [[ "$n" == "$OWNER" ]]; then set_copy ""; else set_copy "${n#"$OWNER".}"; fi
            return 0
        fi
    done
    return 1
}

# 'start' prompts for the passphrase rather than making you run a separate
# command first. cryptsetup does the prompting, so the passphrase never passes
# through this script.
ensure_vault() {
    agenti_vault_enabled || { require_data; return 0; }
    agenti_data_ready && return 0
    [[ -x "$VAULT_SH" ]] || die "vault is locked and $VAULT_SH is missing.
unlock manually: sudo ./vault.sh unlock"
    # cryptsetup prompts on the terminal. If stdin is not a TTY (piped input, a
    # pasted command block, a cron job) that prompt cannot work, and the failure
    # reads like a wrong passphrase. Say what is actually wrong.
    if [[ ! -t 0 ]]; then
        die "the vault is locked and stdin is not a terminal, so the passphrase
cannot be prompted for. Unlock it first, then re-run:
  sudo agenti vault unlock"
    fi
    note 'vault is locked — unlocking\n'
    run "$VAULT_SH" unlock || die "vault not unlocked — nothing was started"
    [[ $DRY_RUN -eq 1 ]] && return 0
    agenti_data_ready || die "vault still not mounted"
}

json_str() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

# Who is actually running this command? Used for attribution (CLAUDE.md §3g):
# stamped into run-launched-by, state.json, and the audit log. $SUDO_USER is
# the real human behind `sudo agenti ...`, which is how this is always
# invoked (need_root already enforces that) — falls back to whoami for the
# rare direct-root case, and finally "unknown" rather than leaving it unset.
invoking_user() { printf '%s' "${SUDO_USER:-$(whoami 2>/dev/null || echo unknown)}"; }

# Returns 0 (true) iff `$1` holds permission `$2` (on the organisation), per
# iam.py's own `can` command — the CLI's own independent re-check of an
# action the API already claims to have authorized (see cmd_start's own call
# site for why this cannot just trust the API). Fails closed: a missing
# iam.py, a malformed response, or any error at all reads as "no."
_iam_can() {
    local principal="$1" permission="$2"
    [[ -f "$IAM_PY" ]] || return 1
    python3 "$IAM_PY" --json can "$principal" "$permission" 2>/dev/null \
        | python3 -c '
import json, sys
try:
    sys.exit(0 if json.load(sys.stdin).get("allowed") else 1)
except Exception:
    sys.exit(1)
' 2>/dev/null
}

# Does this user exist in the identity store? Prints yes/no; "unknown" if the
# store cannot be read (callers fail closed on that).
_user_exists() {
    [[ -f "$IAM_PY" ]] || { printf 'unknown'; return; }
    python3 "$IAM_PY" --json user-exists "$1" 2>/dev/null | python3 -c '
import json, sys
try:
    print("yes" if json.load(sys.stdin).get("exists") else "no")
except Exception:
    print("unknown")' 2>/dev/null || printf 'unknown'
}

# Resolve OWNER/COPY into SLOT for a per-run verb. Runs are private to their
# owner (CLAUDE.md §4 item 71): the API must always say whose run it means.
# A terminal caller who is not an Agenti user (a plain sudoer) gets a
# break-glass slot of their own.
resolve_slot() {
    local api=0
    [[ "$(invoking_user)" == "${AGENTI_API_USER:-agenti-api}" ]] && api=1
    if [[ -z "$OWNER" ]]; then
        [[ $api -eq 0 ]] || die "REFUSING: a call through the API must say whose run it means (--owner)."
        OWNER=$(invoking_user)
    fi
    valid_name "$OWNER" || die "invalid owner '$OWNER' — owners are user names."
    if [[ -n "$COPY" ]]; then
        valid_name "$COPY" || die "invalid copy label '$COPY' — lowercase letters, digits, '-' or '_'."
    fi
    if [[ $api -eq 1 ]]; then
        [[ "$(_user_exists "$OWNER")" == "yes" ]] || die "REFUSING: no user named '$OWNER'."
    fi
    SLOT="$OWNER${COPY:+.$COPY}"
}

