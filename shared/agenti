            --via)    [[ $# -ge 2 ]] || die "--via needs a value: cli or api"
                      :   # ignored: how a request came in is always sudo's answer, $(_via)
                      shift 2 ;;
            -*)       die "unknown option for acknowledge: $1" ;;
            *)        [[ -z "$run_id" ]] || die "acknowledge takes ONE run id:
  sudo agenti $agent acknowledge 3f2a9c1b7e04"
