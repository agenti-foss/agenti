                [[ "$cverb" != revert ]] || iam_extra+=(--version "$c_version")
                local aout; aout=$(python3 "$IAM_PY" --json --actor "$(invoking_user)" approve-context-edit \
                    "$cverb" "$ckind" "${iam_extra[@]}" "--grant=$c_grant" 2>&1) || crc=$?
                [[ $crc -eq 0 ]] || _ctx_fail "$aout"
                local approver; approver=$(printf '%s' "$aout" | python3 -c 'import json,sys; print(json.load(sys.stdin)["approved_by"])')
                case "$cverb" in
                    set)    cout=$(python3 "$cs" --root "$AGENTI_ROOT" set "$ckind" "${cwho[@]}" --by "$approver" --via api --file "$ctmp" 2>&1) || crc=$? ;;
                    reset)  cout=$(python3 "$cs" --root "$AGENTI_ROOT" reset "$ckind" "${cwho[@]}" --by "$approver" --via api 2>&1) || crc=$? ;;
                    revert) cout=$(python3 "$cs" --root "$AGENTI_ROOT" revert "$ckind" "$c_version" "${cwho[@]}" --by "$approver" --via api 2>&1) || crc=$? ;;
                esac ;;
            context-memory)
                [[ "$ckind" == memory ]] || die "context-memory only handles 'memory'"
                [[ -n "$c_agent" && -n "$c_user" && -n "$c_by" ]] \
                    || die "context-memory needs --agent, --user and --by"
                valid_name "$c_agent" || die "invalid agent name"
                [[ -d "$(master_dir "$c_agent")" ]] || die "no agent '$c_agent' is deployed."
                [[ "$(_user_exists "$c_user")" == "yes" ]] || die "no user named '$c_user'."
                case "$cverb" in
                    set|append)
                        head -c 40000 > "$ctmp"
                        cout=$(python3 "$cs" --root "$AGENTI_ROOT" "$cverb" memory "${cwho[@]}" --by "$c_by" --via api --file "$ctmp" 2>&1) || crc=$? ;;
                    reset)
                        cout=$(python3 "$cs" --root "$AGENTI_ROOT" reset memory "${cwho[@]}" --by "$c_by" --via api 2>&1) || crc=$? ;;
                    proposals)
                        cout=$(python3 "$cs" --root "$AGENTI_ROOT" proposals --agent "$c_agent" --user "$c_user" 2>&1) || crc=$? ;;
                    decide)
                        [[ -n "$c_id" && -n "$c_decision" ]] || die "decide needs --id and --decision (approve or dismiss)"
                        cout=$(python3 "$cs" --root "$AGENTI_ROOT" decide --agent "$c_agent" --user "$c_user" \
                            "$c_id" "$c_decision" --by "$c_by" --via api 2>&1) || crc=$? ;;
                    *) die "context-memory verbs: set | append | reset | proposals | decide" ;;
                esac ;;
            esac
            [[ $crc -eq 0 ]] || _ctx_fail "$cout"
            printf '%s\n' "$cout"
            ;;
        retention-sweep)
            shift
            cmd_retention_sweep "$@"
            ;;
        update-check)
            shift
            cmd_update_check "$@"
            ;;
        outputs-cat)
            # Deliberately its OWN case, not forwarded to iam.py like the
            # verbs below: its success output is raw file bytes, never JSON
            # — see cmd_outputs_cat's own docstring. refuse_iam_writes_from_api
            # is irrelevant here (this isn't an identity-store write at all).
            shift
            cmd_outputs_cat "$@"
            ;;
        # ---- identity & access management (CLAUDE.md §3g) -----------------
        #
        # Forwarded wholesale to shared/iam.py, which owns the argument parsing,
        # the schema and the resolution rules — the same "one implementation"
        # discipline the API follows by going through this CLI. Deliberately
        # CLI-only and root-gated: the API opens iam.db READ-ONLY, so a
        # compromised API process cannot grant itself anything. It also means
        # you can still revoke a key when the API is down, which is exactly
        # when you would want to.
        user|principal|bind|unbind|bindings|issue-key|revoke-key|list-keys|\
        can|bootstrap|set-policy|policy|permissions|authz-log|self|web-bind|web-unbind|\
        create-user|disable-user|\
        rename-user|delete-user|enable-user|user-history|\
        reset-user-password|reset-user-mfa|\
        create-principal|disable-principal|rename-principal|delete-principal|\
        enable-principal|principal-history|reset-principal-password|\
        reset-principal-mfa|list-principals|principal-exists|\
        password-reset-check|password-reset-consume|\
        user-exists|dashboard-access|\
        mint-enrolment-link|enrol-check|enrol-consume|list-users|\
        setup-code|setup-first-admin|\
        set-limit|\
        outputs-usage|outputs-list|outputs-delete|outputs-path|\
        tool-request-file|tool-request-list|\
        passkey-commit|passkey-list|set-webauthn)
            refuse_iam_writes_from_api "$1"
            [[ -f "$IAM_PY" ]] || die "$IAM_PY is missing, so identity management is unavailable.
reinstall it:  $REINSTALL"
            # --json goes FIRST, not appended: the global flag loop above
            # strips it from the original argv, and iam.py's argparse declares
            # it on the top-level parser, where it must precede the subcommand.
            # Appending it produced "unrecognized arguments: --json" on every
            # --json admin call — found by running one, not by reading argparse.
            local iam_args=()
            [[ $JSON -eq 1 ]] && iam_args+=(--json)
            iam_args+=("$@")
            # SUDO_USER is passed explicitly rather than read from the
            # environment inside iam.py: sudo may or may not preserve it
            # depending on env_reset, and "who made this change" is not
            # something to leave to configuration.
            exec python3 "$IAM_PY" --actor "$(invoking_user)" "${iam_args[@]}"
            ;;
        *) die "admin verbs:
  update-check                 is a newer release out? Report-only (installs nothing);
                                off by default: allow it with
                                  sudo agenti admin set-policy update-check on
  retention-sweep [--dry-run] [--days N] [--agent A]
                                delete run working data + task history older
                                than N days (default 30) — CLAUDE.md decision 7.
                                Never touches reports/ (outputs are kept
                                indefinitely — see: <agent> promote-output)
  outputs-usage [--user U]                     the Outputs store's two-level quota
  outputs-list [--user U]                      promoted outputs in the permanent store
  outputs-delete <name>... --user U --by <who>   delete one or more
  outputs-cat <name> --user U                  print one's raw bytes (a download route's source)
  tool-request-file <text> --by <who> [--category C]
                                file a request for a tool the library lacks
  tool-request-list                            every filed tool request, newest first

identity & access (CLAUDE.md §3g):
  bootstrap --user <name>      first-run setup: an admin user and its first key
  user add|list|disable|enable|set-password
  bind user <name> --role <operator|admin>   set a user's role
  bindings [--user <name>]     list users and their roles
  issue-key --user <name> [--expires-days N]
  revoke-key <prefix> | list-keys [--user <name>]
  can <user> <permission>                    explain a decision
  permissions | policy | set-policy <key> on|off
  authz-log [-n N] [--user <name>] [--denied-only]   the authz audit trail
  self password|mfa-start|mfa-confirm|passkey-remove <name> --current <pw> [...]
                                change YOUR OWN credentials; re-proves the
                                current password (+2FA code if enrolled)
                                first — this is what the web GUI's account
                                page uses, not something a human normally
                                types by hand
  passkey-commit <name> --credential-id=<id> --alg=ES256 --x=<b64> --y=<b64>
                  --sign-count N --name '<label>' --grant=<id>
                                record a passkey agenti-authd has already
                                cryptographically verified (the grant proves
                                it — this call trusts nothing else)
  passkey-list <name>          a user's registered passkeys (read-only)
  set-webauthn on|off          turn WebAuthn/passkey sign-in on platform-wide
                                (needs a domain: sudo agenti gui configure
                                --hostname <domain>)
  user reset-passkeys <name>   root break-glass: remove every passkey
                                for someone who lost every device

full help:  sudo agenti admin --help" ;;
    esac
}

# ---------------------------------------------------------------------------
# Multi-agent teams (CLAUDE.md §3i). A team is a named grouping of agents.
# Phase 1 of the build: membership CRUD only. `start`/`stop`/`pause`/
# `resume`/`status`/`say`/`note`/`inbox` land in later phases — see the plan.
#
# Stored as one root-owned JSON file per team, same permission shape as
# every other root file in this project: the file records WHO may run as a
# member and HOW (scope_mode), and only root (via this CLI) can change that —
# an agent cannot add itself to a team any more than it can set its own scope.
# ---------------------------------------------------------------------------
teams_dir()         { printf '%s/teams' "$(org_dir)"; }
team_file()         { printf '%s/%s.json' "$(teams_dir)" "$1"; }
# The chat channel (CLAUDE.md §3i) is a folder with one file per writer
# (audit run 1, N02): channel.jsonl, which only root writes (the operator's
# say/note and the kickoff), and member-<agent>.jsonl, which only that member
# writes. A member's run sees the folder read-only with its own file writable.
team_channel_dir()  { printf '%s/%s.d' "$(teams_dir)" "$1"; }
team_channel_file() { printf '%s/channel.jsonl' "$(team_channel_dir "$1")"; }
team_member_file()  { printf '%s/member-%s.jsonl' "$(team_channel_dir "$1")" "$2"; }

# <team> <agent>: makes sure the member's own channel file exists, owned by the
# service account and append-only (it cannot rewrite even its own lines).
_team_member_file_ensure() {
    local mf; mf=$(team_member_file "$1" "$2")
    [[ -f "$mf" ]] && return 0
    : > "$mf"
    chown "$SVC_USER":"$SVC_USER" "$mf"; chmod 0640 "$mf"
    chattr +a "$mf" 2>/dev/null || { rm -f "$mf"; die "could not set the append-only attribute on $mf.
This filesystem may not support chattr (ext4 does): lsattr -d $AGENTI_ROOT"; }
}

require_team() {
    [[ -f "$(team_file "$1")" ]] || die "no team '$1' for '$OWNER'.
list yours:  sudo agenti team list"
}

cmd_team_create() {
    local name="" agents="" fixed=0
    if [[ $# -gt 0 && "$1" != --* ]]; then name="$1"; shift; fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --agents)
                [[ $# -ge 2 ]] || die "--agents needs a value, e.g. --agents enum,research"
                agents="$2"; shift 2 ;;
            --fixed) fixed=1; shift ;;
            *) die "unknown option for team create: $1" ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: sudo agenti team create <name> --agents a,b[,c] [--fixed]"
    valid_name "$name" && [[ ${#name} -le 58 ]] || die "invalid team name '$name'.
must match ^[a-z0-9][a-z0-9_-]{0,57}\$ — no '/', '.', or other path characters."
    [[ -n "$agents" ]] || die "team create needs --agents a,b[,c] (the agents this team groups):
  sudo agenti team create $name --agents enum,research"

    ensure_vault
    require_org
    local tdir tf; tdir=$(teams_dir); tf=$(team_file "$name")
    # Team names are unique across the organisation. Someone else's team is not yours to
    # know about, so that case names no owner.
    if [[ -f "$tf" ]]; then
        [[ "$(_team_owner "$name")" == "$OWNER" ]] && die "team '$name' already exists — it's yours.
see it:    sudo agenti team $name show
start it:  sudo agenti team $name start ..."
        die "the team name '$name' is taken — pick another."
    fi

    # Every named agent must already be deployed, checked BEFORE
    # anything is written — a half-built team naming a nonexistent agent
    # would be confusing to discover later rather than refused now.
    local IFS=','; local -a agent_list=($agents); unset IFS
    local a
    for a in "${agent_list[@]}"; do
        valid_name "$a" || die "invalid agent name '$a' in --agents"
        [[ -f "$(master_dir "$a")/$a-agent.py" ]] || die "no agent '$a' deployed.
deployed: $(list_agents | tr '\n' ' ')"
    done

    local svc_user; svc_user=$SVC_USER
    if [[ $DRY_RUN -eq 1 ]]; then
        note '  %s$ create team %s <- members: %s (fixed=%s)%s\n' "$c_d" "$name" "$agents" "$fixed" "$c_0"
        [[ $JSON -eq 1 ]] && printf '{"team":%s,"created":false,"dry_run":true}\n' \
            "$(json_str "$name")"
        return 0
    fi

    mkdir -p "$tdir"; chown root:"$svc_user" "$tdir"; chmod 0750 "$tdir"

    local by="$OWNER" json
    json=$(python3 -c '
import json, sys, time
name, agents_csv, by, fixed = sys.argv[1:5]
members = [{"agent": a, "scope_mode": "isolated"} for a in agents_csv.split(",") if a]
doc = {"name": name, "fixed": fixed == "1", "owner": by, "created_by": by,
       "created_at": time.time(), "members": members}
print(json.dumps(doc))
' "$name" "$agents" "$by" "$fixed") || die "could not build the team record"

    printf '%s\n' "$json" > "$tf"
    chown root:"$svc_user" "$tf"; chmod 0640 "$tf"

    # The shared channel (CLAUDE.md §3i). Unlike every other team/agent file
    # in this project, it must be WRITABLE by the service
    # account — every member posts to it, and so does the operator's own
    # say/note. What keeps that safe: `chattr +a` (ext4 append-only). Once
    # set, appending is all ANY account can do to this file — rewriting or
    # deleting an existing line needs CAP_LINUX_IMMUTABLE, which is not in
    # the agent unit's capability set, so even a fully compromised agent
    # process cannot tamper with a prior entry, including its own.
    local cdir; cdir=$(team_channel_dir "$name")
    install -d -o root -g "$svc_user" -m 0750 "$cdir"
    local cf; cf=$(team_channel_file "$name")
    : > "$cf"
    # Root alone writes this file now (members have their own, below).
    chown root:"$svc_user" "$cf"; chmod 0640 "$cf"
    if ! chattr +a "$cf" 2>/dev/null; then
        # Fail LOUD, not quiet: a channel without +a is still fully
        # functional but silently loses the one property that makes it
        # safe for an unprivileged agent process to write to. Refusing the
        # whole team-create is safer than shipping a channel that looks
        # protected but is not — this filesystem may not support the
        # attribute (chattr is ext4/most Linux native filesystems; it is
        # NOT available on e.g. overlayfs, some network filesystems).
        rm -rf "$cdir"; rm -f "$tf"; rmdir --ignore-fail-on-non-empty "$tdir" 2>/dev/null || true
        die "could not set the append-only attribute on the team channel
($cf) — refusing to create the team rather than shipping a channel that
looks tamper-resistant but is not. This usually means $AGENTI_ROOT's
filesystem does not support chattr (ext4 does; verify with: lsattr -d $AGENTI_ROOT)."
    fi

    if [[ $JSON -eq 1 ]]; then
        printf '%s\n' "$json"
    else
        ok "team '$name' created with members: $agents"
        printf '  every member starts scope_mode=isolated (its own target, unaffected by the team).\n'
        printf '  mark one shared:  sudo agenti team %s add-agent <agent> --scope-mode shared\n' "$name"
    fi
}

cmd_team_show() {
    local name="$1" tf; tf=$(team_file "$name")
    if [[ $JSON -eq 1 ]]; then
        cat "$tf"
    else
        python3 -c '
# Nested double quotes inside an f-string expression (d["name"]) require a
# backslash before Python 3.12, and this project cannot assume 3.12 is what
# is installed — the exact pitfall CLAUDE.md §4 item 13 already documents
# for cmd_approval. Fixed the same way: single-quote the dict keys, since
# the outer string here is double-quoted, not by escaping.
import json, sys
d = json.load(open(sys.argv[1]))
name = d["name"]; created_by = d["created_by"]
fixed_word = "yes" if d["fixed"] else "no"
print(f"  team: {name}")
print(f"  fixed membership: {fixed_word}")
print(f"  created by {created_by}")
if d.get("acknowledged"):
    print(f"  status: COMPLETE — marked by {d.get('acknowledged_by')}")
print("  members:")
for m in d["members"]:
    agent = m["agent"]; scope_mode = m["scope_mode"]
    print(f"    {agent:<20} scope_mode={scope_mode}")
' "$tf"
    fi
}

cmd_team_add_agent() {
    local name="$1"; shift
    local agent="${1:-}"; [[ $# -gt 0 ]] && shift
    local scope_mode="isolated"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope-mode)
                [[ $# -ge 2 ]] || die "--scope-mode needs a value: isolated or shared"
                case "$2" in
                    isolated|shared) scope_mode="$2" ;;
                    *) die "--scope-mode must be 'isolated' or 'shared', not '$2'" ;;
                esac
                shift 2 ;;
            *) die "unknown option for add-agent: $1" ;;
        esac
    done
    [[ -n "$agent" ]] || die "usage: sudo agenti team $name add-agent <agent> [--scope-mode isolated|shared]"
    valid_name "$agent" || die "invalid agent name '$agent'"
    # Validates against the agent's MASTER copy: any deployed agent is
    # addressable, and require_agent() provisions its parent right away
    # rather than leaving cmd_team_start to discover a missing directory
    # later when it first tries to write run-role/run-team into it.
    require_agent "$agent"

    local tf svc_user; tf=$(team_file "$name"); svc_user=$SVC_USER
    # Idempotent upsert: adding an agent already on the team just updates its
    # scope_mode, rather than needing a separate "set-scope-mode" verb.
    local result
    result=$(python3 -c '
import json, sys
path, agent, scope_mode = sys.argv[1:4]
d = json.load(open(path))
existing = next((m for m in d["members"] if m["agent"] == agent), None)
if d.get("fixed") and existing is None:
    print("REFUSED:fixed"); sys.exit(0)
if existing is not None:
    existing["scope_mode"] = scope_mode
    verb = "updated"
else:
    d["members"].append({"agent": agent, "scope_mode": scope_mode})
    verb = "added"
json.dump(d, open(path, "w"))
print("OK:" + verb)
' "$tf" "$agent" "$scope_mode")

    if [[ "$result" == "REFUSED:fixed" ]]; then
        die "team '$name' has fixed membership — cannot add '$agent'.
this team was created with --fixed, which locks membership at creation.
delete and recreate it if membership genuinely needs to change:
  sudo agenti team $name delete"
    fi

    chown root:"$svc_user" "$tf"; chmod 0640 "$tf"
    local verb_done="${result#OK:}"
    if [[ $JSON -eq 1 ]]; then
        printf '{"team":%s,"agent":%s,"scope_mode":%s,"result":%s}\n' \
            "$(json_str "$name")" "$(json_str "$agent")" \
            "$(json_str "$scope_mode")" "$(json_str "$verb_done")"
    else
        ok "'$agent' $verb_done on team '$name' (scope_mode=$scope_mode)"
    fi
}

cmd_team_remove_agent() {
    local name="$1"; shift
    local agent="${1:-}"
    [[ -n "$agent" ]] || die "usage: sudo agenti team $name remove-agent <agent>"

    local tf svc_user; tf=$(team_file "$name"); svc_user=$SVC_USER
    local result
    result=$(python3 -c '
import json, sys
path, agent = sys.argv[1:3]
d = json.load(open(path))
if d.get("fixed"):
    print("REFUSED:fixed"); sys.exit(0)
before = len(d["members"])
d["members"] = [m for m in d["members"] if m["agent"] != agent]
if len(d["members"]) == before:
    print("REFUSED:notmember"); sys.exit(0)
json.dump(d, open(path, "w"))
print("OK")
' "$tf" "$agent")

    case "$result" in
        REFUSED:fixed)
            die "team '$name' has fixed membership — cannot remove '$agent'.
delete and recreate the team if membership genuinely needs to change." ;;
        REFUSED:notmember)
            die "'$agent' is not a member of team '$name'.
see members: sudo agenti team $name show" ;;
    esac

    chown root:"$svc_user" "$tf"; chmod 0640 "$tf"
    clear_team_dropins "$name" "$agent"
    if [[ $JSON -eq 1 ]]; then
        printf '{"team":%s,"agent":%s,"removed":true}\n' \
            "$(json_str "$name")" "$(json_str "$agent")"
    else
        ok "'$agent' removed from team '$name'"
    fi
}

cmd_team_delete() {
    local name="$1" tf cf
    tf=$(team_file "$name"); cf=$(team_channel_file "$name")
    # The channel is chattr +a — even root cannot unlink it without first
    # clearing the attribute (unlike a plain rm, which the append-only flag
    # blocks at the VFS level regardless of who's asking). Root here has
    # CAP_LINUX_IMMUTABLE (this is the CLI's own root process, not the
    # capability-narrowed agent service), so clearing it is legitimate —
    # only the unprivileged agent account is denied that capability.
    local cdir; cdir=$(team_channel_dir "$name")
    if [[ -d "$cdir" ]]; then
        chattr -a "$cdir"/*.jsonl 2>/dev/null || true
        rm -rf "$cdir"
    fi
    rm -f "$tf"
    clear_team_dropins "$name"
    if [[ $JSON -eq 1 ]]; then
        printf '{"team":%s,"deleted":true}\n' "$(json_str "$name")"
    else
        ok "team '$name' deleted (member agents untouched — a team is a grouping, not an owner)"
    fi
}

# tab-separated "<agent>\t<scope_mode>" lines, one per member.
_team_members() {
    local tf; tf=$(team_file "$1")
    python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
for m in d["members"]:
    print(m["agent"] + "\t" + m["scope_mode"])
' "$tf"
}

# Phase 2 (CLAUDE.md §3i): coordinated start + fan-out control verbs. Every
# member's OWN cmd_start/cmd_stop/cmd_pause/cmd_resume/cmd_status runs
# UNMODIFIED — team verbs are sugar over the existing per-agent path, not a
# second execution path, so require-separate-approver, admin-approve, and
# scope narrowing all keep applying exactly as they do for a solo start.
#
# Each member call is wrapped in a subshell: die() does a plain `exit 1`
# (see die()'s own definition), which would otherwise kill this whole
# team command on the FIRST member that fails, abandoning members already
# started with no clear record. `( cmd_start ... )` contains that exit to
# just the subshell, so the loop can record the failure and continue to the
# next member — the same reason cmd_start's own dry-run write-plan output
# is captured rather than let straight through.
cmd_team_start() {
    local name="$1"; shift
    local default_target=""
    local -A overrides=()
    local -A role_overrides=()
    local -a passthrough=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 ]] || die "--target needs a value, e.g.
  --target 192.0.2.50            (default for every 'shared' member)
  --target enum=192.0.2.50       (override for just one member)"
                if [[ "$2" == *=* ]]; then
                    overrides["${2%%=*}"]="${2#*=}"
                else
                    default_target="$2"
                fi
                shift 2 ;;
            --role)
                [[ $# -ge 2 ]] || die "--role needs a value, e.g.
  --role enum-internal='internal network assessment'
  --role enum-external='external network assessment'"
                [[ "$2" == *=* ]] || die "--role must be agent=text, e.g.
  --role enum-internal='internal network assessment'"
                role_overrides["${2%%=*}"]="${2#*=}"
                shift 2 ;;
            *) passthrough+=("$1"); shift ;;
        esac
    done

    mapfile -t member_lines < <(_team_members "$name")
    [[ ${#member_lines[@]} -gt 0 ]] || die "team '$name' has no members. add one:
  sudo agenti team $name add-agent <agent>"

    local svc_user; svc_user=$SVC_USER

    # Roles + kickoff: written and posted BEFORE any member starts (same
    # write-before-start ordering as run-team below), so an agent's very first
    # look at the channel already finds the roster, and its instructions —
    # built from this entry when it starts — already name every teammate and
    # what each is doing. Posted on EVERY start, not only when roles were given:
    # a team of unlabelled members still needs to know who else is on it. A
    # member with no --role this call keeps whatever role it already had (its
    # existing run-role file). A member with no target is skipped below, so it
    # is left out of the roster: nobody should wait on a teammate that is not
    # running.
    if [[ $DRY_RUN -ne 1 ]]; then
        local -a roster_items=()
        local line agent scope_mode adir role target
        for line in "${member_lines[@]}"; do
            agent="${line%%$'\t'*}"; scope_mode="${line#*$'\t'}"
            ensure_slot_provisioned "$agent"
            adir=$(agent_dir "$agent")
            role="${role_overrides[$agent]:-}"
            if [[ -z "$role" ]]; then
                role=$(cat "$adir/run-role" 2>/dev/null || true)
            fi
            if [[ -n "$role" ]]; then
                printf '%s' "$role" > "$adir/run-role"
                chown root:"$svc_user" "$adir/run-role"; chmod 0640 "$adir/run-role"
            else
                rm -f "$adir/run-role"
            fi
            target="${overrides[$agent]:-}"
            [[ -z "$target" && "$scope_mode" == "shared" ]] && target="$default_target"
            # A file-analysis member has no target: its work is the files
            # attached to it, so it is on the roster and never skipped.
            [[ -z "$target" && "$(_agent_scope_kind "$agent")" == files ]] && target="the files attached to it"
            [[ -n "$target" ]] || continue
            roster_items+=("$agent"$'\t'"$role"$'\t'"$target"$'\t'"$(master_dir "$agent")/capabilities.json")
        done
        [[ ${#roster_items[@]} -eq 0 ]] || _team_channel_append_kickoff "$name" "$OWNER" cli "${roster_items[@]}"
    fi

    local -a started=() skipped=() failed=() result_jsons=()
    local line agent scope_mode target adir role output rc

    for line in "${member_lines[@]}"; do
        agent="${line%%$'\t'*}"; scope_mode="${line#*$'\t'}"
        target="${overrides[$agent]:-}"
        [[ -z "$target" && "$scope_mode" == "shared" ]] && target="$default_target"

        ensure_slot_provisioned "$agent"
        adir=$(agent_dir "$agent")
        # A file-analysis member is started with no target (cmd_start refuses
        # one); it needs a file attached to it instead, which cmd_start checks.
        local -a start_target=(-t "$target")
        if [[ "$(_agent_scope_kind "$agent")" == files ]]; then
            target="(none: file analysis)"; start_target=()
        fi
        if [[ -z "$target" ]]; then
            skipped+=("$agent")
            [[ $JSON -ne 1 ]] && warn "skipping '$agent' — no target (scope_mode=$scope_mode, and no --target $agent=<value> given)"
            continue
        fi

        # Written BEFORE cmd_start, not after: `systemctl start` (inside
        # cmd_start) returns as soon as the unit is FORKED, not once the
        # process has actually started up — a write-after-start genuinely
        # raced the freshly-spawned agent reading run-team to build its
        # CONTRACT (deciding whether team_message exists at all). Found by
        # live testing: team_message was silently absent from a real team
        # run's tool list despite this function "already" having written
        # run-team by the time it returned. Root-owned, same shape as
        # run-target — the agent reads it and cannot set its own, which is
        # what stops it claiming a false team identity.
        #
        # cmd_start's OWN "a plain start is always fresh" cleanup would
        # normally delete this file (§1 invariant 7 — a solo start must
        # never inherit team membership). _TEAM_START_IN_PROGRESS=1 is how
        # THIS call opts out of that, for THIS one cmd_start invocation only.
        if [[ $DRY_RUN -ne 1 ]]; then
            python3 -c '
import json, sys
print(json.dumps({"team": sys.argv[1], "member": sys.argv[2]}))
' "$name" "$agent" > "$adir/run-team" \
                && chown root:"$svc_user" "$adir/run-team" && chmod 0640 "$adir/run-team"
        fi

        # `set -e` is active for this whole script. A bare `output=$(...)`
        # assignment whose command substitution fails is NOT exempt from
        # errexit — it would kill this entire team command on the first
        # member that legitimately fails (e.g. an already-active run),
        # printing nothing at all, before the loop ever reaches a later
        # member or the final result summary. Found by live-testing this
        # exact scenario. The `|| rc=$?` puts the assignment in a tested
        # context, which IS exempt, restoring the per-member containment
        # the subshell was already supposed to provide.
        rc=0
        output=$( ( _TEAM_START_IN_PROGRESS=1 cmd_start "$agent" "${start_target[@]}" "${passthrough[@]}" ) ) || rc=$?
        [[ $JSON -ne 1 ]] && printf '%s\n' "$output"

        if [[ $rc -eq 0 ]]; then
            started+=("$agent")
            [[ $JSON -eq 1 ]] && result_jsons+=("$output")
        else
            failed+=("$agent")
            [[ $DRY_RUN -ne 1 ]] && rm -f "$adir/run-team"
        fi
    done

    if [[ $JSON -eq 1 ]]; then
        python3 -c '
import json, sys
team = sys.argv[1]
i = 2
n = int(sys.argv[i]); i += 1; started = sys.argv[i:i+n]; i += n
n = int(sys.argv[i]); i += 1
results = []
for r in sys.argv[i:i+n]:
    try:
        results.append(json.loads(r))
    except Exception:
        results.append({"raw": r})
i += n
n = int(sys.argv[i]); i += 1; skipped = sys.argv[i:i+n]; i += n
n = int(sys.argv[i]); i += 1; failed = sys.argv[i:i+n]
print(json.dumps({"team": team, "started": started,
                  "results": results, "skipped": skipped, "failed": failed}))
' "$name" \
            "${#started[@]}" "${started[@]}" \
            "${#result_jsons[@]}" "${result_jsons[@]}" \
            "${#skipped[@]}" "${skipped[@]}" \
            "${#failed[@]}" "${failed[@]}"
    else
        ok "team '$name': started ${#started[@]}, skipped ${#skipped[@]}, failed ${#failed[@]}"
    fi
    [[ ${#failed[@]} -eq 0 ]]
}

# Generic fan-out for stop/pause/resume/status: calls the existing per-agent
# cmd_<verb> for every member, subshell-contained for the same reason as
# cmd_team_start. Not every per-agent verb emits JSON on every path yet
# (cmd_resume's freeze/thaw branch is plain text) — rather than special-case
# each one, a captured line that doesn't parse as JSON is wrapped as
# {"raw": "..."} so team --json output is always valid JSON either way.
cmd_team_fanout() {
    local name="$1" verb="$2"
    mapfile -t member_lines < <(_team_members "$name")
    [[ ${#member_lines[@]} -gt 0 ]] || die "team '$name' has no members."

    local -a ok_agents=() fail_agents=() result_jsons=()
    local line agent output rc
    for line in "${member_lines[@]}"; do
        agent="${line%%$'\t'*}"
        # Same `set -e`-vs-command-substitution fix as cmd_team_start —
        # see its comment. Without `|| rc=$?` here, the first member with no
        # active run to stop/pause/resume kills the whole team command.
        rc=0
        output=$( ( require_agent "$agent"; "cmd_${verb}" "$agent" ) ) || rc=$?
        [[ $JSON -ne 1 ]] && printf '%s\n' "$output"
        if [[ $rc -eq 0 ]]; then
            ok_agents+=("$agent")
            [[ $JSON -eq 1 ]] && result_jsons+=("$output")
        else
            fail_agents+=("$agent")
        fi
    done

    if [[ $JSON -eq 1 ]]; then
        python3 -c '
import json, sys
team, verb = sys.argv[1:3]
i = 3
n = int(sys.argv[i]); i += 1; ok = sys.argv[i:i+n]; i += n
n = int(sys.argv[i]); i += 1
results = []
for r in sys.argv[i:i+n]:
    try:
        results.append(json.loads(r))
    except Exception:
        results.append({"raw": r})
i += n
n = int(sys.argv[i]); i += 1; failed = sys.argv[i:i+n]
print(json.dumps({"team": team, "verb": verb,
                  "ok": ok, "results": results, "failed": failed}))
' "$name" "$verb" \
            "${#ok_agents[@]}" "${ok_agents[@]}" \
            "${#result_jsons[@]}" "${result_jsons[@]}" \
            "${#fail_agents[@]}" "${fail_agents[@]}"
    else
        ok "team '$name' $verb: ${#ok_agents[@]} ok, ${#fail_agents[@]} failed"
    fi
    [[ ${#fail_agents[@]} -eq 0 ]]
}

# A team's owner: its `owner` field (teams created before private runs carry
# only created_by, which the migration copies over).
_team_owner() {
    python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get("owner") or d.get("created_by") or "")
except Exception:
    print("")' "$(team_file "$1")"
}

team_usage() {
    cat <<'EOF'
usage: sudo agenti team <list|create|NAME> ...
  sudo agenti team list
  sudo agenti team create <name> --agents a,b[,c] [--fixed]
  sudo agenti team <name> show
  sudo agenti team <name> add-agent <agent> [--scope-mode isolated|shared]
  sudo agenti team <name> remove-agent <agent>
  sudo agenti team <name> delete
  sudo agenti team <name> start --target <value> [--target <agent>=<value>]...
                                        [--role <agent>=<text>]...
  sudo agenti team <name> stop | pause | resume | status
  sudo agenti team <name> say "<text>"    steer every member (§3i)
  sudo agenti team <name> note "<text>"   record only, never delivered
  sudo agenti team <name> inbox [-n N]  the shared channel transcript
  sudo agenti team <name> attach <file> [--name <name>]
                                        give every member a file (§4 item 82)
  sudo agenti team <name> files [remove <name>]
                                        the members' files
  sudo agenti team <name> report [--promote] [--by <name>]
                                        the assembled team document
  sudo agenti team <name> consensus   who has voted the project complete
  sudo agenti team <name> acknowledge [--author <name>]
                                        stop whatever is still running and mark
                                        the project reviewed/done
EOF
}

cmd_team() {
    local sub="${1:-}"
    # Teams, like runs, belong to whoever started them (CLAUDE.md §4 item 71).
    case "$sub" in ""|--help|-h) ;; *) ensure_vault; require_org; resolve_slot ;; esac

    case "$sub" in
        list)
            shift
            local dir t; dir=$(teams_dir)
            local -a _teams=()
            while IFS= read -r t; do
                [[ -n "$t" && "$(_team_owner "$t")" == "$OWNER" ]] && _teams+=("$t")
            done < <([[ -d "$dir" ]] && find "$dir" -maxdepth 1 -name '*.json' -printf '%f\n' 2>/dev/null \
                       | sed 's/\.json$//' | sort || true)
            if [[ $JSON -eq 1 ]]; then
                python3 -c '
import json, sys
print(json.dumps({"teams": sys.argv[1:]}))
' "${_teams[@]}"
            elif [[ ${#_teams[@]} -eq 0 ]]; then
                printf '  (no teams yet)\n'
            else
                printf '  %s\n' "${_teams[@]}"
            fi
            return 0 ;;
        create)
            shift; cmd_team_create "$@"; return 0 ;;
        "")           die "$(team_usage)" ;;
        --help|-h)    team_usage; return 0 ;;
    esac

    # sub is a team NAME at this point, not a reserved word above.
    local name="$sub"; shift
    valid_name "$name" || die "invalid team name '$name'.
must match ^[a-z0-9][a-z0-9_-]{0,63}\$ — no '/', '.', or other path characters."
    require_team "$name"
    # Someone else's team reads exactly like a missing one.
    [[ "$(_team_owner "$name")" == "$OWNER" ]] || die "no team '$name' for '$OWNER'.
list yours:  sudo agenti team list"
    # Every member runs in the owner's dedicated slot for this team. Set as a
    # pinned copy label (set_copy), not SLOT alone: with COPY empty, cmd_start
    # treated a member like a plain start and ran it in a fresh run-<hex> slot,
    # outside the team — no channel, and team stop/status/say never found it
    # (found live in audit run 1, part 7).
    set_copy "team-$name"
    local verb="${1:-show}"; [[ $# -gt 0 ]] && shift

    case "$verb" in
        show)         cmd_team_show "$name" ;;
        add-agent)    cmd_team_add_agent "$name" "$@" ;;
        remove-agent) cmd_team_remove_agent "$name" "$@" ;;
        delete)       cmd_team_delete "$name" ;;
        start)        cmd_team_start "$name" "$@" ;;
        stop)         cmd_team_fanout "$name" stop ;;
        pause)        cmd_team_fanout "$name" pause ;;
        resume)       cmd_team_fanout "$name" resume ;;
        status)       cmd_team_fanout "$name" status ;;
        say)          cmd_team_say "$name" "$@" ;;
        note)         cmd_team_note "$name" "$@" ;;
        attach)       cmd_team_attach "$name" "$@" ;;
        files)        cmd_team_files "$name" "$@" ;;
        inbox)        cmd_team_inbox "$name" "$@" ;;
        report)       cmd_team_report "$name" "$@" ;;
        consensus)    cmd_team_consensus "$name" ;;
        acknowledge)  cmd_team_acknowledge "$name" "$@" ;;
        *) die "unknown team verb '$verb'.
available now: show | add-agent | remove-agent | delete |
               start | stop | pause | resume | status |
               say | note | inbox | attach | files | report | consensus | acknowledge" ;;
    esac
}

# The team document (CLAUDE.md's teams-in-the-GUI plan): assembled
# DETERMINISTICALLY from what already exists — the roster, the full
# channel transcript, and each member's own already-written report — never
# a fresh AI call. Each member's own completion-vote summary (required by
# propose_complete) is already IN the channel transcript, which is what
# makes this a genuine "how we collaborated" narrative rather than a bare
# concatenation: the collaboration narrative is each agent's own words,
# just assembled here rather than synthesized again.
# Whether the project is complete — every current member has voted AND no
# newer message has invalidated that vote. Calls agent_runtime.team_consensus()
# directly (imported from the shared harness — CLAUDE.md "Current plan"
# phase 2: one copy now, not one per member's own bin/) rather than
# reimplementing the computation here or in the GUI: one implementation,
# used by an agent's own standby loop (agent_runtime.pump_channels) AND by
# this verb/the team console page.
cmd_team_consensus() {
    local name="$1"
    mapfile -t member_lines < <(_team_members "$name")
    [[ ${#member_lines[@]} -gt 0 ]] || die "team '$name' has no members"
    local cf; cf=$(team_channel_file "$name")

    local -a agents=()
    local line
    for line in "${member_lines[@]}"; do
        agents+=("${line%%$'\t'*}")
    done

    local out
    out=$(python3 -c '
import json, sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
import agent_runtime as ar

channel_path = sys.argv[2]
agents = sys.argv[3:]
entries = ar.read_team_channel(Path(channel_path))
result = ar.team_consensus(entries, agents)
print(json.dumps(result))
' "$(lib_dir)" "$cf" "${agents[@]}") || die "could not compute consensus for team '$name'"

    if [[ $JSON -eq 1 ]]; then
        python3 -c 'import json, sys; d = json.loads(sys.argv[1]); print(json.dumps({"team": sys.argv[2], **d}))' \
            "$out" "$name"
    else
        python3 -c '
import json, sys
d = json.loads(sys.argv[1])
print("complete:", d["complete"])
for agent, m in d["members"].items():
    state = "voted" if m["voted"] and not m["stale"] else ("stale vote" if m["stale"] else "no vote yet")
    print(f"  {agent}: {state}")
' "$out"
    fi
}

# The teams plan gave a team a way to VOTE itself complete
# (propose_complete/team_consensus, above) and a way to be fanned-out
# stopped mid-flight (cmd_team_fanout stop) — but there was no single
# OPERATOR action for "this project is done: stop whatever is still
# running, and record it as reviewed", the way a solo agent's own
# `acknowledge` already closes out one run. Mirrors that verb's shape
# (who closed it out, when) at the team's own granularity, since a team
# has no single run_id to point an ack at — the record lives on the
# team's own JSON file instead, alongside its members/created_by/etc.,
# which every other team-mutating verb here already loads-and-preserves
# (see cmd_team_add_agent/remove_agent) rather than a separate file.
cmd_team_acknowledge() {
    local name="$1"; shift
    local author=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --author) [[ $# -ge 2 ]] || die "--author needs a value, e.g. --author alice"
                      author="$2"; shift 2 ;;
            *) die "unknown option for acknowledge: $1" ;;
        esac
    done
    local by; by="${author:-$(invoking_user)}"
    local tf; tf=$(team_file "$name")

    local already; already=$(python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
print(d.get("acknowledged_by") or "")
' "$tf")
    [[ -z "$already" ]] || die "team '$name' was already marked complete by $already.
see it:  sudo agenti team $name show"

    # Stop whatever is still running first — marking a project "complete"
    # while a member is mid-run would leave a live process nobody is
    # watching. Best-effort per member: cmd_stop is already a clean no-op
    # against a member with nothing active, so only ones actually stopped
    # here are reported.
    mapfile -t member_lines < <(_team_members "$name")
    local -a stopped=()
    local line agent
    for line in "${member_lines[@]}"; do
        agent="${line%%$'\t'*}"
        if run_active "$agent"; then
            ( require_agent "$agent"; cmd_stop "$agent" ) >/dev/null 2>&1 || true
            stopped+=("$agent")
        fi
    done

    local svc_user; svc_user=$SVC_USER
    python3 -c '
import json, sys, time
path, by = sys.argv[1:3]
d = json.load(open(path))
d["acknowledged"] = True
d["acknowledged_by"] = by
d["acknowledged_at"] = time.time()
json.dump(d, open(path, "w"))
' "$tf" "$by" || die "could not record the acknowledgment for team '$name'"
    chown root:"$svc_user" "$tf"; chmod 0640 "$tf"

    if [[ $JSON -eq 1 ]]; then
        python3 -c '
import json, sys
print(json.dumps({"team": sys.argv[1], "acknowledged": True,
                  "acknowledged_by": sys.argv[2], "stopped": sys.argv[3:]}))
' "$name" "$by" "${stopped[@]}"
    else
        ok "team '$name' marked complete by $by"
        [[ ${#stopped[@]} -gt 0 ]] && printf '  stopped first: %s\n' "${stopped[*]}"
    fi
}

cmd_team_report() {
    local name="$1"; shift
    local promote=0 by=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --promote) promote=1; shift ;;
            --by) [[ $# -ge 2 ]] || die "--by needs a value"; by="$2"; shift 2 ;;
            *) die "unknown option '$1' for team report — see: sudo agenti team $name report --help" ;;
        esac
    done
    [[ -n "$by" ]] || by=$(invoking_user)

    mapfile -t member_lines < <(_team_members "$name")
    [[ ${#member_lines[@]} -gt 0 ]] || die "team '$name' has no members"

    local cf; cf=$(team_channel_file "$name")
    [[ -f "$cf" ]] || die "no channel for team '$name'"

    # The document itself is built by shared/team_report.py (deterministic — no
    # AI call): the roster and each member's task from the kickoff, each
    # member's findings from its own report, and the channel as the story of how
    # they worked together. Each member's NEWEST report is used.
    local -a pairs=()
    local line agent adir report_path
    for line in "${member_lines[@]}"; do
        agent="${line%%$'\t'*}"
        adir=$(agent_dir "$agent")
        report_path=$(_slot_newest_report "$adir")
        pairs+=("$agent=${report_path:+$adir/reports/$report_path}")
    done
    local tf; tf=$(team_file "$name")
    local t_owner t_ack
    t_owner=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("owner") or "")' "$tf" 2>/dev/null || true)
    t_ack=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("acknowledged_by") or "")' "$tf" 2>/dev/null || true)

    local body
    body=$(python3 "$(lib_dir)/team_report.py" --team "$name" --channel "$cf" \
               --owner "$t_owner" --acknowledged-by "$t_ack" "${pairs[@]}") \
        || die "could not assemble the team document for '$name'"

    if [[ $promote -eq 1 ]]; then
        local fname="TEAM-${name}-$(date +%Y%m%d-%H%M%S).md"
        local tmp; tmp=$(mktemp)
        printf '%s\n' "$body" > "$tmp"
        # promote-output already exists per-agent; reuse it here by staging
        # the assembled document as a fake "report" under a throwaway
        # per-team scratch dir outputs.promote_output() can copy FROM,
        # rather than duplicating its quota/ownership logic.
        local team_scratch="$(teams_dir)/.reports"
        mkdir -p "$team_scratch"; chown root:"$SVC_USER" "$team_scratch"; chmod 0750 "$team_scratch"
        cp "$tmp" "$team_scratch/$fname"; chown root:"$SVC_USER" "$team_scratch/$fname"; chmod 0640 "$team_scratch/$fname"
        rm -f "$tmp"
        if [[ $JSON -eq 1 ]]; then
            printf '{"team":%s,"report":%s,"promoted":true}\n' \
                "$(json_str "$name")" "$(json_str "$team_scratch/$fname")"
        else
            ok "team report assembled and saved to $team_scratch/$fname"
        fi
        return 0
    fi

    if [[ $JSON -eq 1 ]]; then
        python3 -c 'import json, sys; print(json.dumps({"team": sys.argv[1], "report_markdown": sys.argv[2]}))' \
            "$name" "$body"
    else
        printf '%s\n' "$body"
    fi
}


# `agenti dashboard [--owner <user>]` — ONE user's whole dashboard in
# one call: every run slot they own (live status, review state, recent
# activity, history) and their teams. Runs are private to their owner
# (CLAUDE.md §4 item 71), so this is the only listing there is: nobody gets a
# list of other people's runs. The API serves it as GET /dashboard, which is
# also the shape an MCP tool layer will read.
cmd_dashboard() {
    [[ $# -eq 0 ]] || die "usage: sudo agenti dashboard [--owner <user>] [--json]"
    ensure_vault; require_org
    resolve_slot
    local -a slots=() units=()
    local agent d n
    for agent in $(list_agents); do
        for d in "$(agent_base_dir "$agent")/instances"/*/; do
            [[ -d "$d" ]] || continue
            n=$(basename "$d")
            [[ "$n" == "$OWNER" || "$n" == "$OWNER".* ]] || continue
            slots+=("$agent/$n")
            units+=("agenti-${agent}-instance@${n}.service")
        done
    done
    local states=""
    [[ ${#units[@]} -eq 0 ]] || states=$(systemctl show -p Id -p ActiveState -p FreezerState "${units[@]}" 2>/dev/null || true)
    local vstate; vstate=$(vault_state)
    # The unit states ride an env var: stdin is the heredoc script itself.
    AGENTI_UNIT_STATES="$states" python3 - "$OWNER" "$(lib_dir)" "$AGENTI_ROOT" "$JSON" "$vstate" "${slots[@]}" <<'PY'
import json, sys
from pathlib import Path
owner, lib, root, as_json, vault = sys.argv[1:6]
sys.path.insert(0, lib)
import state as st

import os
units = {}
for block in os.environ.get("AGENTI_UNIT_STATES", "").split("\n\n"):
    kv = dict(line.split("=", 1) for line in block.splitlines() if "=" in line)
    if kv.get("Id"):
        units[kv["Id"]] = kv

def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""

def jread(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}

out_slots = []
for item in sys.argv[6:]:
    agent, slot = item.split("/", 1)
    d = Path(root) / "org" / agent / "instances" / slot
    u = units.get(f"agenti-{agent}-instance@{slot}.service", {})
    active = u.get("ActiveState") or "unknown"
    history = st.merge_acks(st.apply_hidden(st.fold_history(st.read_history(d / "state")),
                                            st.read_hidden(d)), st.read_acks(d))[:50]
    # Every start is its own slot, so slots pile up. One that is not running,
    # has no finished run on record (a launch that never started, files
    # attached and abandoned, history aged out) and is no team's member has
    # nothing to show.
    if active not in ("active", "activating", "reloading") and not history \
            and not jread(d / "run-team").get("team"):
        continue
    out_slots.append({
        "agent": agent, "slot": slot,
        "copy": slot[len(owner) + 1:] or None,
        "state": active,
        "freezer": u.get("FreezerState") if active == "active" else "n/a",
        "target": read(d / "run-target"),
        "name": read(d / "run-name") or None,
        "team": jread(d / "run-team").get("team") or None,
        "model": jread(d / "run-config.json").get("model") or "",
        "live": st.read_live_status(d / "state") or {},
        "recent": st.read_recent_activity(d / "state"),
        "history": history,
    })

teams = []
for tf in sorted((Path(root) / "org" / "teams").glob("*.json")):
    doc = jread(tf)
    if doc.get("owner") == owner:
        teams.append({k: doc.get(k) for k in ("name", "members", "created_at", "acknowledged",
                                              "acknowledged_by", "acknowledged_at")})

import disk_encryption
# Decision 5 (audit run 1): runs work on an unencrypted disk, and the dashboard
# says so, every time, with the way to turn the vault on.
storage = disk_encryption.status(root)
if storage["encrypted"] is False:
    storage["warning"] = disk_encryption.WARNING
# Is there an Anthropic key any of this user's runs would use (the four tiers,
# agent_runtime.load_secrets)? Only yes/no; the GUI offers Settings → Platform.
# A per-agent file belongs to the run account: never follow a link or block on a pipe.
def _has_key(f):
    import stat as _stat
    try:
        fd = os.open(f, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        if not _stat.S_ISREG(os.fstat(fd).st_mode):
            return False
        text = os.read(fd, 1 << 16).decode("utf-8", "replace")
    finally:
        os.close(fd)
    return any(l.startswith("ANTHROPIC_API_KEY=") and len(l.strip()) > 18 for l in text.splitlines())
_tiers = [Path(root) / "shared" / "secrets.env", Path(root) / "org" / "secrets.env",
          Path(root) / "org" / "users" / owner / "secrets.env"]
_tiers += list((Path(root) / "org").glob("*/secrets.env"))
api_key = "set" if vault != "locked" and any(_has_key(f) for f in _tiers) else (
    "unknown" if vault == "locked" else "missing")
result = {"owner": owner, "vault": vault, "storage": storage, "api_key": api_key,
          "slots": out_slots, "teams": teams}
if as_json == "1":
    print(json.dumps(result))
else:
    print(f"{owner}'s dashboard:")
    for sl in out_slots:
        label = (f"{sl['name']} ({sl['agent']})" if sl.get("name") else
                 sl["agent"] + (f" · {sl['copy']}" if sl["copy"] else ""))
        print(f"  {label:<28} {sl['state']:<10} {sl['target'] or '—'}  ({len(sl['history'])} finished)")
    for t in teams:
        print(f"  team {t['name']:<23} {'complete' if t.get('acknowledged') else 'open'}")
    if not out_slots and not teams:
        print("  (no runs yet)")
PY
}

