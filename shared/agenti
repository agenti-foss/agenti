n = len(roster)
plural = "" if n == 1 else "s"
body = "\n".join([f"Project kickoff — {n} agent{plural} working together on {team}.", ""]
                 + bullets)
with open(path, "a+") as fh:
    fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
    try:
        fh.seek(0)
        next_id = sum(1 for line in fh if line.strip()) + 1
        entry = {"id": next_id, "ts": time.time(), "author": author, "via": via,
                 "kind": "kickoff", "body": body, "roster": roster, "details": details}
        fh.write(json.dumps(entry) + "\n")
        fh.flush()
        print(next_id)
    finally:
        fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
' "$cf" "$author" "$via" "$name" "$@" > /dev/null || die "could not post the team kickoff"
