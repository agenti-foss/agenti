# ---------------------------------------------------------------------------
# Generic action-approval verbs — action-pending / action-approve / action-reject
# (exploit-pending / exploit-approve / exploit-reject are kept as aliases)
# ---------------------------------------------------------------------------
# Any plugin agent whose run slot writes pending-actions.jsonl can use these.
# Currently only the exploit agent does.
#
# action-pending:  list every pending approval request across ALL slots of
#                  this agent, or pass --user to narrow to one.
# action-approve:  approve one proposal (by request_id). The run resumes.
# action-reject:   reject one proposal (by request_id). The run gets the
#                  operator's reason and continues without firing anything.


cmd_action_pending() {
    local agent="$1"; shift
    local filter_user=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user) [[ $# -ge 2 ]] || die "--user needs a value"; filter_user="$2"; shift 2 ;;
            --json) JSON=1; shift ;;
            -h|--help) printf 'usage: sudo agenti %s action-pending [--user <u>]\n' "$agent"; exit 0 ;;
            *) die "unknown option '$1' for action-pending" ;;
        esac
    done

    local base; base="$(agent_base_dir "$agent")/instances"
    [[ -d "$base" ]] || die "no runs found for $agent"
    # Only runs going now: a finished run's request can never fire, and listing
    # it asked people to decide on nothing (found in audit run 2).
    local live; live=$(systemctl list-units --plain --no-legend --state=active "agenti-${agent}-instance@*.service" 2>/dev/null \
                         | sed -n "s/^agenti-${agent}-instance@\([^ ]*\)\.service.*/\1/p" | tr '\n' ' ')

    python3 - "$base" "$filter_user" "$JSON" "$agent" "$live" "$(lib_dir)" <<'PY'
import json, os, sys
from pathlib import Path
base, filter_user, json_out, agent = Path(sys.argv[1]), sys.argv[2], sys.argv[3]=="1", sys.argv[4]
live = set(sys.argv[5].split())
sys.path.insert(0, sys.argv[6])
import run_files          # the run wrote these files: read link-safe, never by path


def slot_text(slot, name):
    try:
        fh, _ = run_files.open_in_slot(slot, name)
    except run_files.FilesError:
        return ""
    with fh:
        return fh.read(run_files.MAX_READ_BYTES).decode("utf-8", "replace")


rows = []
for slot_dir in sorted(base.iterdir()):
    if not slot_dir.is_dir() or slot_dir.is_symlink() or slot_dir.name not in live: continue
    user = slot_dir.name.split(".")[0]
    if filter_user and user != filter_user: continue
    pending = slot_text(slot_dir, "pending-actions.jsonl")
    if not pending: continue
    decided = set()
    for line in slot_text(slot_dir, "action-approvals.jsonl").splitlines():
        try: decided.add(json.loads(line).get("request_id",""))
        except Exception: pass
    for line in pending.splitlines():
        try:
            r = json.loads(line)
        except Exception:
            continue
        if r.get("request_id") in decided: continue
        r["slot"] = slot_dir.name
        rows.append(r)

if json_out:
    print(json.dumps(rows, indent=2))
else:
    if not rows:
        print(f"No pending exploit approval requests for {agent}.")
        sys.exit(0)
    for r in rows:
        summary = r.get("plain_summary") or f"Run {r.get('module','?')} with options {r.get('options', {})}."
        print(f"APPROVE THIS? {summary}")
        print()
        print(f"request_id : {r.get('request_id','?')}")
        print(f"slot       : {r.get('slot','?')}")
        print(f"module     : {r.get('module','?')}")
        print(f"proposed   : {r.get('proposed_at','?')[:19]}")
        print(f"reason     : {r.get('reason','?')}")
        opts = r.get("options", {})
        if opts:
            print(f"options    :")
            for k, v in opts.items():
                print(f"  {k} = {v}")
        print()
        print(f"  approve: sudo agenti {agent} action-approve {r.get('request_id','?')} --owner {r.get('slot','?').split('.')[0]}")
        print(f"  reject:  sudo agenti {agent} action-reject  {r.get('request_id','?')} --owner {r.get('slot','?').split('.')[0]} --reason \"<why>\"")
        print()
PY
}

cmd_action_approve() {
    local agent="$1"; shift
    local request_id="" author="" via=$(_via) grant=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --author) [[ $# -ge 2 ]] || die "--author needs a value"; author="$2"; shift 2 ;;
            --via)    [[ $# -ge 2 ]] || die "--via needs: cli or api"
                      :   # ignored: how a request came in is always sudo's answer, $(_via)
                      shift 2 ;;
            --grant=*) grant="${1#*=}"; shift ;;
            -*)       die "unknown option '$1' for action-approve" ;;
            *)        [[ -z "$request_id" ]] || die "action-approve takes ONE request id"
                      request_id="$1"; shift ;;
        esac
    done
    [[ "$(_via)" == api ]] && via=api      # the origin comes from sudo, never the caller
    [[ -n "$request_id" ]] || die "action-approve requires a request_id.
  sudo agenti $agent action-pending        # list pending requests
  sudo agenti $agent action-approve <id>  --owner <u>"

    # Every start is its own run: the request lives in whichever of this
    # owner's runs proposed it.
    [[ -n "$COPY" ]] || locate_request_slot "$agent" "$request_id" || true
    local dir; dir=$(agent_dir "$agent")
    [[ -d "$dir" ]] || die "No pending request with id '$request_id'. List them: sudo agenti $agent action-pending"
    local by; by="${author:-$(invoking_user)}"
    # Approving is itself an act under the engagement: refused once it no
    # longer covers this run (window over, target out of scope, exploitation
    # switched off). The runner checks again when the module fires (audit run 2).
    local cover crc=0
    cover=$(python3 "$LIBDIR/run_coverage.py" check --org-dir "$(org_dir)" --agent "$agent" \
              --kind "$(_agent_scope_kind "$agent")" --target-file "$dir/run-target" 2>&1) || crc=$?
    [[ $crc -ne 3 ]] || die "REFUSING: the engagement no longer covers this run: $cover.
Nothing was approved. Check it:  sudo agenti engagement show"
    # From the web, firing a live exploit module needs a fresh
    # re-authentication (password+2FA or a passkey), bound to exactly this
    # request — see iam.web_approve_exploit_action. A human at a root
    # terminal needs none of that; they already are who they say they are.
    if [[ "$(invoking_user)" == "${AGENTI_API_USER:-agenti-api}" ]]; then
        [[ -n "$grant" ]] || die "REFUSING: from the web this needs a fresh re-authentication (an approval grant)."
        local pending_json options_hash
        pending_json=$(_slot_cat "$dir" pending-actions.jsonl 2>/dev/null | grep "\"request_id\": \"$request_id\"" | tail -1)
        options_hash=$(printf '%s' "$pending_json" | python3 -c "import json,sys; print(json.loads(sys.stdin.read() or '{}').get('options_hash',''))" 2>/dev/null)
        [[ -n "$options_hash" ]] || die "No pending request with id '$request_id'. List them: sudo agenti $agent action-pending"
        local aout arc=0
        aout=$(python3 "$IAM_PY" --json --actor "$by" approve-exploit-action approve "$agent" "$request_id" "$options_hash" "--owner=$OWNER" "--grant=$grant" 2>&1) || arc=$?
        if [[ $arc -ne 0 ]]; then
            local e; e=$(printf '%s' "$aout" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error",""))
except Exception: print("")' 2>/dev/null)
            die "${e:-$aout}"
        fi
        by=$(printf '%s' "$aout" | python3 -c "import json,sys; print(json.load(sys.stdin)['approved_by'])")
    fi
    local approve_out rc
    approve_out="$(python3 - "$dir" "$request_id" "$by" "$via" "$agent" <<'PY'
import json, sys, time
from pathlib import Path
from datetime import datetime, timezone
dir_p, request_id, by, via, agent = Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
import run_files                      # the run wrote this file: read link-safe
try:
    _fh, _ = run_files.open_in_slot(dir_p, "pending-actions.jsonl")
    with _fh:
        pending_text = _fh.read(run_files.MAX_READ_BYTES).decode("utf-8", "replace")
except run_files.FilesError:
    print(json.dumps({"error": f"No pending exploit requests for this slot."})); sys.exit(2)

# Find the request.
pending = None
for line in pending_text.splitlines():
    try:
        r = json.loads(line)
        if r.get("request_id") == request_id:
            pending = r
    except Exception:
        pass
if pending is None:
    print(json.dumps({"error": f"No pending request with id '{request_id}'. List them: sudo agenti {agent} exploit-pending"})); sys.exit(2)

# Append the approval record.
af = dir_p / "action-approvals.jsonl"
plain_summary = pending.get("plain_summary") or f"{pending.get('module','?')} with options {pending.get('options',{})}"
record = {
    "request_id": request_id,
    "options_hash": pending.get("options_hash",""),
    "module": pending.get("module",""),
    "options": pending.get("options",{}),
    "plain_summary": plain_summary,
    "status": "approved",
    "approved_by": by,
    "approved_via": via,
    "approved_at": datetime.now(timezone.utc).isoformat(),
}
with open(af, "a") as fh:
    fh.write(json.dumps(record) + "\n")
print(json.dumps({"ok": True, "request_id": request_id, "approved_by": by,
                  "plain_summary": plain_summary}))
PY
)"
    rc=$?
    [[ $rc -eq 0 ]] || die "action-approve failed: $approve_out"
    if [[ $JSON -eq 1 ]]; then
        printf '%s\n' "$approve_out"
    else
        local summary
        summary="$(printf '%s' "$approve_out" | python3 -c "import json,sys; print(json.loads(sys.stdin.read()).get('plain_summary','?'))" 2>/dev/null || true)"
        ok "Approved $request_id — the exploit agent will now: $summary"
    fi
}

cmd_action_reject() {
    local agent="$1"; shift
    local request_id="" reason="" author="" via=$(_via) grant=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reason) [[ $# -ge 2 ]] || die "--reason needs a value"; reason="$2"; shift 2 ;;
            --author) [[ $# -ge 2 ]] || die "--author needs a value"; author="$2"; shift 2 ;;
            --via)    [[ $# -ge 2 ]] || die "--via needs: cli or api"
                      :   # ignored: how a request came in is always sudo's answer, $(_via)
                      shift 2 ;;
            --grant=*) grant="${1#*=}"; shift ;;
            -*)       die "unknown option '$1' for action-reject" ;;
            *)        [[ -z "$request_id" ]] || die "action-reject takes ONE request id"
                      request_id="$1"; shift ;;
        esac
    done
    [[ "$(_via)" == api ]] && via=api      # the origin comes from sudo, never the caller
    [[ -n "$request_id" ]] || die "action-reject requires a request_id.
  sudo agenti $agent action-pending        # list pending requests
  sudo agenti $agent action-reject <id>  --owner <u> --reason \"too risky\""
    [[ -n "$reason" ]] || die "action-reject requires --reason so the agent and audit trail know why."

    [[ -n "$COPY" ]] || locate_request_slot "$agent" "$request_id" || true
    local dir; dir=$(agent_dir "$agent")
    [[ -d "$dir" ]] || die "No pending request '$request_id'. List: sudo agenti $agent action-pending"
    local by; by="${author:-$(invoking_user)}"
    # Rejecting is a lower-stakes decision than approving (nothing fires),
    # but it is bound by the same grant mechanism for consistency and so a
    # captured session can't silently wave off real proposals either.
    if [[ "$(invoking_user)" == "${AGENTI_API_USER:-agenti-api}" ]]; then
        [[ -n "$grant" ]] || die "REFUSING: from the web this needs a fresh re-authentication (an approval grant)."
        local pending_json options_hash
        pending_json=$(_slot_cat "$dir" pending-actions.jsonl 2>/dev/null | grep "\"request_id\": \"$request_id\"" | tail -1)
        options_hash=$(printf '%s' "$pending_json" | python3 -c "import json,sys; print(json.loads(sys.stdin.read() or '{}').get('options_hash',''))" 2>/dev/null)
        [[ -n "$options_hash" ]] || die "No pending request '$request_id'. List: sudo agenti $agent action-pending"
        local aout arc=0
        aout=$(python3 "$IAM_PY" --json --actor "$by" approve-exploit-action reject "$agent" "$request_id" "$options_hash" "--owner=$OWNER" "--grant=$grant" 2>&1) || arc=$?
        if [[ $arc -ne 0 ]]; then
            local e; e=$(printf '%s' "$aout" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error",""))
except Exception: print("")' 2>/dev/null)
            die "${e:-$aout}"
        fi
        by=$(printf '%s' "$aout" | python3 -c "import json,sys; print(json.load(sys.stdin)['approved_by'])")
    fi
    local reject_out rc
    reject_out="$(python3 - "$dir" "$request_id" "$by" "$reason" "$via" "$agent" <<'PY'
import json, sys
from pathlib import Path
from datetime import datetime, timezone
dir_p, request_id, by, reason, via, agent = (
    Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6])
import run_files                      # the run wrote this file: read link-safe
try:
    _fh, _ = run_files.open_in_slot(dir_p, "pending-actions.jsonl")
    with _fh:
        pending_text = _fh.read(run_files.MAX_READ_BYTES).decode("utf-8", "replace")
except run_files.FilesError:
    print(json.dumps({"error": "No pending exploit requests for this slot."})); sys.exit(2)
pending = None
for line in pending_text.splitlines():
    try:
        r = json.loads(line)
        if r.get("request_id") == request_id: pending = r
    except Exception: pass
if pending is None:
    print(json.dumps({"error": f"No pending request '{request_id}'. List: sudo agenti {agent} exploit-pending"})); sys.exit(2)
af = dir_p / "action-approvals.jsonl"
plain_summary = pending.get("plain_summary") or f"{pending.get('module','?')} with options {pending.get('options',{})}"
record = {
    "request_id": request_id,
    "options_hash": pending.get("options_hash",""),
    "module": pending.get("module",""),
    "plain_summary": plain_summary,
    "status": "rejected",
    "rejected_by": by,
    "rejected_via": via,
    "rejected_at": datetime.now(timezone.utc).isoformat(),
    "reason": reason,
}
with open(af, "a") as fh:
    fh.write(json.dumps(record) + "\n")
print(json.dumps({"ok": True, "request_id": request_id, "rejected_by": by,
                  "plain_summary": plain_summary}))
PY
)"
    rc=$?
    [[ $rc -eq 0 ]] || die "action-reject failed: $reject_out"
    if [[ $JSON -eq 1 ]]; then
        printf '%s\n' "$reject_out"
    else
        local summary
        summary="$(printf '%s' "$reject_out" | python3 -c "import json,sys; print(json.loads(sys.stdin.read()).get('plain_summary','?'))" 2>/dev/null || true)"
        ok "Rejected $request_id ($summary) — the exploit agent will be told: $reason"
    fi
}

# Every positional arg may have come from a global flag consumed above (e.g.
# `agenti --json` alone leaves nothing) — under set -u, the positional reads
# below would then hit an unbound-variable error, which reads like a shell
# bug, not a usage mistake. Show usage instead, the same as the
# raw-args-empty check at the top of this block.
[[ $# -eq 0 ]] && { usage; exit 0; }

case "${1:-}" in
    admin) need_root; shift; cmd_admin "$@"; exit 0 ;;
    vault) need_root
           if [[ "${2:-}" == enable && "$(invoking_user)" == "${AGENTI_API_USER:-agenti-api}" ]]; then
               shift 2; cmd_vault_enable_web "$@"; exit 0
           fi
           console_only "vault ${2:-status}"; shift; cmd_vault "$@"; exit 0 ;;
    setup) need_root; console_only setup; cmd_setup; exit 0 ;;
    setup-code) need_root; console_only setup-code; shift; cmd_setup_code "$@"; exit 0 ;;
    verify)
        need_root; console_only verify; shift
        [[ -x "$LIBDIR/verify.sh" ]] || die "verify.sh is missing.
reinstall it:  $REINSTALL"
        exec "$LIBDIR/verify.sh" "$@" ;;
    gui)   shift; cmd_gui "$@"; exit 0 ;;
    # No need_root (CLAUDE.md "Current plan" phase 3): the agent catalogue is
    # not sensitive — see cmd_agents' own comment for why it can read straight
    # off disk without sudo.
    agents) cmd_agents; exit 0 ;;
    docs)  shift; cmd_docs "$@"; exit 0 ;;
    help)  usage; exit 0 ;;
    # `agenti team ...` is a parallel grammar to `<agent> <verb>`, not an
    # agent name — intercepted HERE, before AGENT is even read, so "team" is
    # never validated or treated as an agent.
    team)
        need_root
        shift
        cmd_team "$@"
        exit 0 ;;
    # The engagement is a property of the organisation, not of any one agent,
    # so it is intercepted the same way — "engagement" is not an agent name.
    engagement)
        need_root
        shift
        cmd_org_engagement "$@"
        exit 0 ;;
    dashboard)
        need_root
        shift
        cmd_dashboard "$@"
        exit 0 ;;
esac

AGENT="$1"; VERB="${2:-status}"
# Reject anything that isn't a plain lowercase identifier BEFORE it ever
# reaches agent_dir() — that builds paths by string concatenation and has no
# traversal protection of its own. See the valid_name() comment above for why
# this matters. (An empty name fails here too.)
[[ -n "$AGENT" ]] || die "no agent given. Try: agenti --help
usage: sudo agenti <agent> <verb>, e.g. sudo agenti enum status
list agents:  agenti agents"
valid_name "$AGENT" || die "invalid agent name '$AGENT'.
agent names must match ^[a-z0-9][a-z0-9_-]{0,63}\$ — no '/', '.', or
other path characters. list agents:  agenti agents"
shift $(( $# >= 2 ? 2 : $# ))
need_root

# Verbs about the agent TYPE name no run; every other verb acts on ONE user's
# run slot, resolved (and owner-checked) here.
case "$VERB" in
    engagement|tools|approval|provision|set-key|controls|agent-scope|tool-settings) ;;
    # action-pending (and its exploit-pending alias) lists all slots; approve/reject target one.
    action-pending|exploit-pending) ;;
    *) resolve_slot ;;
esac

# Every start is its own isolated run, so "my run" with no --copy has to mean
# something: the only one running, else the latest. `attach`, `files` and
# `send` are left alone on purpose — they stage files for the NEXT run, which
# has no slot until it starts. `history` and `copies` list across all runs.
case "$VERB" in
    status|show|findings|inbox|report|reports|scans|audit|logs|send-list|send|\
    stop|pause|resume|interrupt|say|note|set-model|promote-output|evidence|verify|export|purge|rename)
        [[ -n "$COPY" ]] || default_copy "$AGENT" ;;
    # A run id names its run: find the slot that holds it.
    acknowledge)
        if [[ -z "$COPY" ]]; then
            _found=0
            for _a in "$@"; do
                if [[ "$_a" =~ ^[0-9a-f]{12}$ ]]; then
                    locate_run_slot "$AGENT" "$_a" && _found=1
                    break
                fi
            done
            [[ $_found -eq 1 ]] || default_copy "$AGENT"
        fi ;;
esac

case "$VERB" in
    # Create the owner's slot on first use.
    start)          cmd_start "$AGENT" "$@" ;;
    attach)         require_agent "$AGENT"; cmd_attach "$AGENT" "$@" ;;
    # Views: a user who never ran this agent just sees nothing yet.
    status)         require_agent "$AGENT"; cmd_status "$AGENT" ;;
    show)           require_agent "$AGENT"; cmd_show "$AGENT" ;;
    history)        require_agent "$AGENT"; cmd_history "$AGENT" "$@" ;;
    findings)       require_agent "$AGENT"; cmd_findings "$AGENT" "$@" ;;
    files)          require_agent "$AGENT"; cmd_files "$AGENT" "$@" ;;
    send-list)      require_slot "$AGENT"; cmd_send_list "$AGENT" "$@" ;;
    send)           require_agent "$AGENT"; cmd_send "$AGENT" "$@" ;;
    inbox)          require_agent "$AGENT"; cmd_inbox "$AGENT" "$@" ;;
    report)         require_agent "$AGENT"; cmd_report "$AGENT" "$@" ;;
    reports)        require_agent "$AGENT"; cmd_reports "$AGENT" ;;
    scans)          require_agent "$AGENT"; cmd_scans "$AGENT" ;;
    audit)          require_agent "$AGENT"; cmd_audit "$AGENT" "$@" ;;
    logs)           require_slot "$AGENT"; cmd_logs "$AGENT" "$@" ;;
    copies)
        require_agent "$AGENT"
        case "${1:-}" in
            "")       cmd_copies "$AGENT" ;;
            remove)   shift; cmd_copy_remove "$AGENT" "$@" ;;
            *) die "unknown 'copies' sub-verb '${1}'.
  sudo agenti $AGENT copies                  list your runs of this agent
  sudo agenti $AGENT copies remove <label>   delete one run and everything it holds" ;;
        esac ;;
    # Actions on an existing run.
    stop)           require_slot "$AGENT"; cmd_stop "$AGENT" ;;
    pause)          require_slot "$AGENT"; cmd_pause "$AGENT" ;;
    resume)         require_slot "$AGENT"; cmd_resume "$AGENT" ;;
    interrupt)      require_slot "$AGENT"; cmd_interrupt "$AGENT" ;;
    say)            require_slot "$AGENT"; cmd_say "$AGENT" "$@" ;;
    note)           require_slot "$AGENT"; cmd_note "$AGENT" "$@" ;;
    set-model)      require_slot "$AGENT"; cmd_set_model "$AGENT" "$@" ;;
    rename)         require_slot "$AGENT"; cmd_rename "$AGENT" "$@" ;;
    acknowledge)    require_slot "$AGENT"; cmd_acknowledge "$AGENT" "$@" ;;
    promote-output) require_slot "$AGENT"; cmd_promote_output "$AGENT" "$@" ;;
    evidence)       require_slot "$AGENT"; cmd_evidence "$AGENT" "$@" ;;
    verify)         require_slot "$AGENT"; cmd_verify "$AGENT" ;;
    export)         require_slot "$AGENT"; cmd_export "$AGENT" "$@" ;;
    purge)          require_slot "$AGENT"; cmd_purge "$AGENT" ;;
    # Generic action-approval flow (any plugin agent that proposes actions).
    action-pending|exploit-pending)  require_agent "$AGENT"; cmd_action_pending "$AGENT" "$@" ;;
    action-approve|exploit-approve)  require_agent "$AGENT"; cmd_action_approve "$AGENT" "$@" ;;
    action-reject|exploit-reject)    require_agent "$AGENT"; cmd_action_reject "$AGENT" "$@" ;;
    # About the agent type.
    engagement)     require_agent "$AGENT"; cmd_engagement "$AGENT" ;;
    controls)       require_agent "$AGENT"; cmd_controls "$AGENT" ;;
    agent-scope)    require_agent "$AGENT"; cmd_agent_scope "$AGENT" "$@" ;;
    tool-settings)  require_agent "$AGENT"; cmd_tool_settings "$AGENT" "$@" ;;
    tools)          require_agent "$AGENT"; cmd_tools "$AGENT" ;;
    approval)       require_agent "$AGENT"; cmd_approval "$AGENT" ;;
    set-key)        require_agent "$AGENT"; cmd_setkey "$AGENT" ;;
    provision)      require_agent_master "$AGENT"; cmd_provision "$AGENT" ;;
    *) die "unknown verb '$VERB' for '$AGENT'. Try: agenti --help
usage: sudo agenti <agent> <verb>, e.g. sudo agenti $AGENT status" ;;
esac
