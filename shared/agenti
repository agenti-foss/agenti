    exit 0
fi

# 'admin' (iam.py's own argparse --help) and 'team' (cmd_team's own
# usage text) both have their own, richer help than the generic banner below
# — and both were being silently swallowed by it. The global loop treats ANY
# --help/-h token ANYWHERE in argv as "show the generic top-level usage and
# exit", so `agenti admin --help`, `agenti admin role --help`, and
# `agenti team --help` all showed the wrong thing instead of
# dispatching to iam.py's argparse or cmd_team at all. Found in the
# 2026-09-21 error-message audit (CLAUDE.md §4 item 17) — the exact reason
# 'new' above already gets this treatment, just never extended to these two.
#
# Scoped to ONLY the --help/-h case (unlike 'new', dispatched
# unconditionally above): a normal admin/team call needs the loop below to
# run first, to set $JSON — meaningful to both, unlike to 'new'. And like
# 'new', the help path itself needs no root — precedent already set below
# by 'new' not calling need_root either.
if [[ "${1:-}" == "admin" ]]; then
    for a in "${@:2}"; do
        if [[ "$a" == "--help" || "$a" == "-h" ]]; then
            shift; cmd_admin "$@"; exit 0
        fi
    done
fi
if [[ "${1:-}" == "team" ]]; then
    for a in "${@:2}"; do
        # Help needs no team: looking one up here, before --owner is read,
        # answered "no team 'x' for '<your login>'" for another owner's team.
        if [[ "$a" == "--help" || "$a" == "-h" ]]; then team_usage; exit 0; fi
    done
fi
if [[ "${1:-}" == "vault" ]]; then
    for a in "${@:2}"; do
        if [[ "$a" == "--help" || "$a" == "-h" ]]; then
            # A trailing --help must not be a way past console_only: the rest
            # of the arguments still reach vault.sh (audit run 1, F17).
            console_only "vault ${2:-status}"
            shift; cmd_vault "$@"; exit 0
        fi
    done
fi
if [[ "${1:-}" == "gui" ]]; then
    for a in "${@:2}"; do
        if [[ "$a" == "--help" || "$a" == "-h" ]]; then
            if [[ "${2:-}" == configure ]]; then
                _cfg="$LIBDIR/configure.sh"; [[ -f "$_cfg" ]] || _cfg="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/configure.sh"
